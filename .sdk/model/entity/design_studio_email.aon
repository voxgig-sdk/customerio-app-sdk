"type\":\"array\"},\"folders\":{\"items\":{\"example\":{\"created\":1714732800,\"id\":\"123e4567-e89b-12d3-a456-426614174000\",\"name\":\"Product Announcements\",\"parent_folder_id\":null,\"updated\":1714732800},\"properties\":{\"created\":{\"description\":\"Timestamp of when the folder was created.\",\"format\":\"Unix timestamp\",\"type\":\"integer\"},\"id\":{\"description\":\"ID of folder\",\"format\":\"uuid\",\"type\":\"string\"},\"name\":{\"description\":\"The name of the folder.\",\"type\":\"string\"},\"parent_folder_id\":{\"description\":\"The ID of the parent folder. Returns `null` if there is no parent, which means the folder is in the root directory.\",\"format\":\"uuid\",\"type\":[\"string\",\"null\"]},\"updated\":{\"description\":\"Timestamp of last update to the folder.\",\"format\":\"Unix timestamp\",\"type\":\"integer\"}},\"type\":\"object\"},\"type\":\"array\"},\"meta\":{\"properties\":{\"filters\":{\"description\":\"The filters applied in your request.\",\"example\":{\"created_after\":null,\"created_before\":1714732800,\"direct_descendants_only\":true,\"parent_folder_id\":\"123e4567-e89b-12d3-a456-426614174000\",\"sort_by\":\"created\",\"sort_order\":\"desc\",\"updated_after\":null,\"updated_before\":null},\"type\":\"object\"},\"pagination\":{\"properties\":{\"limit\":{\"description\":\"The number of results per page.\",\"type\":\"integer\"},\"page\":{\"description\":\"The page number of results you're on.\",\"type\":\"integer\"},\"total\":{\"description\":\"The total number of folders.\",\"type\":\"integer\"}},\"type\":\"object\"}},\"type\":\"object\"}},\"type\":\"object\"}}},\"description\":\"Successful response\"},\"400\":{\"content\":{\"application/json\":{\"example\":{\"errors\":[{\"detail\":\"invalid query parameter\",\"status\":\"400\"}]},\"schema\":{\"description\":\"An error response containing one or more error details.\",\"properties\":{\"errors\":{\"description\":\"A list of errors that occurred while processing the request.\",\"items\":{