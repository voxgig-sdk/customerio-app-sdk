          contract: {
            id: "GET /v1/design_studio/emails/{id}/languages/{language}"
            json: "{\"operationId\":\"getEmailTranslation\",\"parameters\":[{\"description\":\"The UUID of the email. If your email has multiple languages, you must provide the ID of the **default** language template. This links the workflow to all of the language variants for the template.\",\"in\":\"path\",\"name\":\"id\",\"required\":true,\"schema\":{\"format\":\"uuid\",\"type\":\"string\"}},{\"description\":\"A [language code](/journeys/channels/localization/attribute/#supported-languages) that indicates the language of your translated email\",\"in\":\"path\",\"name\":\"language\",\"required\":true,\"schema\":{\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"email_translation\":{\"properties\":{\"available_languages\":{\"description\":\"List of [language codes](/journeys/channels/localization/attribute/#supported-languages) that reflect the languages this default email has been translated to.\",\"example\":[\"en\",\"es\"],\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"content\":{\"description\":\"The content of your email.\",\"properties\":{\"amp\":{\"description\":\"AMP HTML body.\",\"type\":\"string\"},\"html\":{\"description\":\"HTML body.\",\"type\":\"string\"},\"preheader_text\":{\"description\":\"Preview text.\",\"type\":\"string\"},\"subject\":{\"description\":\"Email subject line.\",\"type\":\"string\"},\"text\":{\"description\":\"Plain text body.\",\"type\":\"string\"}},\"type\":\"object\"},\"created\":{\"description\":\"Unix timestamp of when the translation was created.\",\"example\":1773856017,\"type\":\"integer\"},\"envelope\":{\"properties\":{\"bcc\":{\"description\":\"BCC email address.\",\"type\":\"string\"},\"fake_bcc\":{\"description\":\"Whether to use fake BCC. Defaults to true if not provided.\",\"type\":\"boolean\"},\"from\":{\"description\":\"The sender address associated with the from_id.\",\"type\":\"string\"},\"from_id\":{\"description\":\"Sender identity ID.\\n\",\"type\":[\"integer\",\"null\"]},\"headers\":{\"description\":\"Custom headers. Each item: { \\\"name\\\": \\\"string\\\", \\\"value\\\": \\\"string\\\" }.\\n\",\"items\":{\"properties\":{\"name\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"},\"recipient\":{\"description\":\"Recipient expression. Defaults to {{customer.email}} if not set.\",\"type\":\"string\"},\"reply_to\":{\"description\":\"The reply-to address associated with the reply_to_id.\",\"type\":\"string\"},\"reply_to_id\":{\"description\":\"Reply-to identity ID. This matches one of the ids in *Workspace Settings > Email*.\\n\",\"type\":[\"integer\",\"null\"]}},\"type\":\"object\"},\"is_linked\":{\"description\":\"Whether the translation is linked to a workflow (automation, broadcast, etc)\",\"type\":\"boolean\"},\"is_template\":{\"description\":\"Whether the translation is a template\",\"type\":\"boolean\"},\"language\":{\"description\":\"The [language code](/journeys/channels/localization/attribute/#supported-languages) of the translation\",\"example\":\"fr\",\"type\":\"string\"},\"language_group_id\":{\"description\":\"ID of the parent email that groups all translations. Same as the id in the path parameter.\",\"format\":\"uuid\",\"type\":\"string\"},\"parent_folder_id\":{\"description\":\"UUID of the parent folder, or `null` if the email is in your root directory.\",\"format\":\"uuid\",\"type\":[\"string\",\"null\"]},\"transformers\":{\"description\":\"Automate repetitive actions like removing white space and inlining CSS with [transformers](/journeys/design-studio/emails/code-editor/overview/#transformers).\",\"properties\":{\"accessibility\":{\"description\":\"Applies a set of accessibility improvements to the email HTML. When no `language` is set, this falls back to the `lang` attribute on the `<html>` tag, or `\\\"und\\\"` (undetermined). The `dir` attribute is automatically derived from the language using RTL detection.\\n\",\"properties\":{\"add_dir_to_content\":{\"default\":true,\"description\":\"Add `dir` attribute to direct children of `<body>`.\\n\",\"type\":\"boolean\"},\"add_dir_to_html\":{\"default\":true,\"description\":\"Add `dir` attribute (`ltr`, `rtl`, or `auto`) to the `<html>` element if not already present.\\n\",\"type\":\"boolean\"},\"add_empty_alt_to_images\":{\"default\":true,\"description\":\"Add `alt=\\\"\\\"` to `<img>` elements missing an `alt` attribute, preventing screen readers from reading the file name.\\n\",\"type\":\"boolean\"},\"add_lang_to_content\":{\"default\":true,\"description\":\"Add `lang` attribute to direct children of `<body>`.\\n\",\"type\":\"boolean\"},\"add_lang_to_html\":{\"default\":true,\"description\":\"Add `lang` attribute to the `<html>` element if not already present.\\n\",\"type\":\"boolean\"},\"add_role_to_tables\":{\"default\":true,\"description\":\"Add `role=\\\"presentation\\\"` to all `<table>` elements without an existing `role`, so screen readers skip table semantics for layout tables.\\n\",\"type\":\"boolean\"},\"add_title_to_head\":{\"default\":true,\"description\":\"Add a `<title>` tag to `<head>` using the email subject line (creates or replaces if empty).\\n\",\"type\":\"boolean\"},\"add_vml_alt_text\":{\"default\":true,\"description\":\"Add `alt` attribute to VML elements (used by Outlook’s Word rendering engine), derived from the element’s text content.\\n\",\"type\":\"boolean\"},\"enabled\":{\"default\":false,\"description\":\"Enable accessibility fixes.\\n\",\"type\":\"boolean\"},\"language\":{\"default\":\"\",\"description\":\"Language code (for example, `\\\"en\\\"`, `\\\"fr\\\"`, or `\\\"ar\\\"`) used for `lang` and `dir` attributes.\\n\",\"type\":\"string\"},\"remove_button_role_from_links\":{\"default\":true,\"description\":\"Remove `role=\\\"button\\\"` from `<a>` tags to restore proper link semantics for screen readers.\\n\",\"type\":\"boolean\"},\"remove_zoom_meta_tag\":{\"default\":true,\"description\":\"Remove viewport `<meta>` tags that restrict zoom (`user-scalable=0`, `user-scalable=no`, `maximum-scale=1`, or `maximum-scale=2`).\\n\",\"type\":\"boolean\"}},\"type\":\"object\"},\"css_inliner\":{\"description\":\"Moves CSS from `<style>` tags into inline `style` attributes on each element. Essential for email clients with limited `<style>` support (for example, older Gmail and some Outlook versions). Uses the `juice` library. Elements in `<style>` tags marked with `data-ignore-inlining` are skipped.\\n\",\"properties\":{\"apply_html_attributes\":{\"description\":\"Controls adding redundant HTML attributes alongside inlined CSS to different HTML elements.\\n\",\"properties\":{\"apply_height_attributes\":{\"default\":true,\"description\":\"Add redundant HTML `height` attributes alongside inlined CSS `height` on `<table>`, `<td>`, `<th>`, and `<img>` elements. Only applies to `px` values (and `%` on table elements). Needed for email clients that ignore CSS height.\\n\",\"type\":\"boolean\"},\"apply_table_element_attributes\":{\"default\":true,\"description\":\"Add redundant HTML attributes on table elements (`<table>`, `<th>`, `<tr>`, `<td>`, `<caption>`, `<colgroup>`, `<col>`, `<thead>`, `<tbody>`, `<tfoot>`): `background-color` → `bgcolor`, `background-image` → `background`, `text-align` → `align`, `vertical-align` → `valign`.\\n\",\"type\":\"boolean\"},\"apply_width_attributes\":{\"default\":true,\"description\":\"Add redundant HTML `width` attributes alongside inlined CSS `width` on `<table>`, `<td>`, `<th>`, and `<img>` elements. Only applies to `px` values (and `%` on table elements). Needed for email clients that ignore CSS width (for example, older Outlook).\\n\",\"type\":\"boolean\"},\"enabled\":{\"default\":true,\"description\":\"Enable adding redundant HTML attributes.\\n\",\"type\":\"boolean\"}},\"type\":\"object\"},\"apply_style_tags\":{\"default\":true,\"description\":\"Inline styles from `<style>` tags.\\n\",\"type\":\"boolean\"},\"enabled\":{\"default\":false,\"description\":\"Enable CSS inlining.\\n\",\"type\":\"boolean\"},\"inline_pseudo_elements\":{\"default\":false,\"description\":\"Attempt to inline pseudo-element (`::before`, `::after`) styles.\\n\",\"type\":\"boolean\"},\"preserve_font_faces\":{\"default\":true,\"description\":\"Keep `@font-face` rules in `<style>` (cannot be inlined).\\n\",\"type\":\"boolean\"},\"preserve_important\":{\"default\":false,\"description\":\"Preserve `!important` declarations in inlined styles.\\n\",\"type\":\"boolean\"},\"preserve_keyframes\":{\"default\":true,\"description\":\"Keep `@keyframes` rules in `<style>` (cannot be inlined).\\n\",\"type\":\"boolean\"},\"preserve_media_queries\":{\"default\":true,\"description\":\"Keep `@media` rules in `<style>` (cannot be inlined).\\n\",\"type\":\"boolean\"},\"preserve_pseudos\":{\"default\":true,\"description\":\"Keep pseudo-selector rules (for example, `:hover`) in `<style>` (cannot be inlined).\\n\",\"type\":\"boolean\"},\"remove_style_tags\":{\"default\":true,\"description\":\"Remove `<style>` tags after inlining their rules.\\n\",\"type\":\"boolean\"}},\"type\":\"object\"},\"css_variables\":{\"description\":\"Resolves CSS custom properties (`var(--name)`) into their computed values. Required for email clients that do not support CSS custom properties (most email clients). Variables declared in one `<style>` tag are available in subsequent `<style>` tags.\\n\",\"properties\":{\"enabled\":{\"default\":false,\"description\":\"Enable CSS variable resolution.\\n\",\"type\":\"boolean\"},\"preserve\":{\"default\":false,\"description\":\"Keep original custom property declarations (`--name: value`) alongside the resolved values.\\n\",\"type\":\"boolean\"}},\"type\":\"object\"},\"encode_entities\":{\"description\":\"Encodes special characters (for example, `©`, `™`, and `—`) as their HTML entity equivalents. Improves rendering consistency across email clients with varying character encoding support. Only processes text nodes in the `<body>` and skips `<script>`, `<style>`, `<noscript>`, `<svg>`, and `<head>` elements. Preserves Liquid template tags and avoids double-encoding existing entities.\\n\",\"properties\":{\"enabled\":{\"default\":false,\"description\":\"Enable HTML entity encoding.\\n\",\"type\":\"boolean\"}},\"type\":\"object\"},\"formatter\":{\"description\":\"Controls the output formatting of the final HTML. Only one mode (`prettify` or `minify`) can be active at a time. Set to `\\\"none\\\"` to skip formatting entirely.\\n\",\"properties\":{\"minify\":{\"description\":\"Options used when `type` is `\\\"minify\\\"`. Reduces file size by stripping whitespace and comments.\\n\",\"properties\":{\"line_length_limit\":{\"default\":500,\"description\":\"Maximum characters per line before inserting a line break.\\n\",\"type\":\"integer\"},\"remove_css_comments\":{\"default\":true,\"description\":\"Remove CSS comments (`/* ... */`) from `<style>` blocks.\\n\",\"type\":\"boolean\"},\"remove_html_comments\":{\"default\":\"0\",\"description\":\"HTML comment removal level. `\\\"0\\\"` keeps all comments, `\\\"1\\\"` removes non-conditional comments (preserves MSO conditionals like `<!--[if mso]>`), and `\\\"2\\\"` removes all comments including conditional.\\n\",\"enum\":[\"0\",\"1\",\"2\"],\"type\":\"string\"},\"remove_indentations\":{\"default\":true,\"description\":\"Remove leading whitespace indentation.\\n\",\"type\":\"boolean\"},\"remove_line_breaks\":{\"default\":false,\"description\":\"Remove all line breaks from the output.\\n\",\"type\":\"boolean\"}},\"type\":\"object\"},\"prettify\":{\"description\":\"Options used when `type` is `\\\"prettify\\\"`. Produces human-readable, indented HTML output.\\n\",\"properties\":{\"indent_character\":{\"default\":\"spaces\",\"description\":\"Character used for indentation.\\n\",\"enum\":[\"spaces\",\"tabs\"],\"type\":\"string\"},\"indent_size\":{\"default\":2,\"description\":\"Number of indent characters per level.\\n\",\"type\":\"integer\"},\"wrap_attributes\":{\"default\":false,\"description\":\"Wrap HTML attributes onto separate lines (`force-expand-multiline` mode).\\n\",\"type\":\"boolean\"}},\"type\":\"object\"},\"type\":{\"default\":\"none\",\"description\":\"Formatting mode to apply.\\n\",\"enum\":[\"none\",\"prettify\",\"minify\"],\"type\":\"string\"}},\"type\":\"object\"},\"prevent_widows\":{\"description\":\"Replaces the last space in text blocks with a non-breaking space (`&nbsp;`) to prevent a single word from wrapping onto its own line (a “widow”). Only processes text nodes in the `<body>` and skips `<script>`, `<style>`, `<noscript>`, `<svg>`, and `<head>` elements. Preserves Liquid template tags (`{{ }} ` and `{% %}`).\\n\",\"properties\":{\"enabled\":{\"default\":false,\"description\":\"Enable widow word prevention.\\n\",\"type\":\"boolean\"}},\"type\":\"object\"},\"remove_unused_css\":{\"description\":\"Scans the HTML and removes any CSS selectors from `<style>` tags that are not referenced in the document. Reduces file size and helps avoid Gmail’s 102 KB clipping limit. HTML and CSS comments are always preserved by this step (comment removal is handled separately by the formatter object).\\n\",\"properties\":{\"backend_markers\":{\"default\":[{\"heads\":\"\",\"tails\":\"\"},{\"heads\":\"{%\",\"tails\":\"%}\"}],\"description\":\"Template syntax delimiters (e.g., Liquid, Handlebars) that the CSS parser should skip over to avoid treating template expressions as invalid CSS.\\n\",\"items\":{\"properties\":{\"heads\":{\"description\":\"Opening delimiter.\\n\",\"type\":\"string\"},\"tails\":{\"description\":\"Closing delimiter.\\n\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"},\"enabled\":{\"default\":false,\"description\":\"Enable unused CSS removal.\\n\",\"type\":\"boolean\"},\"uglify\":{\"default\":false,\"description\":\"Shorten (uglify) CSS class names to reduce file size.\\n\",\"type\":\"boolean\"},\"whitelist\":{\"description\":\"CSS selectors to always keep, even if they are not found in the HTML.\\n  - .ReadMsgBody\\n  - .ExternalClass\\n  - .aBn\\n  - .a6S\\n  - .im\\n  - .yshortcuts\\n  - \\\"#outlook\\\"\\n  - .MsoHyperlink\\n  - .MsoHyperlinkFollowed\\n\",\"items\":{\"description\":\"A CSS selector to always keep.\\n\",\"type\":\"string\"},\"type\":\"array\"}},\"type\":\"object\"},\"url_parameters\":{\"description\":\"Appends query string parameters to all absolute URLs in `<a>` and VML elements. Useful for adding UTM tracking or other analytics parameters. Skips `mailto:`, `tel:`, and `sms:` links. Elements marked with `data-ignore-params` are excluded.\\n\",\"properties\":{\"enabled\":{\"default\":false,\"description\":\"Enable URL parameter injection.\\n\",\"type\":\"boolean\"},\"parameters\":{\"default\":[],\"description\":\"List of parameters to append to URLs.\\n\",\"items\":{\"properties\":{\"key\":{\"description\":\"Parameter name.\\n\",\"type\":\"string\"},\"url_encode\":{\"description\":\"URL-encode the value before appending it to the URL.\\n\",\"type\":\"boolean\"},\"value\":{\"description\":\"Parameter value. May contain template variables.\\n\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"}},\"type\":\"object\"}},\"type\":\"object\"},\"updated\":{\"description\":\"Unix timestamp of the last update to the translation.\",\"example\":1773856017,\"type\":\"integer\"}},\"type\":\"object\"}},\"type\":\"object\"}}},\"description\":\"Successful response\"},\"401\":{\"content\":{\"application/json\":{\"example\":{\"errors\":[{\"detail\":\"unauthorized\",\"status\":\"401\"}]},\"schema\":{\"description\":\"An error response containing one or more error details.\",\"properties\":{\"errors\":{\"description\":\"A list of errors that occurred while processing the request.\",\"items\":{\"properties\":{\"detail\":{\"description\":\"Reason for error\",\"type\":\"string\"},\"meta\":{\"description\":\"Additional detail about the error, when there is any. A failed publish uses this to list Liquid errors per language.\",\"type\":\"object\"},\"status\":{\"description\":\"Response code\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"}},\"type\":\"object\"}}},\"description\":\"Unauthorized - missing or invalid API key\"},\"404\":{\"content\":{\"application/json\":{\"example\":{\"errors\":[{\"detail\":\"resource not found\",\"status\":\"404\"}]},\"schema\":{\"description\":\"An error response containing one or more error details.\",\"properties\":{\"errors\":{\"description\":\"A list of errors that occurred while processing the request.\",\"items\":{\"properties\":{\"detail\":{\"description\":\"Reason for error\",\"type\":\"string\"},\"meta\":{\"description\":\"Additional detail about the error, when there is any. A failed publish uses this to list Liquid errors per language.\",\"type\":\"object\"},\"status\":{\"description\":\"Response code\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"}},\"type\":\"object\"}}},\"description\":\"Resource not found\"}},\"securitySchemes\":{\"Bearer-Auth\":{\"description\":\"The App API uses a bearer authentication scheme.\\n\\nYou can generate a bearer token, known as an **App API Key**, with a defined scope in [your account settings](https://fly.customer.io/settings/api_credentials?keyType=app). [Learn more about bearer authorization in Customer.io](/accounts/settings/managing-credentials).\\n\",\"scheme\":\"bearer\",\"type\":\"http\"},\"ServiceAccount-Auth\":{\"bearerFormat\":\"sa_live_\",\"description\":\"Transactional send endpoints (`/v1/send/email`, `/v1/send/push`, `/v1/send/sms`, `/v1/send/whatsapp`, `/v1/send/in_app`, `/v1/send/inbox_message`) also accept a service-account bearer token, prefixed with `sa_live_`. Service-account tokens work across workspaces, so you must pass the target workspace as the `X-Workspace-Id` header on each request.\\n\\nService-account tokens are intended for testing and one-off sends—for example, using the Customer.io CLI with an AI agent like Claude to verify that a transactional message renders correctly before wiring it into your production backend. **For the production integration that triggers the message from your application, use an App API Key instead**: it's workspace-scoped, easier to rotate, and has a smaller blast radius.\\n\\nService-account tokens are server-side credentials. Treat them like any API key—keep them in environment variables or a secret manager, and never embed them in client-side code, mobile apps, or other untrusted contexts.\\n\",\"scheme\":\"bearer\",\"type\":\"http\"},\"bearerAuth\":{\"description\":\"API key passed as a Bearer token\",\"scheme\":\"bearer\",\"type\":\"http\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "GET"
          orig: "/v1/design_studio/emails/{id}/languages/{language}"
          rename: {
            param: {
              id: "email_id"
            }
          }
          segments: [
            {
              lit: "v1"
            }
            {
              lit: "design_studio"
            }
            {
              lit: "emails"
            }
            {
              var: "email_id"
            }
            {
              lit: "languages"
            }
            {
              var: "language"
            }
          ]
          select: {
            exist: [
              "email_id"
              "language"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.email_translation`"
          }
        }
        {
          args: {
            params: [
              {
                kind: "param"
                name: "email_id"
                orig: "id"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "run_id"
                orig: "run_id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          contract: {
            id: "GET /v1/design_studio/emails/{id}/inbox_previews/{run_id}"
            json: "{\"operationId\":\"getInboxPreviewJob\",\"parameters\":[{\"description\":\"The UUID of the email. If your email has translations, this is the ID of a specific language variant.\\n\",\"in\":\"path\",\"name\":\"id\",\"required\":true,\"schema\":{\"format\":\"uuid\",\"type\":\"string\"}},{\"description\":\"The ID of the inbox preview job, returned by [Send for inbox previews](/integrations/api/app/tag/design-studio-emails/submitInboxPreview/).\",\"in\":\"path\",\"name\":\"run_id\",\"required\":true,\"schema\":{\"type\":\"integer\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"description\":\"The status and results of an Inbox Previews job.\",\"properties\":{\"client_ids\":{\"description\":\"The device identifiers requested for this job.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"created_at\":{\"description\":\"When you submitted the preview job.\",\"format\":\"Unix timestamp\",\"type\":\"integer\"},\"is_processed\":{\"description\":\"`true` once every device has settled, for the email in the path—a multi-language run reports each of its emails separately, so this doesn't reflect the whole run when it covers more than one. Poll this field, and see the endpoint description for how often, and for when to give up.\\n\",\"type\":\"boolean\"},\"name\":{\"description\":\"The batch label provided when you sent an email for previews. Empty if none was given.\",\"type\":\"string\"},\"previews\":{\"description\":\"One object per requested preview.\",\"items\":{\"description\":\"The data for a single preview.\",\"properties\":{\"browser\":{\"description\":\"Browser used to render the client, when applicable. Populates when `category` is `Web`.\",\"type\":\"string\"},\"cached\":{\"description\":\"Set when the item wasn't newly generated in this preview job because it had already been generated. Omitted when `false`.\",\"type\":\"boolean\"},\"category\":{\"description\":\"Client category. `Mobile` is a phone's native mail app, for example the Gmail App on Android devices. `Application` is a desktop native mail app, for example Apple Mail on macOS. `Web` is webmail viewed in a desktop browser, for example Gmail.com in Firefox, and includes a `browser` value.\",\"enum\":[\"Mobile\",\"Application\",\"Web\"],\"type\":\"string\"},\"client_id\":{\"description\":\"The preview identifier, matching a value from `client_ids` in the submit request.\",\"type\":\"string\"},\"display_name\":{\"description\":\"Human-readable name of the client and device used to render the preview.\",\"type\":\"string\"},\"error\":{\"description\":\"Details for a tile whose rendering failed.\",\"properties\":{\"message\":{\"description\":\"A human-readable explanation, safe to show to a user.\",\"type\":\"string\"},\"type\":{\"description\":\"Why this device has no screenshot:\\n  - `bounced`: the vendor rendered the device and reported a bounce.\\n  - `vendor_timeout`: submitted to the vendor, but didn't finish in time.\\n  - `client_rejected`: the vendor refused the device id.\\n  - `vendor_request`: the submission to the vendor itself failed.\\n  - `abandoned`: submitted, but the outcome is unknown.\\n  - `expired`: the screenshot rendered successfully but has since aged out of its retention window and is no longer available. Unlike the other types, this isn't a render failure.\\n  - `other`: any other cause.\\n\\nA tile with any of these types (except `expired`) was refunded its credit.\\n\",\"enum\":[\"bounced\",\"vendor_timeout\",\"client_rejected\",\"vendor_request\",\"abandoned\",\"expired\",\"other\"],\"type\":\"string\"}},\"type\":\"object\"},\"full_thumbnail\":{\"description\":\"Capture URL for a reduced, full-length version of the default screenshot. Omitted unless the render completed.\",\"type\":\"string\"},\"os\":{\"description\":\"Operating system the client runs on.\",\"type\":\"string\"},\"screenshots\":{\"additionalProperties\":{\"type\":\"string\"},\"description\":\"Capture URLs keyed by image name—the full-size screenshot under `default`, plus a key per extra image the device renders. This is the only place the full-size URL appears; `thumbnail` and `full_thumbnail` are reduced variants. Omitted unless the render completed.\",\"type\":\"object\"},\"status\":{\"description\":\"The vendor's own status for this device's render. Only `Complete` and `Bounced` are terminal.\",\"enum\":[\"Pending\",\"Processing\",\"Complete\",\"Bounced\"],\"type\":\"string\"},\"thumbnail\":{\"description\":\"Capture URL for a reduced-size version of the default screenshot. Useful for grid/list views where you don't want to load full-size screenshots. Omitted unless the render completed.\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"},\"run_id\":{\"description\":\"ID of the preview job.\",\"type\":\"integer\"},\"total_previews_bounced\":{\"description\":\"Previews that produced no screenshot, whether the vendor bounced them or they failed on Customer.io's side. Their credits are refunded when the run settles.\",\"type\":\"integer\"},\"total_previews_cached\":{\"description\":\"Previews served from an earlier run's screenshot. Not charged, and not counted in `total_previews_succeeded`.\",\"type\":\"integer\"},\"total_previews_ready\":{\"description\":\"How many previews show a screenshot you can fetch, counted from the tiles themselves. This is the progress count to compare against `total_previews_requested`—`total_previews_succeeded` alone reads `0` on a fully cached run. It isn't the completion signal; `is_processed` is. Because a tile can be served by an earlier screenshot of the same content while this run's own render is still in flight, this can reach `total_previews_requested` before the run finishes.\\n\",\"type\":\"integer\"},\"total_previews_requested\":{\"description\":\"Previews requested in the job, for the email in the path. On a settled run, this is normally `total_previews_cached` + `total_previews_succeeded` + `total_previews_bounced`.\",\"type\":\"integer\"},\"total_previews_succeeded\":{\"description\":\"Previews this run generated itself, excluding cached ones. A fully cached run reports `0` here even though every tile is `Complete`—compare `total_previews_ready` against `total_previews_requested` instead to track progress.\",\"type\":\"integer\"},\"updated_at\":{\"description\":\"When the job's status was last updated.\",\"format\":\"Unix timestamp\",\"type\":\"integer\"}},\"type\":\"object\"}}},\"description\":\"Successful response\"},\"401\":{\"content\":{\"application/json\":{\"example\":{\"errors\":[{\"detail\":\"unauthorized\",\"status\":\"401\"}]},\"schema\":{\"description\":\"An error response containing one or more error details.\",\"properties\":{\"errors\":{\"description\":\"A list of errors that occurred while processing the request.\",\"items\":{\"properties\":{\"detail\":{\"description\":\"Reason for error\",\"type\":\"string\"},\"meta\":{\"description\":\"Additional detail about the error, when there is any. A failed publish uses this to list Liquid errors per language.\",\"type\":\"object\"},\"status\":{\"description\":\"Response code\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"}},\"type\":\"object\"}}},\"description\":\"Unauthorized - missing or invalid API key\"},\"404\":{\"content\":{\"application/json\":{\"schema\":{\"description\":\"An error response containing one or more error details.\",\"properties\":{\"errors\":{\"description\":\"A list of errors that occurred while processing the request.\",\"items\":{\"properties\":{\"detail\":{\"description\":\"Reason for error\",\"type\":\"string\"},\"meta\":{\"description\":\"Additional detail about the error, when there is any. A failed publish uses this to list Liquid errors per language.\",\"type\":\"object\"},\"status\":{\"description\":\"Response code\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"}},\"type\":\"object\"}}},\"description\":\"The job doesn't exist, or inbox previews aren't enabled for your workspace.\"},\"429\":{\"content\":{\"application/json\":{\"example\":{\"errors\":[{\"detail\":\"rate limited to 10 requests per second\",\"status\":\"429\"}]},\"schema\":{\"description\":\"An error response containing one or more error details.\",\"properties\":{\"errors\":{\"description\":\"A list of errors that occurred while processing the request.\",\"items\":{\"properties\":{\"detail\":{\"description\":\"Reason for error\",\"type\":\"string\"},\"meta\":{\"description\":\"Additional detail about the error, when there is any. A failed publish uses this to list Liquid errors per language.\",\"type\":\"object\"},\"status\":{\"description\":\"Response code\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"}},\"type\":\"object\"}}},\"description\":\"Over the App API's shared limit of 10 requests per second per workspace—the same bucket every call in your workspace that isn't separately rate limited draws from, writes included. The response carries a `Retry-After` header.\\n\"}},\"securitySchemes\":{\"Bearer-Auth\":{\"description\":\"The App API uses a bearer authentication scheme.\\n\\nYou can generate a bearer token, known as an **App API Key**, with a defined scope in [your account settings](https://fly.customer.io/settings/api_credentials?keyType=app). [Learn more about bearer authorization in Customer.io](/accounts/settings/managing-credentials).\\n\",\"scheme\":\"bearer\",\"type\":\"http\"},\"ServiceAccount-Auth\":{\"bearerFormat\":\"sa_live_\",\"description\":\"Transactional send endpoints (`/v1/send/email`, `/v1/send/push`, `/v1/send/sms`, `/v1/send/whatsapp`, `/v1/send/in_app`, `/v1/send/inbox_message`) also accept a service-account bearer token, prefixed with `sa_live_`. Service-account tokens work across workspaces, so you must pass the target workspace as the `X-Workspace-Id` header on each request.\\n\\nService-account tokens are intended for testing and one-off sends—for example, using the Customer.io CLI with an AI agent like Claude to verify that a transactional message renders correctly before wiring it into your production backend. **For the production integration that triggers the message from your application, use an App API Key instead**: it's workspace-scoped, easier to rotate, and has a smaller blast radius.\\n\\nService-account tokens are server-side credentials. Treat them like any API key—keep them in environment variables or a secret manager, and never embed them in client-side code, mobile apps, or other untrusted contexts.\\n\",\"scheme\":\"bearer\",\"type\":\"http\"},\"bearerAuth\":{\"description\":\"API key passed as a Bearer token\",\"scheme\":\"bearer\",\"type\":\"http\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "GET"
          orig: "/v1/design_studio/emails/{id}/inbox_previews/{run_id}"
          rename: {
            param: {
              id: "email_id"
            }
          }
          segments: [
            {
              lit: "v1"
            }
            {
              lit: "design_studio"
            }
            {
              lit: "emails"
            }
            {
              var: "email_id"
            }
            {
              lit: "inbox_previews"
            }
            {
              var: "run_id"
            }
          ]
          select: {
            exist: [
              "email_id"
              "run_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          args: {
            params: [
              {
                kind: "param"
                name: "email_id"
                orig: "id"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "version_id"
                orig: "version_id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "GET /v1/design_studio/emails/{id}/versions/{version_id}"
            json: "{\"operationId\":\"getVersion\",\"parameters\":[{\"description\":\"The UUID of the email. If your email has translations, this is the ID of a specific language variant.\\n\",\"in\":\"path\",\"name\":\"id\",\"required\":true,\"schema\":{\"format\":\"uuid\",\"type\":\"string\"}},{\"description\":\"The UUID of the version.\",\"in\":\"path\",\"name\":\"version_id\",\"required\":true,\"schema\":{\"format\":\"uuid\",\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"dependencies\":{\"items\":{\"description\":\"The code of the referenced custom component(s) in the node version.\",\"example\":{\"component_name\":\"footer\",\"content\":\"<script>...</script><template>...</template>\",\"name\":\"Footer\",\"node_id\":\"1abcbb4e-402e-949e-f6732f333\",\"node_type\":\"COMPONENT\"},\"properties\":{\"component_name\":{\"description\":\"The component tag name when you saved this version.\",\"type\":[\"string\",\"null\"]},\"content\":{\"description\":\"HTML content as of the snapshot.\",\"type\":\"string\"},\"name\":{\"description\":\"Display name of the component in Design Studio.\",\"type\":\"string\"},\"node_id\":{\"description\":\"UUID of the component node.\",\"format\":\"uuid\",\"type\":\"string\"},\"node_type\":{\"description\":\"Always `COMPONENT`.\",\"enum\":[\"COMPONENT\"],\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"},\"node\":{\"description\":\"The content and settings stored in the version.\",\"example\":{\"content\":\"<x-base>...</x-base>\",\"envelope\":{\"bcc\":\"\",\"fake_bcc\":true,\"from\":\"Customer.io <noreply@example.com>\",\"from_id\":1,\"headers\":[],\"recipient\":\"{{customer.email}}\",\"reply_to\":\"\",\"reply_to_id\":null},\"name\":\"Onboarding phase 1\",\"node_id\":\"1a0cbb4e-09d3-402e-949e-f6732f021650\",\"node_type\":\"EMAIL\",\"preheader_text\":\"Get started in minutes\",\"subject\":\"Welcome to Design Studio!\",\"transformers\":{\"prevent_widows\":{\"enabled\":false}}},\"properties\":{\"amp\":{\"description\":\"AMP HTML body as of the snapshot. Omitted if the email had none.\",\"type\":\"string\"},\"content\":{\"description\":\"HTML content as of the snapshot. For the content of any referenced custom component, see `dependencies`.\",\"type\":\"string\"},\"envelope\":{\"properties\":{\"bcc\":{\"description\":\"BCC email address.\",\"type\":\"string\"},\"fake_bcc\":{\"description\":\"Whether to use fake BCC. Defaults to true if not provided.\",\"type\":\"boolean\"},\"from\":{\"description\":\"The sender address associated with the from_id.\",\"type\":\"string\"},\"from_id\":{\"description\":\"Sender identity ID.\\n\",\"type\":[\"integer\",\"null\"]},\"headers\":{\"description\":\"Custom headers. Each item: { \\\"name\\\": \\\"string\\\", \\\"value\\\": \\\"string\\\" }.\\n\",\"items\":{\"properties\":{\"name\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"},\"recipient\":{\"description\":\"Recipient expression. Defaults to {{customer.email}} if not set.\",\"type\":\"string\"},\"reply_to\":{\"description\":\"The reply-to address associated with the reply_to_id.\",\"type\":\"string\"},\"reply_to_id\":{\"description\":\"Reply-to identity ID. This matches one of the ids in *Workspace Settings > Email*.\\n\",\"type\":[\"integer\",\"null\"]}},\"type\":\"object\"},\"name\":{\"description\":\"Display name of the email in Design Studio. If the version is a language variant, the title ends in the language code like \\\"Onboarding email (fr)\\\".\",\"type\":\"string\"},\"node_id\":{\"description\":\"UUID of the node.\",\"format\":\"uuid\",\"type\":\"string\"},\"node_type\":{\"description\":\"Always `EMAIL` for the node.\",\"enum\":[\"EMAIL\"],\"type\":\"string\"},\"preheader_text\":{\"description\":\"Preview text as of the snapshot. Omitted if the email had none.\",\"type\":\"string\"},\"subject\":{\"description\":\"Email subject line.\",\"type\":\"string\"},\"text\":{\"description\":\"Plain text body as of the snapshot. Omitted if the email had none.\",\"type\":\"string\"},\"transformers\":{\"description\":\"Automate repetitive actions like removing white space and inlining CSS with [transformers](/journeys/design-studio/emails/code-editor/overview/#transformers).\",\"properties\":{\"accessibility\":{\"description\":\"Applies a set of accessibility improvements to the email HTML. When no `language` is set, this falls back to the `lang` attribute on the `<html>` tag, or `\\\"und\\\"` (undetermined). The `dir` attribute is automatically derived from the language using RTL detection.\\n\",\"properties\":{\"add_dir_to_content\":{\"default\":true,\"description\":\"Add `dir` attribute to direct children of `<body>`.\\n\",\"type\":\"boolean\"},\"add_dir_to_html\":{\"default\":true,\"description\":\"Add `dir` attribute (`ltr`, `rtl`, or `auto`) to the `<html>` element if not already present.\\n\",\"type\":\"boolean\"},\"add_empty_alt_to_images\":{\"default\":true,\"description\":\"Add `alt=\\\"\\\"` to `<img>` elements missing an `alt` attribute, preventing screen readers from reading the file name.\\n\",\"type\":\"boolean\"},\"add_lang_to_content\":{\"default\":true,\"description\":\"Add `lang` attribute to direct children of `<body>`.\\n\",\"type\":\"boolean\"},\"add_lang_to_html\":{\"default\":true,\"description\":\"Add `lang` attribute to the `<html>` element if not already present.\\n\",\"type\":\"boolean\"},\"add_role_to_tables\":{\"default\":true,\"description\":\"Add `role=\\\"presentation\\\"` to all `<table>` elements without an existing `role`, so screen readers skip table semantics for layout tables.\\n\",\"type\":\"boolean\"},\"add_title_to_head\":{\"default\":true,\"description\":\"Add a `<title>` tag to `<head>` using the email subject line (creates or replaces if empty).\\n\",\"type\":\"boolean\"},\"add_vml_alt_text\":{\"default\":true,\"description\":\"Add `alt` attribute to VML elements (used by Outlook’s Word rendering engine), derived from the element’s text content.\\n\",\"type\":\"boolean\"},\"enabled\":{\"default\":false,\"description\":\"Enable accessibility fixes.\\n\",\"type\":\"boolean\"},\"language\":{\"default\":\"\",\"description\":\"Language code (for example, `\\\"en\\\"`, `\\\"fr\\\"`, or `\\\"ar\\\"`) used for `lang` and `dir` attributes.\\n\",\"type\":\"string\"},\"remove_button_role_from_links\":{\"default\":true,\"description\":\"Remove `role=\\\"button\\\"` from `<a>` tags to restore proper link semantics for screen readers.\\n\",\"type\":\"boolean\"},\"remove_zoom_meta_tag\":{\"default\":true,\"description\":\"Remove viewport `<meta>` tags that restrict zoom (`user-scalable=0`, `user-scalable=no`, `maximum-scale=1`, or `maximum-scale=2`).\\n\",\"type\":\"boolean\"}},\"type\":\"object\"},\"css_inliner\":{\"description\":\"Moves CSS from `<style>` tags into inline `style` attributes on each element. Essential for email clients with limited `<style>` support (for example, older Gmail and some Outlook versions). Uses the `juice` library. Elements in `<style>` tags marked with `data-ignore-inlining` are skipped.\\n\",\"properties\":{\"apply_html_attributes\":{\"description\":\"Controls adding redundant HTML attributes alongside inlined CSS to different HTML elements.\\n\",\"properties\":{\"apply_height_attributes\":{\"default\":true,\"description\":\"Add redundant HTML `height` attributes alongside inlined CSS `height` on `<table>`, `<td>`, `<th>`, and `<img>` elements. Only applies to `px` values (and `%` on table elements). Needed for email clients that ignore CSS height.\\n\",\"type\":\"boolean\"},\"apply_table_element_attributes\":{\"default\":true,\"description\":\"Add redundant HTML attributes on table elements (`<table>`, `<th>`, `<tr>`, `<td>`, `<caption>`, `<colgroup>`, `<col>`, `<thead>`, `<tbody>`, `<tfoot>`): `background-color` → `bgcolor`, `background-image` → `background`, `text-align` → `align`, `vertical-align` → `valign`.\\n\",\"type\":\"boolean\"},\"apply_width_attributes\":{\"default\":true,\"description\":\"Add redundant HTML `width` attributes alongside inlined CSS `width` on `<table>`, `<td>`, `<th>`, and `<img>` elements. Only applies to `px` values (and `%` on table elements). Needed for email clients that ignore CSS width (for example, older Outlook).\\n\",\"type\":\"boolean\"},\"enabled\":{\"default\":true,\"description\":\"Enable adding redundant HTML attributes.\\n\",\"type\":\"boolean\"}},\"type\":\"object\"},\"apply_style_tags\":{\"default\":true,\"description\":\"Inline styles from `<style>` tags.\\n\",\"type\":\"boolean\"},\"enabled\":{\"default\":false,\"description\":\"Enable CSS inlining.\\n\",\"type\":\"boolean\"},\"inline_pseudo_elements\":{\"default\":false,\"description\":\"Attempt to inline pseudo-element (`::before`, `::after`) styles.\\n\",\"type\":\"boolean\"},\"preserve_font_faces\":{\"default\":true,\"description\":\"Keep `@font-face` rules in `<style>` (cannot be inlined).\\n\",\"type\":\"boolean\"},\"preserve_important\":{\"default\":false,\"description\":\"Preserve `!important` declarations in inlined styles.\\n\",\"type\":\"boolean\"},\"preserve_keyframes\":{\"default\":true,\"description\":\"Keep `@keyframes` rules in `<style>` (cannot be inlined).\\n\",\"type\":\"boolean\"},\"preserve_media_queries\":{\"default\":true,\"description\":\"Keep `@media` rules in `<style>` (cannot be inlined).\\n\",\"type\":\"boolean\"},\"preserve_pseudos\":{\"default\":true,\"description\":\"Keep pseudo-selector rules (for example, `:hover`) in `<style>` (cannot be inlined).\\n\",\"type\":\"boolean\"},\"remove_style_tags\":{\"default\":true,\"description\":\"Remove `<style>` tags after inlining their rules.\\n\",\"type\":\"boolean\"}},\"type\":\"object\"},\"css_variables\":{\"description\":\"Resolves CSS custom properties (`var(--name)`) into their computed values. Required for email clients that do not support CSS custom properties (most email clients). Variables declared in one `<style>` tag are available in subsequent `<style>` tags.\\n\",\"properties\":{\"enabled\":{\"default\":false,\"description\":\"Enable CSS variable resolution.\\n\",\"type\":\"boolean\"},\"preserve\":{\"default\":false,\"description\":\"Keep original custom property declarations (`--name: value`) alongside the resolved values.\\n\",\"type\":\"boolean\"}},\"type\":\"object\"},\"encode_entities\":{\"description\":\"Encodes special characters (for example, `©`, `™`, and `—`) as their HTML entity equivalents. Improves rendering consistency across email clients with varying character encoding support. Only processes text nodes in the `<body>` and skips `<script>`, `<style>`, `<noscript>`, `<svg>`, and `<head>` elements. Preserves Liquid template tags and avoids double-encoding existing entities.\\n\",\"properties\":{\"enabled\":{\"default\":false,\"description\":\"Enable HTML entity encoding.\\n\",\"type\":\"boolean\"}},\"type\":\"object\"},\"formatter\":{\"description\":\"Controls the output formatting of the final HTML. Only one mode (`prettify` or `minify`) can be active at a time. Set to `\\\"none\\\"` to skip formatting entirely.\\n\",\"properties\":{\"minify\":{\"description\":\"Options used when `type` is `\\\"minify\\\"`. Reduces file size by stripping whitespace and comments.\\n\",\"properties\":{\"line_length_limit\":{\"default\":500,\"description\":\"Maximum characters per line before inserting a line break.\\n\",\"type\":\"integer\"},\"remove_css_comments\":{\"default\":true,\"description\":\"Remove CSS comments (`/* ... */`) from `<style>` blocks.\\n\",\"type\":\"boolean\"},\"remove_html_comments\":{\"default\":\"0\",\"description\":\"HTML comment removal level. `\\\"0\\\"` keeps all comments, `\\\"1\\\"` removes non-conditional comments (preserves MSO conditionals like `<!--[if mso]>`), and `\\\"2\\\"` removes all comments including conditional.\\n\",\"enum\":[\"0\",\"1\",\"2\"],\"type\":\"string\"},\"remove_indentations\":{\"default\":true,\"description\":\"Remove leading whitespace indentation.\\n\",\"type\":\"boolean\"},\"remove_line_breaks\":{\"default\":false,\"description\":\"Remove all line breaks from the output.\\n\",\"type\":\"boolean\"}},\"type\":\"object\"},\"prettify\":{\"description\":\"Options used when `type` is `\\\"prettify\\\"`. Produces human-readable, indented HTML output.\\n\",\"properties\":{\"indent_character\":{\"default\":\"spaces\",\"description\":\"Character used for indentation.\\n\",\"enum\":[\"spaces\",\"tabs\"],\"type\":\"string\"},\"indent_size\":{\"default\":2,\"description\":\"Number of indent characters per level.\\n\",\"type\":\"integer\"},\"wrap_attributes\":{\"default\":false,\"description\":\"Wrap HTML attributes onto separate lines (`force-expand-multiline` mode).\\n\",\"type\":\"boolean\"}},\"type\":\"object\"},\"type\":{\"default\":\"none\",\"description\":\"Formatting mode to apply.\\n\",\"enum\":[\"none\",\"prettify\",\"minify\"],\"type\":\"string\"}},\"type\":\"object\"},\"prevent_widows\":{\"description\":\"Replaces the last space in text blocks with a non-breaking space (`&nbsp;`) to prevent a single word from wrapping onto its own line (a “widow”). Only processes text nodes in the `<body>` and skips `<script>`, `<style>`, `<noscript>`, `<svg>`, and `<head>` elements. Preserves Liquid template tags (`{{ }} ` and `{% %}`).\\n\",\"properties\":{\"enabled\":{\"default\":false,\"description\":\"Enable widow word prevention.\\n\",\"type\":\"boolean\"}},\"type\":\"object\"},\"remove_unused_css\":{\"description\":\"Scans the HTML and removes any CSS selectors from `<style>` tags that are not referenced in the document. Reduces file size and helps avoid Gmail’s 102 KB clipping limit. HTML and CSS comments are always preserved by this step (comment removal is handled separately by the formatter object).\\n\",\"properties\":{\"backend_markers\":{\"default\":[{\"heads\":\"\",\"tails\":\"\"},{\"heads\":\"{%\",\"tails\":\"%}\"}],\"description\":\"Template syntax delimiters (e.g., Liquid, Handlebars) that the CSS parser should skip over to avoid treating template expressions as invalid CSS.\\n\",\"items\":{\"properties\":{\"heads\":{\"description\":\"Opening delimiter.\\n\",\"type\":\"string\"},\"tails\":{\"description\":\"Closing delimiter.\\n\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"},\"enabled\":{\"default\":false,\"description\":\"Enable unused CSS removal.\\n\",\"type\":\"boolean\"},\"uglify\":{\"default\":false,\"description\":\"Shorten (uglify) CSS class names to reduce file size.\\n\",\"type\":\"boolean\"},\"whitelist\":{\"description\":\"CSS selectors to always keep, even if they are not found in the HTML.\\n  - .ReadMsgBody\\n  - .ExternalClass\\n  - .aBn\\n  - .a6S\\n  - .im\\n  - .yshortcuts\\n  - \\\"#outlook\\\"\\n  - .MsoHyperlink\\n  - .MsoHyperlinkFollowed\\n\",\"items\":{\"description\":\"A CSS selector to always keep.\\n\",\"type\":\"string\"},\"type\":\"array\"}},\"type\":\"object\"},\"url_parameters\":{\"description\":\"Appends query string parameters to all absolute URLs in `<a>` and VML elements. Useful for adding UTM tracking or other analytics parameters. Skips `mailto:`, `tel:`, and `sms:` links. Elements marked with `data-ignore-params` are excluded.\\n\",\"properties\":{\"enabled\":{\"default\":false,\"description\":\"Enable URL parameter injection.\\n\",\"type\":\"boolean\"},\"parameters\":{\"default\":[],\"description\":\"List of parameters to append to URLs.\\n\",\"items\":{\"properties\":{\"key\":{\"description\":\"Parameter name.\\n\",\"type\":\"string\"},\"url_encode\":{\"description\":\"URL-encode the value before appending it to the URL.\\n\",\"type\":\"boolean\"},\"value\":{\"description\":\"Parameter value. May contain template variables.\\n\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"}},\"type\":\"object\"}},\"type\":\"object\"}},\"type\":\"object\"},\"version\":{\"example\":{\"created\":1773856017,\"created_on_publish\":false,\"feedback\":false,\"id\":\"8f14e45f-ceea-4c67-9814-b8f0e0e1a6f0\",\"name\":\"Before holiday redesign\",\"node_id\":\"1a0cbb4e-09d3-402e-949e-f6732f021650\",\"node_type\":\"EMAIL\"},\"properties\":{\"created\":{\"description\":\"The date-time the version was created.\",\"format\":\"Unix timestamp\",\"type\":\"integer\"},\"created_on_publish\":{\"description\":\"`false` if you [saved the email](/integrations/api/app/tag/design-studio-emails/saveVersion/). `true` if  Design Studio created this version automatically when you [published the email](/integrations/api/app/tag/design-studio-emails/publishEmail/). You can't delete versions generated by Design Studio.\\n\",\"type\":\"boolean\"},\"description\":{\"description\":\"Explanatory text you provided when creating a version. Omitted if no description.\",\"type\":\"string\"},\"feedback\":{\"description\":\"`true` is you saved this version by creating a [round of feedback in Design Studio](/messaging/design-studio/collaboration/feedback/).\\n\",\"type\":\"boolean\"},\"id\":{\"description\":\"UUID of the version.\",\"format\":\"uuid\",\"type\":\"string\"},\"name\":{\"description\":\"Name given to the version when it was saved.\",\"type\":\"string\"},\"node_id\":{\"description\":\"UUID of the email node this version belongs to.\",\"format\":\"uuid\",\"type\":\"string\"},\"node_type\":{\"description\":\"Always `\\\"EMAIL\\\"`.\",\"enum\":[\"EMAIL\"],\"type\":\"string\"}},\"type\":\"object\"}},\"type\":\"object\"}}},\"description\":\"Successful response\"},\"400\":{\"content\":{\"application/json\":{\"schema\":{\"description\":\"An error response containing one or more error details.\",\"properties\":{\"errors\":{\"description\":\"A list of errors that occurred while processing the request.\",\"items\":{\"properties\":{\"detail\":{\"description\":\"Reason for error\",\"type\":\"string\"},\"meta\":{\"description\":\"Additional detail about the error, when there is any. A failed publish uses this to list Liquid errors per language.\",\"type\":\"object\"},\"status\":{\"description\":\"Response code\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"}},\"type\":\"object\"}}},\"description\":\"Bad request. Possible reasons include `:id` is not a valid UUID, the node is not an email, or `version_id` is not a valid UUID.\\n\"},\"401\":{\"content\":{\"application/json\":{\"example\":{\"errors\":[{\"detail\":\"unauthorized\",\"status\":\"401\"}]},\"schema\":{\"description\":\"An error response containing one or more error details.\",\"properties\":{\"errors\":{\"description\":\"A list of errors that occurred while processing the request.\",\"items\":{\"properties\":{\"detail\":{\"description\":\"Reason for error\",\"type\":\"string\"},\"meta\":{\"description\":\"Additional detail about the error, when there is any. A failed publish uses this to list Liquid errors per language.\",\"type\":\"object\"},\"status\":{\"description\":\"Response code\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"}},\"type\":\"object\"}}},\"description\":\"Unauthorized - missing or invalid API key\"},\"404\":{\"content\":{\"application/json\":{\"schema\":{\"description\":\"An error response containing one or more error details.\",\"properties\":{\"errors\":{\"description\":\"A list of errors that occurred while processing the request.\",\"items\":{\"properties\":{\"detail\":{\"description\":\"Reason for error\",\"type\":\"string\"},\"meta\":{\"description\":\"Additional detail about the error, when there is any. A failed publish uses this to list Liquid errors per language.\",\"type\":\"object\"},\"status\":{\"description\":\"Response code\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"}},\"type\":\"object\"}}},\"description\":\"Possible reasons include the email node or version doesn't exist.\\n\"}},\"securitySchemes\":{\"Bearer-Auth\":{\"description\":\"The App API uses a bearer authentication scheme.\\n\\nYou can generate a bearer token, known as an **App API Key**, with a defined scope in [your account settings](https://fly.customer.io/settings/api_credentials?keyType=app). [Learn more about bearer authorization in Customer.io](/accounts/settings/managing-credentials).\\n\",\"scheme\":\"bearer\",\"type\":\"http\"},\"ServiceAccount-Auth\":{\"bearerFormat\":\"sa_live_\",\"description\":\"Transactional send endpoints (`/v1/send/email`, `/v1/send/push`, `/v1/send/sms`, `/v1/send/whatsapp`, `/v1/send/in_app`, `/v1/send/inbox_message`) also accept a service-account bearer token, prefixed with `sa_live_`. Service-account tokens work across workspaces, so you must pass the target workspace as the `X-Workspace-Id` header on each request.\\n\\nService-account tokens are intended for testing and one-off sends—for example, using the Customer.io CLI with an AI agent like Claude to verify that a transactional message renders correctly before wiring it into your production backend. **For the production integration that triggers the message from your application, use an App API Key instead**: it's workspace-scoped, easier to rotate, and has a smaller blast radius.\\n\\nService-account tokens are server-side credentials. Treat them like any API key—keep them in environment variables or a secret manager, and never embed them in client-side code, mobile apps, or other untrusted contexts.\\n\",\"scheme\":\"bearer\",\"type\":\"http\"},\"bearerAuth\":{\"description\":\"API key passed as a Bearer token\",\"scheme\":\"bearer\",\"type\":\"http\"}},\"securitySource\":\"unspecified\"}"
