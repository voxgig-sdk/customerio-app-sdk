            id: "POST /v1/design_studio/emails/{id}/preview"
            json: "{\"operationId\":\"previewEmail\",\"parameters\":[{\"description\":\"The UUID of the email. If your email has translations, this is the ID of a specific language variant.\\n\",\"in\":\"path\",\"name\":\"id\",\"required\":true,\"schema\":{\"format\":\"uuid\",\"type\":\"string\"}}],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"example\":{\"customer\":{\"email\":\"jane@example.com\",\"first_name\":\"Jane\",\"plan\":\"enterprise\"},\"event\":{\"name\":\"order_completed\",\"total\":149.99}},\"properties\":{\"campaign\":{\"description\":\"Campaign metadata for `{{campaign.*}}`.\",\"type\":\"object\"},\"customer\":{\"description\":\"Customer profile attributes for `{{customer.*}}` variables.\",\"type\":\"object\"},\"event\":{\"description\":\"Event attributes for `{{event.*}}`.\",\"type\":\"object\"},\"journey\":{\"description\":\"Journey metadata for `{{journey.*}}`.\",\"type\":\"object\"},\"lax\":{\"default\":false,\"description\":\"Set to `true` if you want undefined variables to resolve to an empty string instead of reporting an error; this can help you focus on more important errors when you don't provide sample data or fallback values. Liquid *syntax* errors (like broken tags and invalid filters) are always reported as errors.\\n\",\"type\":\"boolean\"},\"message\":{\"description\":\"Message metadata for `{{message.*}}`.\",\"type\":\"object\"},\"objects\":{\"description\":\"Related objects for `{{objects.*}}`.\",\"type\":\"object\"},\"trigger\":{\"description\":\"Trigger data for `{{trigger.*}}`.\",\"type\":\"object\"}},\"type\":\"object\"}}},\"description\":\"All fields are optional.\",\"required\":false},\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"example\":{\"errors\":{\"bcc\":[],\"body\":[],\"body_amp\":[],\"body_plain\":[],\"cc\":[],\"event\":[],\"from\":[],\"layout\":[],\"message\":[],\"preheader_text\":[],\"reply_to\":[],\"snippets\":[],\"subject\":[],\"to\":[],\"trigger\":[]},\"from\":\"\\\"No reply\\\" <noreply@example.com>\",\"html\":\"<!DOCTYPE html>...<p>Purchase info</p>...\",\"links\":[{\"errors\":[],\"text\":\"View your order\",\"tracked\":true,\"url\":\"https://example.com/orders\"}],\"node_id\":\"1a0cbb4e-09d3-402e-949e-f6732f021650\",\"node_type\":\"EMAIL\",\"plaintext_body\":\"Thanks for your recent purchase!\",\"subject\":\"Order Confirmation\",\"text\":\"<html><head></head><body style=\\\"margin:0\\\"><div style=\\\"font-size:16px;line-height:1.5;font-family:Arial,Helvetica,sans-serif;white-space:pre-wrap;padding:10px;\\\">Thanks for your recent purchase!</div></body></html>\"},\"properties\":{\"amp\":{\"description\":\"AMP HTML variant with liquid evaluated. Omitted if the email doesn't have an AMP version.\",\"type\":\"string\"},\"errors\":{\"description\":\"Per-field Liquid error arrays. All 15 fields are always present; an empty array means no errors for that field.\",\"properties\":{\"bcc\":{\"description\":\"BCC field Liquid errors.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"body\":{\"description\":\"HTML body Liquid errors.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"body_amp\":{\"description\":\"AMP body Liquid errors.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"body_plain\":{\"description\":\"Plain-text body Liquid errors.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"cc\":{\"description\":\"CC field Liquid errors.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"event\":{\"description\":\"Event data Liquid errors.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"from\":{\"description\":\"From address Liquid errors.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"layout\":{\"description\":\"Layout template errors.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"message\":{\"description\":\"Message-level errors.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"preheader_text\":{\"description\":\"Preheader Liquid errors.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"reply_to\":{\"description\":\"Reply-to address Liquid errors.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"snippets\":{\"description\":\"Snippet rendering errors.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"subject\":{\"description\":\"Subject line Liquid errors.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"to\":{\"description\":\"Recipient field Liquid errors, for example `\\\"undefined variable: customer.email\\\"`.\\n\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"trigger\":{\"description\":\"Trigger data Liquid errors.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"}},\"type\":\"object\"},\"from\":{\"description\":\"Resolved from address, for example `\\\"Name <email>\\\"`. Omitted when the email doesn't include a from address.\",\"type\":\"string\"},\"headers\":{\"description\":\"One entry per custom header that has Liquid errors. Omitted when there are none.\",\"items\":{\"properties\":{\"name\":{\"description\":\"Errors in the header name.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"value\":{\"description\":\"Errors in the header value.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"}},\"type\":\"object\"},\"type\":\"array\"},\"html\":{\"description\":\"Final HTML with Liquid evaluated, the preheader injected, and dangerous tags removed.\",\"type\":\"string\"},\"language\":{\"description\":\"Language code if the node is a translation. Omitted for default-language nodes.\",\"type\":\"string\"},\"links\":{\"description\":\"Every link in the evaluated HTML body, with any per-link problems.\",\"items\":{\"properties\":{\"errors\":{\"description\":\"Problems with this link, like a relative URL or liquid tags that were URL-encoded. Empty when the link is fine.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"text\":{\"description\":\"The link's visible text.\",\"type\":\"string\"},\"tracked\":{\"description\":\"Whether Customer.io rewrites this link for click tracking when you send the email.\",\"type\":\"boolean\"},\"url\":{\"description\":\"The link URL after liquid evaluation.\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"},\"node_id\":{\"description\":\"The UUID of the previewed email node.\",\"format\":\"uuid\",\"type\":\"string\"},\"node_type\":{\"description\":\"Always `\\\"EMAIL\\\"`.\",\"enum\":[\"EMAIL\"],\"type\":\"string\"},\"plaintext_body\":{\"description\":\"The plain-text part a recipient would get—your plain text version with HTML tags stripped, or text generated from the final HTML if the email doesn't have one. Omitted when empty.\",\"type\":\"string\"},\"preheader_text\":{\"description\":\"Evaluated preheader text. Omitted when the email doesn't include preheaders.\",\"type\":\"string\"},\"subject\":{\"description\":\"Evaluated subject line.\",\"type\":\"string\"},\"text\":{\"description\":\"Plain-text body with liquid evaluated. Omitted if the email doesn't have a plain text version.\",\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"Successful response\"},\"400\":{\"content\":{\"application/json\":{\"schema\":{\"description\":\"An error response containing one or more error details.\",\"properties\":{\"errors\":{\"description\":\"A list of errors that occurred while processing the request.\",\"items\":{\"properties\":{\"detail\":{\"description\":\"Reason for error\",\"type\":\"string\"},\"meta\":{\"description\":\"Additional detail about the error, when there is any. A failed publish uses this to list Liquid errors per language.\",\"type\":\"object\"},\"status\":{\"description\":\"Response code\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"}},\"type\":\"object\"}}},\"description\":\"Bad request\"},\"401\":{\"content\":{\"application/json\":{\"example\":{\"errors\":[{\"detail\":\"unauthorized\",\"status\":\"401\"}]},\"schema\":{\"description\":\"An error response containing one or more error details.\",\"properties\":{\"errors\":{\"description\":\"A list of errors that occurred while processing the request.\",\"items\":{\"properties\":{\"detail\":{\"description\":\"Reason for error\",\"type\":\"string\"},\"meta\":{\"description\":\"Additional detail about the error, when there is any. A failed publish uses this to list Liquid errors per language.\",\"type\":\"object\"},\"status\":{\"description\":\"Response code\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"}},\"type\":\"object\"}}},\"description\":\"Unauthorized - missing or invalid API key\"},\"404\":{\"content\":{\"application/json\":{\"schema\":{\"description\":\"An error response containing one or more error details.\",\"properties\":{\"errors\":{\"description\":\"A list of errors that occurred while processing the request.\",\"items\":{\"properties\":{\"detail\":{\"description\":\"Reason for error\",\"type\":\"string\"},\"meta\":{\"description\":\"Additional detail about the error, when there is any. A failed publish uses this to list Liquid errors per language.\",\"type\":\"object\"},\"status\":{\"description\":\"Response code\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"}},\"type\":\"object\"}}},\"description\":\"Possible reasons:\\n  - The `design_studio_api_manage` feature isn't enabled for this workspace\\n  - The email node doesn't exist\\n\"}},\"securitySchemes\":{\"Bearer-Auth\":{\"description\":\"The App API uses a bearer authentication scheme.\\n\\nYou can generate a bearer token, known as an **App API Key**, with a defined scope in [your account settings](https://fly.customer.io/settings/api_credentials?keyType=app). [Learn more about bearer authorization in Customer.io](/accounts/settings/managing-credentials).\\n\",\"scheme\":\"bearer\",\"type\":\"http\"},\"ServiceAccount-Auth\":{\"bearerFormat\":\"sa_live_\",\"description\":\"Transactional send endpoints (`/v1/send/email`, `/v1/send/push`, `/v1/send/sms`, `/v1/send/whatsapp`, `/v1/send/in_app`, `/v1/send/inbox_message`) also accept a service-account bearer token, prefixed with `sa_live_`. Service-account tokens work across workspaces, so you must pass the target workspace as the `X-Workspace-Id` header on each request.\\n\\nService-account tokens are intended for testing and one-off sends—for example, using the Customer.io CLI with an AI agent like Claude to verify that a transactional message renders correctly before wiring it into your production backend. **For the production integration that triggers the message from your application, use an App API Key instead**: it's workspace-scoped, easier to rotate, and has a smaller blast radius.\\n\\nService-account tokens are server-side credentials. Treat them like any API key—keep them in environment variables or a secret manager, and never embed them in client-side code, mobile apps, or other untrusted contexts.\\n\",\"scheme\":\"bearer\",\"type\":\"http\"},\"bearerAuth\":{\"description\":\"API key passed as a Bearer token\",\"scheme\":\"bearer\",\"type\":\"http\"}},\"securitySource\":\"unspecified\"}"
