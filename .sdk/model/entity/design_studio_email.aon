            id: "PUT /v1/design_studio/emails/{id}"
            json: "{\"operationId\":\"updateEmail\",\"parameters\":[{\"description\":\"The UUID of the email. If your email has multiple languages, you must provide the ID of the **default** language template. This links the workflow to all of the language variants for the template.\",\"in\":\"path\",\"name\":\"id\",\"required\":true,\"schema\":{\"format\":\"uuid\",\"type\":\"string\"}}],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"content\":{\"description\":\"The content of your email.\",\"properties\":{\"amp\":{\"description\":\"AMP HTML body.\",\"type\":\"string\"},\"html\":{\"description\":\"HTML body.\",\"type\":\"string\"},\"preheader_text\":{\"description\":\"Preview text.\",\"type\":\"string\"},\"subject\":{\"description\":\"Email subject line.\",\"type\":\"string\"},\"text\":{\"description\":\"Plain text body.\",\"type\":\"string\"}},\"type\":\"object\"},\"envelope\":{\"description\":\"The envelope of your email, like from and to addresses.\",\"properties\":{\"bcc\":{\"description\":\"BCC email address.\",\"type\":\"string\"},\"fake_bcc\":{\"description\":\"Whether to use fake BCC. Defaults to true if not provided.\",\"type\":\"boolean\"},\"from_id\":{\"description\":\"Sender identity ID. Must reference an existing identity. You can find this in *Workspace Settings > Email* under your From Addresses.\\n\",\"type\":[\"integer\",\"null\"]},\"headers\":{\"description\":\"Custom headers. Each item: { \\\"name\\\": \\\"string\\\", \\\"value\\\": \\\"string\\\" }.\\n\",\"items\":{\"properties\":{\"name\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"},\"recipient\":{\"description\":\"Recipient email address. Defaults to `{{customer.email}}`` if not set.\\n\",\"type\":\"string\"},\"reply_to_id\":{\"description\":\"Reply-to identity ID. Must reference an existing identity from *Workspace Settings > Email* under your From Addresses.\\n\",\"format\":\"int64\",\"type\":[\"integer\",\"null\"]}},\"type\":\"object\"},\"is_template\":{\"description\":\"Whether the email is a reusable template.\",\"type\":\"boolean\"},\"name\":{\"description\":\"Display name of the email.\",\"maxLength\":255,\"minLength\":1,\"type\":\"string\"},\"parent_folder_id\":{\"description\":\"The UUID of the parent folder.\\n\\nOmit if you want no change to where the folder or file is located. Include `null` to move it to your root directory. Or add the UUID of another folder to move it there.\\n\",\"format\":\"uuid\",\"type\":[\"string\",\"null\"]},\"transformers\":{\"description\":\"Automate repetitive actions like removing white space and inlining CSS with [transformers](/journeys/design-studio/emails/code-editor/overview/#transformers).\",\"properties\":{\"accessibility\":{\"description\":\"Applies a set of accessibility improvements to the email HTML. When no `language` is set, this falls back to the `lang` attribute on the `<html>` tag, or `\\\"und\\\"` (undetermined). The `dir` attribute is automatically derived from the language using RTL detection.\\n\",\"properties\":{\"add_dir_to_content\":{\"default\":true,\"description\":\"Add `dir` attribute to direct children of `<body>`.\\n\",\"type\":\"boolean\"},\"add_dir_to_html\":{\"default\":true,\"description\":\"Add `dir` attribute (`ltr`, `rtl`, or `auto`) to the `<html>` element if not already present.\\n\",\"type\":\"boolean\"},\"add_empty_alt_to_images\":{\"default\":true,\"description\":\"Add `alt=\\\"\\\"` to `<img>` elements missing an `alt` attribute, preventing screen readers from reading the file name.\\n\",\"type\":\"boolean\"},\"add_lang_to_content\":{\"default\":true,\"description\":\"Add `lang` attribute to direct children of `<body>`.\\n\",\"type\":\"boolean\"},\"add_lang_to_html\":{\"default\":true,\"description\":\"Add `lang` attribute to the `<html>` element if not already present.\\n\",\"type\":\"boolean\"},\"add_role_to_tables\":{\"default\":true,\"description\":\"Add `role=\\\"presentation\\\"` to all `<table>` elements without an existing `role`, so screen readers skip table semantics for layout tables.\\n\",\"type\":\"boolean\"},\"add_title_to_head\":{\"default\":true,\"description\":\"Add a `<title>` tag to `<head>` using the email subject line (creates or replaces if empty).\\n\",\"type\":\"boolean\"},\"add_vml_alt_text\":{\"default\":true,\"description\":\"Add `alt` attribute to VML elements (used by Outlook’s Word rendering engine), derived from the element’s text content.\\n\",\"type\":\"boolean\"},\"enabled\":{\"default\":false,\"description\":\"Enable accessibility fixes.\\n\",\"type\":\"boolean\"},\"language\":{\"default\":\"\",\"description\":\"Language code (for example, `\\\"en\\\"`, `\\\"fr\\\"`, or `\\\"ar\\\"`) used for `lang` and `dir` attributes.\\n\",\"type\":\"string\"},\"remove_button_role_from_links\":{\"default\":true,\"description\":\"Remove `role=\\\"button\\\"` from `<a>` tags to restore proper link semantics for screen readers.\\n\",\"type\":\"boolean\"},\"remove_zoom_meta_tag\":{\"default\":true,\"description\":\"Remove viewport `<meta>` tags that restrict zoom (`user-scalable=0`, `user-scalable=no`, `maximum-scale=1`, or `maximum-scale=2`).\\n\",\"type\":\"boolean\"}},\"type\":\"object\"},\"css_inliner\":{\"description\":\"Moves CSS from `<style>` tags into inline `style` attributes on each element. Essential for email clients with limited `<style>` support (for example, older Gmail and some Outlook versions). Uses the `juice` library. Elements in `<style>` tags marked with `data-ignore-inlining` are skipped.\\n\",\"properties\":{\"apply_html_attributes\":{\"description\":\"Controls adding redundant HTML attributes alongside inlined CSS to different HTML elements.\\n\",\"properties\":{\"apply_height_attributes\":{\"default\":true,\"description\":\"Add redundant HTML `height` attributes alongside inlined CSS `height` on `<table>`, `<td>`, `<th>`, and `<img>` elements. Only applies to `px` values (and `%` on table elements). Needed for email clients that ignore CSS height.\\n\",\"type\":\"boolean\"},\"apply_table_element_attributes\":{\"default\":true,\"description\":\"Add redundant HTML attributes on table elements (`<table>`, `<th>`, `<tr>`, `<td>`, `<caption>`, `<colgroup>`, `<col>`, `<thead>`, `<tbody>`, `<tfoot>`): `background-color` → `bgcolor`, `background-image` → `background`, `text-align` → `align`, `vertical-align` → `valign`.\\n\",\"type\":\"boolean\"},\"apply_width_attributes\":{\"default\":true,\"description\":\"Add redundant HTML `width` attributes alongside inlined CSS `width` on `<table>`, `<td>`, `<th>`, and `<img>` elements. Only applies to `px` values (and `%` on table elements). Needed for email clients that ignore CSS width (for example, older Outlook).\\n\",\"type\":\"boolean\"},\"enabled\":{\"default\":true,\"description\":\"Enable adding redundant HTML attributes.\\n\",\"type\":\"boolean\"}},\"type\":\"object\"},\"apply_style_tags\":{\"default\":true,\"description\":\"Inline styles from `<style>` tags.\\n\",\"type\":\"boolean\"},\"enabled\":{\"default\":false,\"description\":\"Enable CSS inlining.\\n\",\"type\":\"boolean\"},\"inline_pseudo_elements\":{\"default\":false,\"description\":\"Attempt to inline pseudo-element (`::before`, `::after`) styles.\\n\",\"type\":\"boolean\"},\"preserve_font_faces\":{\"default\":true,\"description\":\"Keep `@font-face` rules in `<style>` (cannot be inlined).\\n\",\"type\":\"boolean\"},\"preserve_important\":{\"default\":false,\"description\":\"Preserve `!important` declarations in inlined styles.\\n\",\"type\":\"boolean\"},\"preserve_keyframes\":{\"default\":true,\"description\":\"Keep `@keyframes` rules in `<style>` (cannot be inlined).\\n\",\"type\":\"boolean\"},\"preserve_media_queries\":{\"default\":true,\"description\":\"Keep `@media` rules in `<style>` (cannot be inlined).\\n\",\"type\":\"boolean\"},\"preserve_pseudos\":{\"default\":true,\"description\":\"Keep pseudo-selector rules (for example, `:hover`) in `<style>` (cannot be inlined).\\n\",\"type\":\"boolean\"},\"remove_style_tags\":{\"default\":true,\"description\":\"Remove `<style>` tags after inlining their rules.\\n\",\"type\":\"boolean\"}},\"type\":\"object\"},\"css_variables\":{\"description\":\"Resolves CSS custom properties (`var(--name)`) into their computed values. Required for email clients that do not support CSS custom properties (most email clients). Variables declared in one `<style>` tag are available in subsequent `<style>` tags.\\n\",\"properties\":{\"enabled\":{\"default\":false,\"description\":\"Enable CSS variable resolution.\\n\",\"type\":\"boolean\"},\"preserve\":{\"default\":false,\"description\":\"Keep original custom property declarations (`--name: value`) alongside the resolved values.\\n\",\"type\":\"boolean\"}},\"type\":\"object\"},\"encode_entities\":{\"description\":\"Encodes special characters (for example, `©`, `™`, and `—`) as their HTML entity equivalents. Improves rendering consistency across email clients with varying character encoding support. Only processes text nodes in the `<body>` and skips `<script>`, `<style>`, `<noscript>`, `<svg>`, and `<head>` elements. Preserves Liquid template tags and avoids double-encoding existing entities.\\n\",\"properties\":{\"enabled\":{\"default\":false,\"description\":\"Enable HTML entity encoding.\\n\",\"type\":\"boolean\"}},\"type\":\"object\"},\"formatter\":{\"description\":\"Controls the output formatting of the final HTML. Only one mode (`prettify` or `minify`) can be active at a time. Set to `\\\"none\\\"` to skip formatting entirely.\\n\",\"properties\":{\"minify\":{\"description\":\"Options used when `type` is `\\\"minify\\\"`. Reduces file size by stripping whitespace and comments.\\n\",\"properties\":{\"line_length_limit\":{\"default\":500,\"description\":\"Maximum characters per line before inserting a line break.\\n\",\"type\":\"integer\"},\"remove_css_comments\":{\"default\":true,\"description\":\"Remove CSS comments (`/* ... */`) from `<style>` blocks.\\n\",\"type\":\"boolean\"},\"remove_html_comments\":{\"default\":\"0\",\"description\":\"HTML comment removal level. `\\\"0\\\"` keeps all comments, `\\\"1\\\"` removes non-conditional comments (preserves MSO conditionals like `<!--[if mso]>`), and `\\\"2\\\"` removes all comments including conditional.\\n\",\"enum\":[\"0\",\"1\",\"2\"],\"type\":\"string\"},\"remove_indentations\":{\"default\":true,\"description\":\"Remove leading whitespace indentation.\\n\",\"type\":\"boolean\"},\"remove_line_breaks\":{\"default\":false,\"description\":\"Remove all line breaks from the output.\\n\",\"type\":\"boolean\"}},\"type\":\"object\"},\"prettify\":{\"description\":\"Options used when `type` is `\\\"prettify\\\"`. Produces human-readable, indented HTML output.\\n\",\"properties\":{\"indent_character\":{\"default\":\"spaces\",\"description\":\"Character used for indentation.\\n\",\"enum\":[\"spaces\",\"tabs\"],\"type\":\"string\"},\"indent_size\":{\"default\":2,\"description\":\"Number of indent characters per level.\\n\",\"type\":\"integer\"},\"wrap_attributes\":{\"default\":false,\"description\":\"Wrap HTML attributes onto separate lines (`force-expand-multiline` mode).\\n\",\"type\":\"boolean\"}},\"type\":\"object\"},\"type\":{\"default\":\"none\",\"description\":\"Formatting mode to apply.\\n\",\"enum\":[\"none\",\"prettify\",\"minify\"],\"type\":\"string\"}},\"type\":\"object\"},\"prevent_widows\":{\"description\":\"Replaces the last space in text blocks with a non-breaking space (`&nbsp;`) to prevent a single word from wrapping onto its own line (a “widow”). Only processes text nodes in the `<body>` and skips `<script>`, `<style>`, `<noscript>`, `<svg>`, and `<head>` elements. Preserves Liquid template tags (`{{ }} ` and `{% %}`).\\n\",\"properties\":{\"enabled\":{\"default\":false,\"description\":\"Enable widow word prevention.\\n\",\"type\":\"boolean\"}},\"type\":\"object\"},\"remove_unused_css\":{\"description\":\"Scans the HTML and removes any CSS selectors from `<style>` tags that are not referenced in the document. Reduces file size and helps avoid Gmail’s 102 KB clipping limit. HTML and CSS comments are always preserved by this step (comment removal is handled separately by the formatter object).\\n\",\"properties\":{\"backend_markers\":{\"default\":[{\"heads\":\"\",\"tails\":\"\"},{\"heads\":\"{%\",\"tails\":\"%}\"}],\"description\":\"Template syntax delimiters (e.g., Liquid, Handlebars) that the CSS parser should skip over to avoid treating template expressions as invalid CSS.\\n\",\"items\":{\"properties\":{\"heads\":{\"description\":\"Opening delimiter.\\n\",\"type\":\"string\"},\"tails\":{\"description\":\"Closing delimiter.\\n\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"},\"enabled\":{\"default\":false,\"description\":\"Enable unused CSS removal.\\n\",\"type\":\"boolean\"},\"uglify\":{\"default\":false,\"description\":\"Shorten (uglify) CSS class names to reduce file size.\\n\",\"type\":\"boolean\"},\"whitelist\":{\"description\":\"CSS selectors to always keep, even if they are not found in the HTML.\\n  - .ReadMsgBody\\n  - .ExternalClass\\n  - .aBn\\n  - .a6S\\n  - .im\\n  - .yshortcuts\\n  - \\\"#outlook\\\"\\n  - .MsoHyperlink\\n  - .MsoHyperlinkFollowed\\n\",\"items\":{\"description\":\"A CSS selector to always keep.\\n\",\"type\":\"string\"},\"type\":\"array\"}},\"type\":\"object\"},\"url_parameters\":{\"description\":\"Appends query string parameters to all absolute URLs in `<a>` and VML elements. Useful for adding UTM tracking or other analytics parameters. Skips `mailto:`, `tel:`, and `sms:` links. Elements marked with `data-ignore-params` are excluded.\\n\",\"properties\":{\"enabled\":{\"default\":false,\"description\":\"Enable URL parameter injection.\\n\",\"type\":\"boolean\"},\"parameters\":{\"default\":[],\"description\":\"List of parameters to append to URLs.\\n\",\"items\":{\"properties\":{\"key\":{\"description\":\"Parameter name.\\n\",\"type\":\"string\"},\"url_encode\":{\"description\":\"URL-encode the value before appending it to the URL.\\n\",\"type\":\"boolean\"},\"value\":{\"description\":\"Parameter value. May contain template variables.\\n\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"}},\"type\":\"object\"}},\"type\":\"object\"}},\"type\":\"object\"}}},\"description\":\"You must provide a body with at least one of the following properties. Omitting a field leaves it unchanged.\",\"required\":true},\"responses\":{\"204\":{\"description\":\"Email updated, no content returned\"},\"400\":{\"content\":{\"application/json\":{\"schema\":{\"description\":\"An error response containing one or more error details.\",\"properties\":{\"errors\":{\"description\":\"A list of errors that occurred while processing the request.\",\"items\":{\"properties\":{\"detail\":{\"description\":\"Reason for error\",\"type\":\"string\"},\"meta\":{\"description\":\"Additional detail about the error, when there is any. A failed publish uses this to list Liquid errors per language.\",\"type\":\"object\"},\"status\":{\"description\":\"Response code\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"}},\"type\":\"object\"}}},\"description\":\"Bad request. Possible reasons:\\n  - No fields provided\\n  - Invalid name\\n  - Unknown JSON field in content, envelope, or transformers\\n  - from_id or reply_to_id does not reference an existing identity\\n  - parent_folder_id is an empty string\\n\"},\"401\":{\"content\":{\"application/json\":{\"example\":{\"errors\":[{\"detail\":\"unauthorized\",\"status\":\"401\"}]},\"schema\":{\"description\":\"An error response containing one or more error details.\",\"properties\":{\"errors\":{\"description\":\"A list of errors that occurred while processing the request.\",\"items\":{\"properties\":{\"detail\":{\"description\":\"Reason for error\",\"type\":\"string\"},\"meta\":{\"description\":\"Additional detail about the error, when there is any. A failed publish uses this to list Liquid errors per language.\",\"type\":\"object\"},\"status\":{\"description\":\"Response code\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"}},\"type\":\"object\"}}},\"description\":\"Unauthorized - missing or invalid API key\"},\"404\":{\"content\":{\"application/json\":{\"example\":{\"errors\":[{\"detail\":\"resource not found\",\"status\":\"404\"}]},\"schema\":{\"description\":\"An error response containing one or more error details.\",\"properties\":{\"errors\":{\"description\":\"A list of errors that occurred while processing the request.\",\"items\":{\"properties\":{\"detail\":{\"description\":\"Reason for error\",\"type\":\"string\"},\"meta\":{\"description\":\"Additional detail about the error, when there is any. A failed publish uses this to list Liquid errors per language.\",\"type\":\"object\"},\"status\":{\"description\":\"Response code\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"}},\"type\":\"object\"}}},\"description\":\"Resource not found\"}},\"securitySchemes\":{\"Bearer-Auth\":{\"description\":\"The App API uses a bearer authentication scheme.\\n\\nYou can generate a bearer token, known as an **App API Key**, with a defined scope in [your account settings](https://fly.customer.io/settings/api_credentials?keyType=app). [Learn more about bearer authorization in Customer.io](/accounts/settings/managing-credentials).\\n\",\"scheme\":\"bearer\",\"type\":\"http\"},\"ServiceAccount-Auth\":{\"bearerFormat\":\"sa_live_\",\"description\":\"Transactional send endpoints (`/v1/send/email`, `/v1/send/push`, `/v1/send/sms`, `/v1/send/whatsapp`, `/v1/send/in_app`, `/v1/send/inbox_message`) also accept a service-account bearer token, prefixed with `sa_live_`. Service-account tokens work across workspaces, so you must pass the target workspace as the `X-Workspace-Id` header on each request.\\n\\nService-account tokens are intended for testing and one-off sends—for example, using the Customer.io CLI with an AI agent like Claude to verify that a transactional message renders correctly before wiring it into your production backend. **For the production integration that triggers the message from your application, use an App API Key instead**: it's workspace-scoped, easier to rotate, and has a smaller blast radius.\\n\\nService-account tokens are server-side credentials. Treat them like any API key—keep them in environment variables or a secret manager, and never embed them in client-side code, mobile apps, or other untrusted contexts.\\n\",\"scheme\":\"bearer\",\"type\":\"http\"},\"bearerAuth\":{\"description\":\"API key passed as a Bearer token\",\"scheme\":\"bearer\",\"type\":\"http\"}},\"securitySource\":\"unspecified\"}"
