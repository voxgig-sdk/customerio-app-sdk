          }
          contract: {
            id: "POST /v1/design_studio/emails/{id}/inbox_previews"
            json: "{\"operationId\":\"submitInboxPreview\",\"parameters\":[{\"description\":\"The UUID of the email. If your email has translations, this is the ID of a specific language variant.\\n\",\"in\":\"path\",\"name\":\"id\",\"required\":true,\"schema\":{\"format\":\"uuid\",\"type\":\"string\"}}],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"example\":{\"client_ids\":[\"android12_gmailapp_pixel6_dm\",\"android12_gmailapp_pixel6_dm_dark\"],\"name\":\"Welcome email previews\",\"sample_data\":{\"customer\":{\"first_name\":\"Janine\"}}},\"properties\":{\"client_ids\":{\"description\":\"The identifiers of the preview options you want. You can retrieve client IDs from [List inbox preview options](/integrations/api/app/tag/design-studio-emails/listInboxPreviewClients/).\\n\",\"items\":{\"type\":\"string\"},\"maxItems\":150,\"minItems\":1,\"type\":\"array\"},\"lax_mode\":{\"default\":false,\"description\":\"Set to `true` to render liquid variables missing from `sample_data` as blank instead of failing the job.\",\"type\":\"boolean\"},\"name\":{\"description\":\"A label for the batch of previews, shown in [preview history](/integrations/api/app/tag/design-studio-emails/listInboxPreviewJobs/).\",\"maxLength\":191,\"type\":\"string\"},\"sample_data\":{\"additionalProperties\":true,\"description\":\"Liquid variables to render with, as a JSON object—any shape is accepted, from flat variables like `{\\\"first_name\\\": \\\"Janine\\\"}` to nested ones like `{\\\"customer\\\": {\\\"first_name\\\": \\\"Janine\\\"}}`. Defaults to none, which fails the render on any variable the content needs beyond the ones a preview already sets for you. Set `lax_mode` to render missing variables as blank instead. Limited to 128 KB.\\n\",\"type\":\"object\"}},\"required\":[\"client_ids\"],\"type\":\"object\"}}},\"required\":true},\"responses\":{\"200\":{\"content\":{\"application/json\":{\"example\":{\"replayed\":false,\"run_id\":10},\"schema\":{\"properties\":{\"replayed\":{\"description\":\"`true` when this call returned an existing run instead of starting a new one, and you weren't charged a second time for it. This happens for an identical request (same email, content, and devices) submitted again on the same UTC day, an identical request from the day before that's still processing, or a concurrent identical request that got there first. The run may belong to another client in your workspace, including the Journeys UI—`created_at` is that run's, and a `name` you send is applied to it.\\n\",\"type\":\"boolean\"},\"run_id\":{\"description\":\"ID of the preview job. Check when it's complete with [Get an inbox preview job](/integrations/api/app/tag/design-studio-emails/getInboxPreviewJob/).\",\"type\":\"integer\"}},\"type\":\"object\"}}},\"description\":\"Preview job submitted\"},\"400\":{\"content\":{\"application/json\":{\"schema\":{\"description\":\"An error response containing one or more error details.\",\"properties\":{\"errors\":{\"description\":\"A list of errors that occurred while processing the request.\",\"items\":{\"properties\":{\"detail\":{\"description\":\"Reason for error\",\"type\":\"string\"},\"meta\":{\"description\":\"Additional detail about the error, when there is any. A failed publish uses this to list Liquid errors per language.\",\"type\":\"object\"},\"status\":{\"description\":\"Response code\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"}},\"type\":\"object\"}}},\"description\":\"Bad request\"},\"401\":{\"content\":{\"application/json\":{\"example\":{\"errors\":[{\"detail\":\"unauthorized\",\"status\":\"401\"}]},\"schema\":{\"description\":\"An error response containing one or more error details.\",\"properties\":{\"errors\":{\"description\":\"A list of errors that occurred while processing the request.\",\"items\":{\"properties\":{\"detail\":{\"description\":\"Reason for error\",\"type\":\"string\"},\"meta\":{\"description\":\"Additional detail about the error, when there is any. A failed publish uses this to list Liquid errors per language.\",\"type\":\"object\"},\"status\":{\"description\":\"Response code\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"}},\"type\":\"object\"}}},\"description\":\"Unauthorized - missing or invalid API key\"},\"403\":{\"content\":{\"application/json\":{\"example\":{\"errors\":[{\"detail\":\"this account cannot be charged for inbox previews\",\"status\":\"403\"}]},\"schema\":{\"description\":\"An error response containing one or more error details.\",\"properties\":{\"errors\":{\"description\":\"A list of errors that occurred while processing the request.\",\"items\":{\"properties\":{\"detail\":{\"description\":\"Reason for error\",\"type\":\"string\"},\"meta\":{\"description\":\"Additional detail about the error, when there is any. A failed publish uses this to list Liquid errors per language.\",\"type\":\"object\"},\"status\":{\"description\":\"Response code\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"}},\"type\":\"object\"}}},\"description\":\"Your account can't be charged for inbox preview credits right now. Credits are account-level—every workspace on the account draws from the same pools, so this isn't specific to the workspace in your credentials.\"},\"404\":{\"content\":{\"application/json\":{\"example\":{\"errors\":[{\"detail\":\"resource not found\",\"status\":\"404\"}]},\"schema\":{\"description\":\"An error response containing one or more error details.\",\"properties\":{\"errors\":{\"description\":\"A list of errors that occurred while processing the request.\",\"items\":{\"properties\":{\"detail\":{\"description\":\"Reason for error\",\"type\":\"string\"},\"meta\":{\"description\":\"Additional detail about the error, when there is any. A failed publish uses this to list Liquid errors per language.\",\"type\":\"object\"},\"status\":{\"description\":\"Response code\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"}},\"type\":\"object\"}}},\"description\":\"Resource not found\"},\"409\":{\"content\":{\"application/json\":{\"example\":{\"errors\":[{\"detail\":\"this preview batch was already charged and settled today. Change the devices or nodes you are previewing, or try again tomorrow.\",\"status\":\"409\"}]},\"schema\":{\"description\":\"An error response containing one or more error details.\",\"properties\":{\"errors\":{\"description\":\"A list of errors that occurred while processing the request.\",\"items\":{\"properties\":{\"detail\":{\"description\":\"Reason for error\",\"type\":\"string\"},\"meta\":{\"description\":\"Additional detail about the error, when there is any. A failed publish uses this to list Liquid errors per language.\",\"type\":\"object\"},\"status\":{\"description\":\"Response code\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"}},\"type\":\"object\"}}},\"description\":\"A retry crossed an interrupted charge for this batch. This means one of two things:\\n  - The batch was already charged and settled today.\\n  - An earlier attempt at the same batch is still being reconciled.\\n\\nChange the devices or nodes you're previewing, or retry later. Either way, you weren't double-charged.\\n\"},\"422\":{\"content\":{\"application/json\":{\"example\":{\"errors\":[{\"detail\":\"insufficient inbox preview credits: this request needs 12, the account has 4 available\",\"status\":\"422\"}]},\"schema\":{\"description\":\"An error response containing one or more error details.\",\"properties\":{\"errors\":{\"description\":\"A list of errors that occurred while processing the request.\",\"items\":{\"properties\":{\"detail\":{\"description\":\"Reason for error\",\"type\":\"string\"},\"meta\":{\"description\":\"Additional detail about the error, when there is any. A failed publish uses this to list Liquid errors per language.\",\"type\":\"object\"},\"status\":{\"description\":\"Response code\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"}},\"type\":\"object\"}}},\"description\":\"Not enough inbox preview credits to cover every device in `client_ids`. The message names both figures, so you can size a top-up without a separate call to [Get preview credit balance](/integrations/api/app/tag/design-studio-emails/getInboxPreviewCredits/).\"},\"429\":{\"content\":{\"application/json\":{\"example\":{\"errors\":[{\"detail\":\"rate limited to 5 requests per second\",\"status\":\"429\"}]},\"schema\":{\"description\":\"An error response containing one or more error details.\",\"properties\":{\"errors\":{\"description\":\"A list of errors that occurred while processing the request.\",\"items\":{\"properties\":{\"detail\":{\"description\":\"Reason for error\",\"type\":\"string\"},\"meta\":{\"description\":\"Additional detail about the error, when there is any. A failed publish uses this to list Liquid errors per language.\",\"type\":\"object\"},\"status\":{\"description\":\"Response code\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"}},\"type\":\"object\"}}},\"description\":\"Rate limited to 5 requests per second per workspace—a bucket shared with the Design Studio link, publish, render, preview, and review endpoints, and tighter than the 10 per second reads get, because each call starts a server-side render before it reaches the vendor. The response carries a `Retry-After` header.\\n\"},\"503\":{\"content\":{\"application/json\":{\"example\":{\"errors\":[{\"detail\":\"the email renderer could not be reached; try again in a moment\",\"status\":\"503\"}]},\"schema\":{\"description\":\"An error response containing one or more error details.\",\"properties\":{\"errors\":{\"description\":\"A list of errors that occurred while processing the request.\",\"items\":{\"properties\":{\"detail\":{\"description\":\"Reason for error\",\"type\":\"string\"},\"meta\":{\"description\":\"Additional detail about the error, when there is any. A failed publish uses this to list Liquid errors per language.\",\"type\":\"object\"},\"status\":{\"description\":\"Response code\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"}},\"type\":\"object\"}}},\"description\":\"The email or Liquid renderer couldn't be reached. This is transient—retry in a moment.\"}},\"securitySchemes\":{\"Bearer-Auth\":{\"description\":\"The App API uses a bearer authentication scheme.\\n\\nYou can generate a bearer token, known as an **App API Key**, with a defined scope in [your account settings](https://fly.customer.io/settings/api_credentials?keyType=app). [Learn more about bearer authorization in Customer.io](/accounts/settings/managing-credentials).\\n\",\"scheme\":\"bearer\",\"type\":\"http\"},\"ServiceAccount-Auth\":{\"bearerFormat\":\"sa_live_\",\"description\":\"Transactional send endpoints (`/v1/send/email`, `/v1/send/push`, `/v1/send/sms`, `/v1/send/whatsapp`, `/v1/send/in_app`, `/v1/send/inbox_message`) also accept a service-account bearer token, prefixed with `sa_live_`. Service-account tokens work across workspaces, so you must pass the target workspace as the `X-Workspace-Id` header on each request.\\n\\nService-account tokens are intended for testing and one-off sends—for example, using the Customer.io CLI with an AI agent like Claude to verify that a transactional message renders correctly before wiring it into your production backend. **For the production integration that triggers the message from your application, use an App API Key instead**: it's workspace-scoped, easier to rotate, and has a smaller blast radius.\\n\\nService-account tokens are server-side credentials. Treat them like any API key—keep them in environment variables or a secret manager, and never embed them in client-side code, mobile apps, or other untrusted contexts.\\n\",\"scheme\":\"bearer\",\"type\":\"http\"},\"bearerAuth\":{\"description\":\"API key passed as a Bearer token\",\"scheme\":\"bearer\",\"type\":\"http\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "POST"
          orig: "/v1/design_studio/emails/{id}/inbox_previews"
          rename: {
            param: {
              id: "email_id"
            }
          }
          segments: [
            {
              lit: "v1"
            }
            {
              lit: "design_studio"
            }
            {
              lit: "emails"
            }
            {
              var: "email_id"
            }
            {
              lit: "inbox_previews"
            }
          ]
          select: {
            exist: [
              "email_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          args: {
            params: [
              {
                kind: "param"
                name: "email_id"
                orig: "id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "POST /v1/design_studio/emails/{id}/languages"
            json: "{\"operationId\":\"createEmailTranslation\",\"parameters\":[{\"description\":\"The UUID of the email. If your email has multiple languages, you must provide the ID of the **default** language template. This links the workflow to all of the language variants for the template.\",\"in\":\"path\",\"name\":\"id\",\"required\":true,\"schema\":{\"format\":\"uuid\",\"type\":\"string\"}}],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"content\":{\"description\":\"The content of your email.\",\"properties\":{\"amp\":{\"description\":\"AMP HTML body.\",\"type\":\"string\"},\"html\":{\"description\":\"HTML body.\",\"type\":\"string\"},\"preheader_text\":{\"description\":\"Preview text.\",\"type\":\"string\"},\"subject\":{\"description\":\"Email subject line.\",\"type\":\"string\"},\"text\":{\"description\":\"Plain text body.\",\"type\":\"string\"}},\"type\":\"object\"},\"envelope\":{\"description\":\"The envelope of your email, like from and to addresses.\",\"properties\":{\"bcc\":{\"description\":\"BCC email address.\",\"type\":\"string\"},\"fake_bcc\":{\"description\":\"Whether to use fake BCC. Defaults to true if not provided.\",\"type\":\"boolean\"},\"from_id\":{\"description\":\"Sender identity ID. Must reference an existing identity. You can find this in *Workspace Settings > Email* under your From Addresses.\\n\",\"type\":[\"integer\",\"null\"]},\"headers\":{\"description\":\"Custom headers. Each item: { \\\"name\\\": \\\"string\\\", \\\"value\\\": \\\"string\\\" }.\\n\",\"items\":{\"properties\":{\"name\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"},\"recipient\":{\"description\":\"Recipient email address. Defaults to `{{customer.email}}`` if not set.\\n\",\"type\":\"string\"},\"reply_to_id\":{\"description\":\"Reply-to identity ID. Must reference an existing identity from *Workspace Settings > Email* under your From Addresses.\\n\",\"format\":\"int64\",\"type\":[\"integer\",\"null\"]}},\"type\":\"object\"},\"language\":{\"description\":\"A [language code](/journeys/channels/localization/attribute/#supported-languages) that corresponds to the language of the translation\",\"example\":\"es\",\"type\":\"string\"},\"transformers\":{\"description\":\"Automate repetitive actions like removing white space and inlining CSS with [transformers](/journeys/design-studio/emails/code-editor/overview/#transformers).\",\"properties\":{\"accessibility\":{\"description\":\"Applies a set of accessibility improvements to the email HTML. When no `language` is set, this falls back to the `lang` attribute on the `<html>` tag, or `\\\"und\\\"` (undetermined). The `dir` attribute is automatically derived from the language using RTL detection.\\n\",\"properties\":{\"add_dir_to_content\":{\"default\":true,\"description\":\"Add `dir` attribute to direct children of `<body>`.\\n\",\"type\":\"boolean\"},\"add_dir_to_html\":{\"default\":true,\"description\":\"Add `dir` attribute (`ltr`, `rtl`, or `auto`) to the `<html>` element if not already present.\\n\",\"type\":\"boolean\"},\"add_empty_alt_to_images\":{\"default\":true,\"description\":\"Add `alt=\\\"\\\"` to `<img>` elements missing an `alt` attribute, preventing screen readers from reading the file name.\\n\",\"type\":\"boolean\"},\"add_lang_to_content\":{\"default\":true,\"description\":\"Add `lang` attribute to direct children of `<body>`.\\n\",\"type\":\"boolean\"},\"add_lang_to_html\":{\"default\":true,\"description\":\"Add `lang` attribute to the `<html>` element if not already present.\\n\",\"type\":\"boolean\"},\"add_role_to_tables\":{\"default\":true,\"description\":\"Add `role=\\\"presentation\\\"` to all `<table>` elements without an existing `role`, so screen readers skip table semantics for layout tables.\\n\",\"type\":\"boolean\"},\"add_title_to_head\":{\"default\":true,\"description\":\"Add a `<title>` tag to `<head>` using the email subject line (creates or replaces if empty).\\n\",\"type\":\"boolean\"},\"add_vml_alt_text\":{\"default\":true,\"description\":\"Add `alt` attribute to VML elements (used by Outlook’s Word rendering engine), derived from the element’s text content.\\n\",\"type\":\"boolean\"},\"enabled\":{\"default\":false,\"description\":\"Enable accessibility fixes.\\n\",\"type\":\"boolean\"},\"language\":{\"default\":\"\",\"description\":\"Language code (for example, `\\\"en\\\"`, `\\\"fr\\\"`, or `\\\"ar\\\"`) used for `lang` and `dir` attributes.\\n\",\"type\":\"string\"},\"remove_button_role_from_links\":{\"default\":true,\"description\":\"Remove `role=\\\"button\\\"` from `<a>` tags to restore proper link semantics for screen readers.\\n\",\"type\":\"boolean\"},\"remove_zoom_meta_tag\":{\"default\":true,\"description\":\"Remove viewport `<meta>` tags that restrict zoom (`user-scalable=0`, `user-scalable=no`, `maximum-scale=1`, or `maximum-scale=2`).\\n\",\"type\":\"boolean\"}},\"type\":\"object\"},\"css_inliner\":{\"description\":\"Moves CSS from `<style>` tags into inline `style` attributes on each element. Essential for email clients with limited `<style>` support (for example, older Gmail and some Outlook versions). Uses the `juice` library. Elements in `<style>` tags marked with `data-ignore-inlining` are skipped.\\n\",\"properties\":{\"apply_html_attributes\":{\"description\":\"Controls adding redundant HTML attributes alongside inlined CSS to different HTML elements.\\n\",\"properties\":{\"apply_height_attributes\":{\"default\":true,\"description\":\"Add redundant HTML `height` attributes alongside inlined CSS `height` on `<table>`, `<td>`, `<th>`, and `<img>` elements. Only applies to `px` values (and `%` on table elements). Needed for email clients that ignore CSS height.\\n\",\"type\":\"boolean\"},\"apply_table_element_attributes\":{\"default\":true,\"description\":\"Add redundant HTML attributes on table elements (`<table>`, `<th>`, `<tr>`, `<td>`, `<caption>`, `<colgroup>`, `<col>`, `<thead>`, `<tbody>`, `<tfoot>`): `background-color` → `bgcolor`, `background-image` → `background`, `text-align` → `align`, `vertical-align` → `valign`.\\n\",\"type\":\"boolean\"},\"apply_width_attributes\":{\"default\":true,\"description\":\"Add redundant HTML `width` attributes alongside inlined CSS `width` on `<table>`, `<td>`, `<th>`, and `<img>` elements. Only applies to `px` values (and `%` on table elements). Needed for email clients that ignore CSS width (for example, older Outlook).\\n\",\"type\":\"boolean\"},\"enabled\":{\"default\":true,\"description\":\"Enable adding redundant HTML attributes.\\n\",\"type\":\"boolean\"}},\"type\":\"object\"},\"apply_style_tags\":{\"default\":true,\"description\":\"Inline styles from `<style>` tags.\\n\",\"type\":\"boolean\"},\"enabled\":{\"default\":false,\"description\":\"Enable CSS inlining.\\n\",\"type\":\"boolean\"},\"inline_pseudo_elements\":{\"default\":false,\"description\":\"Attempt to inline pseudo-element (`::before`, `::after`) styles.\\n\",\"type\":\"boolean\"},\"preserve_font_faces\":{\"default\":true,\"description\":\"Keep `@font-face` rules in `<style>` (cannot be inlined).\\n\",\"type\":\"boolean\"},\"preserve_important\":{\"default\":false,\"description\":\"Preserve `!important` declarations in inlined styles.\\n\",\"type\":\"boolean\"},\"preserve_keyframes\":{\"default\":true,\"description\":\"Keep `@keyframes` rules in `<style>` (cannot be inlined).\\n\",\"type\":\"boolean\"},\"preserve_media_queries\":{\"default\":true,\"description\":\"Keep `@media` rules in `<style>` (cannot be inlined).\\n\",\"type\":\"boolean\"},\"preserve_pseudos\":{\"default\":true,\"description\":\"Keep pseudo-selector rules (for example, `:hover`) in `<style>` (cannot be inlined).\\n\",\"type\":\"boolean\"},\"remove_style_tags\":{\"default\":true,\"description\":\"Remove `<style>` tags after inlining their rules.\\n\",\"type\":\"boolean\"}},\"type\":\"object\"},\"css_variables\":{\"description\":\"Resolves CSS custom properties (`var(--name)`) into their computed values. Required for email clients that do not support CSS custom properties (most email clients). Variables declared in one `<style>` tag are available in subsequent `<style>` tags.\\n\",\"properties\":{\"enabled\":{\"default\":false,\"description\":\"Enable CSS variable resolution.\\n\",\"type\":\"boolean\"},\"preserve\":{\"default\":false,\"description\":\"Keep original custom property declarations (`--name: value`) alongside the resolved values.\\n\",\"type\":\"boolean\"}},\"type\":\"object\"},\"encode_entities\":{\"description\":\"Encodes special characters (for example, `©`, `™`, and `—`) as their HTML entity equivalents. Improves rendering consistency across email clients with varying character encoding support. Only processes text nodes in the `<body>` and skips `<script>`, `<style>`, `<noscript>`, `<svg>`, and `<head>` elements. Preserves Liquid template tags and avoids double-encoding existing entities.\\n\",\"properties\":{\"enabled\":{\"default\":false,\"description\":\"Enable HTML entity encoding.\\n\",\"type\":\"boolean\"}},\"type\":\"object\"},\"formatter\":{\"description\":\"Controls the output formatting of the final HTML. Only one mode (`prettify` or `minify`) can be active at a time. Set to `\\\"none\\\"` to skip formatting entirely.\\n\",\"properties\":{\"minify\":{\"description\":\"Options used when `type` is `\\\"minify\\\"`. Reduces file size by stripping whitespace and comments.\\n\",\"properties\":{\"line_length_limit\":{\"default\":500,\"description\":\"Maximum characters per line before inserting a line break.\\n\",\"type\":\"integer\"},\"remove_css_comments\":{\"default\":true,\"description\":\"Remove CSS comments (`/* ... */`) from `<style>` blocks.\\n\",\"type\":\"boolean\"},\"remove_html_comments\":{\"default\":\"0\",\"description\":\"HTML comment removal level. `\\\"0\\\"` keeps all comments, `\\\"1\\\"` removes non-conditional comments (preserves MSO conditionals like `<!--[if mso]>`), and `\\\"2\\\"` removes all comments including conditional.\\n\",\"enum\":[\"0\",\"1\",\"2\"],\"type\":\"string\"},\"remove_indentations\":{\"default\":true,\"description\":\"Remove leading whitespace indentation.\\n\",\"type\":\"boolean\"},\"remove_line_breaks\":{\"default\":false,\"description\":\"Remove all line breaks from the output.\\n\",\"type\":\"boolean\"}},\"type\":\"object\"},\"prettify\":{\"description\":\"Options used when `type` is `\\\"prettify\\\"`. Produces human-readable, indented HTML output.\\n\",\"properties\":{\"indent_character\":{\"default\":\"spaces\",\"description\":\"Character used for indentation.\\n\",\"enum\":[\"spaces\",\"tabs\"],\"type\":\"string\"},\"indent_size\":{\"default\":2,\"description\":\"Number of indent characters per level.\\n\",\"type\":\"integer\"},\"wrap_attributes\":{\"default\":false,\"description\":\"Wrap HTML attributes onto separate lines (`force-expand-multiline` mode).\\n\",\"type\":\"boolean\"}},\"type\":\"object\"},\"type\":{\"default\":\"none\",\"description\":\"Formatting mode to apply.\\n\",\"enum\":[\"none\",\"prettify\",\"minify\"],\"type\":\"string\"}},\"type\":\"object\"},\"prevent_widows\":{\"description\":\"Replaces the last space in text blocks with a non-breaking space (`&nbsp;`) to prevent a single word from wrapping onto its own line (a “widow”). Only processes text nodes in the `<body>` and skips `<script>`, `<style>`, `<noscript>`, `<svg>`, and `<head>` elements. Preserves Liquid template tags (`{{ }} ` and `{% %}`).\\n\",\"properties\":{\"enabled\":{\"default\":false,\"description\":\"Enable widow word prevention.\\n\",\"type\":\"boolean\"}},\"type\":\"object\"},\"remove_unused_css\":{\"description\":\"Scans the HTML and removes any CSS selectors from `<style>` tags that are not referenced in the document. Reduces file size and helps avoid Gmail’s 102 KB clipping limit. HTML and CSS comments are always preserved by this step (comment removal is handled separately by the formatter object).\\n\",\"properties\":{\"backend_markers\":{\"default\":[{\"heads\":\"\",\"tails\":\"\"},{\"heads\":\"{%\",\"tails\":\"%}\"}],\"description\":\"Template syntax delimiters (e.g., Liquid, Handlebars) that the CSS parser should skip over to avoid treating template expressions as invalid CSS.\\n\",\"items\":{\"properties\":{\"heads\":{\"description\":\"Opening delimiter.\\n\",\"type\":\"string\"},\"tails\":{\"description\":\"Closing delimiter.\\n\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"},\"enabled\":{\"default\":false,\"description\":\"Enable unused CSS removal.\\n\",\"type\":\"boolean\"},\"uglify\":{\"default\":false,\"description\":\"Shorten (uglify) CSS class names to reduce file size.\\n\",\"type\":\"boolean\"},\"whitelist\":{\"description\":\"CSS selectors to always keep, even if they are not found in the HTML.\\n  - .ReadMsgBody\\n  - .ExternalClass\\n  - .aBn\\n  - .a6S\\n  - .im\\n  - .yshortcuts\\n  - \\\"#outlook\\\"\\n  - .MsoHyperlink\\n  - .MsoHyperlinkFollowed\\n\",\"items\":{\"description\":\"A CSS selector to always keep.\\n\",\"type\":\"string\"},\"type\":\"array\"}},\"type\":\"object\"},\"url_parameters\":{\"description\":\"Appends query string parameters to all absolute URLs in `<a>` and VML elements. Useful for adding UTM tracking or other analytics parameters. Skips `mailto:`, `tel:`, and `sms:` links. Elements marked with `data-ignore-params` are excluded.\\n\",\"properties\":{\"enabled\":{\"default\":false,\"description\":\"Enable URL parameter injection.\\n\",\"type\":\"boolean\"},\"parameters\":{\"default\":[],\"description\":\"List of parameters to append to URLs.\\n\",\"items\":{\"properties\":{\"key\":{\"description\":\"Parameter name.\\n\",\"type\":\"string\"},\"url_encode\":{\"description\":\"URL-encode the value before appending it to the URL.\\n\",\"type\":\"boolean\"},\"value\":{\"description\":\"Parameter value. May contain template variables.\\n\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"}},\"type\":\"object\"}},\"type\":\"object\"}},\"required\":[\"language\"],\"type\":\"object\"}}},\"description\":\"How content is inherited from the default, parent email:\\n  - If both `content` and `envelope` are omitted: envelope (including subject and preheader) is copied verbatim from the parent email\\n  - If `content` is provided but `envelope` is omitted: the envelope is reconstructed from the parent’s envelope settings, using the new subject and preheader\\n  - If `envelope` is provided but `content` is omitted: the provided envelope is used with the parent’s subject and preheader\\n  - HTML, AMP, and text body fields are always copied from parent if `content` is omitted\\n\",\"required\":true},\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"email_translation\":{\"properties\":{\"available_languages\":{\"description\":\"List of [language codes](/journeys/channels/localization/attribute/#supported-languages) that reflect the languages this default email has been translated to.\",\"example\":[\"en\",\"es\"],\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"content\":{\"description\":\"The content of your email.\",\"properties\":{\"amp\":{\"description\":\"AMP HTML body.\",\"type\":\"string\"},\"html\":{\"description\":\"HTML body.\",\"type\":\"string\"},\"preheader_text\":{\"description\":\"Preview text.\",\"type\":\"string\"},\"subject\":{\"description\":\"Email subject line.\",\"type\":\"string\"},\"text\":{\"description\":\"Plain text body.\",\"type\":\"string\"}},\"type\":\"object\"},\"created\":{\"description\":\"Unix timestamp of when the translation was created.\",\"example\":1773856017,\"type\":\"integer\"},\"envelope\":{\"properties\":{\"bcc\":{\"description\":\"BCC email address.\",\"type\":\"string\"},\"fake_bcc\":{\"description\":\"Whether to use fake BCC. Defaults to true if not provided.\",\"type\":\"boolean\"},\"from\":{\"description\":\"The sender address associated with the from_id.\",\"type\":\"string\"},\"from_id\":{\"description\":\"Sender identity ID.\\n\",\"type\":[\"integer\",\"null\"]},\"headers\":{\"description\":\"Custom headers. Each item: { \\\"name\\\": \\\"string\\\", \\\"value\\\": \\\"string\\\" }.\\n\",\"items\":{\"properties\":{\"name\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"},\"recipient\":{\"description\":\"Recipient expression. Defaults to {{customer.email}} if not set.\",\"type\":\"string\"},\"reply_to\":{\"description\":\"The reply-to address associated with the reply_to_id.\",\"type\":\"string\"},\"reply_to_id\":{\"description\":\"Reply-to identity ID. This matches one of the ids in *Workspace Settings > Email*.\\n\",\"type\":[\"integer\",\"null\"]}},\"type\":\"object\"},\"is_linked\":{\"description\":\"Whether the translation is linked to a workflow (automation, broadcast, etc)\",\"type\":\"boolean\"},\"is_template\":{\"description\":\"Whether the translation is a template\",\"type\":\"boolean\"},\"language\":{\"description\":\"The [language code](/journeys/channels/localization/attribute/#supported-languages) of the translation\",\"example\":\"fr\",\"type\":\"string\"},\"language_group_id\":{\"description\":\"ID of the parent email that groups all translations. Same as the id in the path parameter.\",\"format\":\"uuid\",\"type\":\"string\"},\"parent_folder_id\":{\"description\":\"UUID of the parent folder, or `null` if the email is in your root directory.\",\"format\":\"uuid\",\"type\":[\"string\",\"null\"]},\"transformers\":{\"description\":\"Automate repetitive actions like removing white space and inlining CSS with [transformers](/journeys/design-studio/emails/code-editor/overview/#transformers).\",\"properties\":{\"accessibility\":{\"description\":\"Applies a set of accessibility improvements to the email HTML. When no `language` is set, this falls back to the `lang` attribute on the `<html>` tag, or `\\\"und\\\"` (undetermined). The `dir` attribute is automatically derived from the language using RTL detection.\\n\",\"properties\":{\"add_dir_to_content\":{\"default\":true,\"description\":\"Add `dir` attribute to direct children of `<body>`.\\n\",\"type\":\"boolean\"},\"add_dir_to_html\":{\"default\":true,\"description\":\"Add `dir` attribute (`ltr`, `rtl`, or `auto`) to the `<html>` element if not already present.\\n\",\"type\":\"boolean\"},\"add_empty_alt_to_images\":{\"default\":true,\"description\":\"Add `alt=\\\"\\\"` to `<img>` elements missing an `alt` attribute, preventing screen readers from reading the file name.\\n\",\"type\":\"boolean\"},\"add_lang_to_content\":{\"default\":true,\"description\":\"Add `lang` attribute to direct children of `<body>`.\\n\",\"type\":\"boolean\"},\"add_lang_to_html\":{\"default\":true,\"description\":\"Add `lang` attribute to the `<html>` element if not already present.\\n\",\"type\":\"boolean\"},\"add_role_to_tables\":{\"default\":true,\"description\":\"Add `role=\\\"presentation\\\"` to all `<table>` elements without an existing `role`, so screen readers skip table semantics for layout tables.\\n\",\"type\":\"boolean\"},\"add_title_to_head\":{\"default\":true,\"description\":\"Add a `<title>` tag to `<head>` using the email subject line (creates or replaces if empty).\\n\",\"type\":\"boolean\"},\"add_vml_alt_text\":{\"default\":true,\"description\":\"Add `alt` attribute to VML elements (used by Outlook’s Word rendering engine), derived from the element’s text content.\\n\",\"type\":\"boolean\"},\"enabled\":{\"default\":false,\"description\":\"Enable accessibility fixes.\\n\",\"type\":\"boolean\"},\"language\":{\"default\":\"\",\"description\":\"Language code (for example, `\\\"en\\\"`, `\\\"fr\\\"`, or `\\\"ar\\\"`) used for `lang` and `dir` attributes.\\n\",\"type\":\"string\"},\"remove_button_role_from_links\":{\"default\":true,\"description\":\"Remove `role=\\\"button\\\"` from `<a>` tags to restore proper link semantics for screen readers.\\n\",\"type\":\"boolean\"},\"remove_zoom_meta_tag\":{\"default\":true,\"description\":\"Remove viewport `<meta>` tags that restrict zoom (`user-scalable=0`, `user-scalable=no`, `maximum-scale=1`, or `maximum-scale=2`).\\n\",\"type\":\"boolean\"}},\"type\":\"object\"},\"css_inliner\":{\"description\":\"Moves CSS from `<style>` tags into inline `style` attributes on each element. Essential for email clients with limited `<style>` support (for example, older Gmail and some Outlook versions). Uses the `juice` library. Elements in `<style>` tags marked with `data-ignore-inlining` are skipped.\\n\",\"properties\":{\"apply_html_attributes\":{\"description\":\"Controls adding redundant HTML attributes alongside inlined CSS to different HTML elements.\\n\",\"properties\":{\"apply_height_attributes\":{\"default\":true,\"description\":\"Add redundant HTML `height` attributes alongside inlined CSS `height` on `<table>`, `<td>`, `<th>`, and `<img>` elements. Only applies to `px` values (and `%` on table elements). Needed for email clients that ignore CSS height.\\n\",\"type\":\"boolean\"},\"apply_table_element_attributes\":{\"default\":true,\"description\":\"Add redundant HTML attributes on table elements (`<table>`, `<th>`, `<tr>`, `<td>`, `<caption>`, `<colgroup>`, `<col>`, `<thead>`, `<tbody>`, `<tfoot>`): `background-color` → `bgcolor`, `background-image` → `background`, `text-align` → `align`, `vertical-align` → `valign`.\\n\",\"type\":\"boolean\"},\"apply_width_attributes\":{\"default\":true,\"description\":\"Add redundant HTML `width` attributes alongside inlined CSS `width` on `<table>`, `<td>`, `<th>`, and `<img>` elements. Only applies to `px` values (and `%` on table elements). Needed for email clients that ignore CSS width (for example, older Outlook).\\n\",\"type\":\"boolean\"},\"enabled\":{\"default\":true,\"description\":\"Enable adding redundant HTML attributes.\\n\",\"type\":\"boolean\"}},\"type\":\"object\"},\"apply_style_tags\":{\"default\":true,\"description\":\"Inline styles from `<style>` tags.\\n\",\"type\":\"boolean\"},\"enabled\":{\"default\":false,\"description\":\"Enable CSS inlining.\\n\",\"type\":\"boolean\"},\"inline_pseudo_elements\":{\"default\":false,\"description\":\"Attempt to inline pseudo-element (`::before`, `::after`) styles.\\n\",\"type\":\"boolean\"},\"preserve_font_faces\":{\"default\":true,\"description\":\"Keep `@font-face` rules in `<style>` (cannot be inlined).\\n\",\"type\":\"boolean\"},\"preserve_important\":{\"default\":false,\"description\":\"Preserve `!important` declarations in inlined styles.\\n\",\"type\":\"boolean\"},\"preserve_keyframes\":{\"default\":true,\"description\":\"Keep `@keyframes` rules in `<style>` (cannot be inlined).\\n\",\"type\":\"boolean\"},\"preserve_media_queries\":{\"default\":true,\"description\":\"Keep `@media` rules in `<style>` (cannot be inlined).\\n\",\"type\":\"boolean\"},\"preserve_pseudos\":{\"default\":true,\"description\":\"Keep pseudo-selector rules (for example, `:hover`) in `<style>` (cannot be inlined).\\n\",\"type\":\"boolean\"},\"remove_style_tags\":{\"default\":true,\"description\":\"Remove `<style>` tags after inlining their rules.\\n\",\"type\":\"boolean\"}},\"type\":\"object\"},\"css_variables\":{\"description\":\"Resolves CSS custom properties (`var(--name)`) into their computed values. Required for email clients that do not support CSS custom properties (most email clients). Variables declared in one `<style>` tag are available in subsequent `<style>` tags.\\n\",\"properties\":{\"enabled\":{\"default\":false,\"description\":\"Enable CSS variable resolution.\\n\",\"type\":\"boolean\"},\"preserve\":{\"default\":false,\"description\":\"Keep original custom property declarations (`--name: value`) alongside the resolved values.\\n\",\"type\":\"boolean\"}},\"type\":\"object\"},\"encode_entities\":{\"description\":\"Encodes special characters (for example, `©`, `™`, and `—`) as their HTML entity equivalents. Improves rendering consistency across email clients with varying character encoding support. Only processes text nodes in the `<body>` and skips `<script>`, `<style>`, `<noscript>`, `<svg>`, and `<head>` elements. Preserves Liquid template tags and avoids double-encoding existing entities.\\n\",\"properties\":{\"enabled\":{\"default\":false,\"description\":\"Enable HTML entity encoding.\\n\",\"type\":\"boolean\"}},\"type\":\"object\"},\"formatter\":{\"description\":\"Controls the output formatting of the final HTML. Only one mode (`prettify` or `minify`) can be active at a time. Set to `\\\"none\\\"` to skip formatting entirely.\\n\",\"properties\":{\"minify\":{\"description\":\"Options used when `type` is `\\\"minify\\\"`. Reduces file size by stripping whitespace and comments.\\n\",\"properties\":{\"line_length_limit\":{\"default\":500,\"description\":\"Maximum characters per line before inserting a line break.\\n\",\"type\":\"integer\"},\"remove_css_comments\":{\"default\":true,\"description\":\"Remove CSS comments (`/* ... */`) from `<style>` blocks.\\n\",\"type\":\"boolean\"},\"remove_html_comments\":{\"default\":\"0\",\"description\":\"HTML comment removal level. `\\\"0\\\"` keeps all comments, `\\\"1\\\"` removes non-conditional comments (preserves MSO conditionals like `<!--[if mso]>`), and `\\\"2\\\"` removes all comments including conditional.\\n\",\"enum\":[\"0\",\"1\",\"2\"],\"type\":\"string\"},\"remove_indentations\":{\"default\":true,\"description\":\"Remove leading whitespace indentation.\\n\",\"type\":\"boolean\"},\"remove_line_breaks\":{\"default\":false,\"description\":\"Remove all line breaks from the output.\\n\",\"type\":\"boolean\"}},\"type\":\"object\"},\"prettify\":{\"description\":\"Options used when `type` is `\\\"prettify\\\"`. Produces human-readable, indented HTML output.\\n\",\"properties\":{\"indent_character\":{\"default\":\"spaces\",\"description\":\"Character used for indentation.\\n\",\"enum\":[\"spaces\",\"tabs\"],\"type\":\"string\"},\"indent_size\":{\"default\":2,\"description\":\"Number of indent characters per level.\\n\",\"type\":\"integer\"},\"wrap_attributes\":{\"default\":false,\"description\":\"Wrap HTML attributes onto separate lines (`force-expand-multiline` mode).\\n\",\"type\":\"boolean\"}},\"type\":\"object\"},\"type\":{\"default\":\"none\",\"description\":\"Formatting mode to apply.\\n\",\"enum\":[\"none\",\"prettify\",\"minify\"],\"type\":\"string\"}},\"type\":\"object\"},\"prevent_widows\":{\"description\":\"Replaces the last space in text blocks with a non-breaking space (`&nbsp;`) to prevent a single word from wrapping onto its own line (a “widow”). Only processes text nodes in the `<body>` and skips `<script>`, `<style>`, `<noscript>`, `<svg>`, and `<head>` elements. Preserves Liquid template tags (`{{ }} ` and `{% %}`).\\n\",\"properties\":{\"enabled\":{\"default\":false,\"description\":\"Enable widow word prevention.\\n\",\"type\":\"boolean\"}},\"type\":\"object\"},\"remove_unused_css\":{\"description\":\"Scans the HTML and removes any CSS selectors from `<style>` tags that are not referenced in the document. Reduces file size and helps avoid Gmail’s 102 KB clipping limit. HTML and CSS comments are always preserved by this step (comment removal is handled separately by the formatter object).\\n\",\"properties\":{\"backend_markers\":{\"default\":[{\"heads\":\"\",\"tails\":\"\"},{\"heads\":\"{%\",\"tails\":\"%}\"}],\"description\":\"Template syntax delimiters (e.g., Liquid, Handlebars) that the CSS parser should skip over to avoid treating template expressions as invalid CSS.\\n\",\"items\":{\"properties\":{\"heads\":{\"description\":\"Opening delimiter.\\n\",\"type\":\"string\"},\"tails\":{\"description\":\"Closing delimiter.\\n\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"},\"enabled\":{\"default\":false,\"description\":\"Enable unused CSS removal.\\n\",\"type\":\"boolean\"},\"uglify\":{\"default\":false,\"description\":\"Shorten (uglify) CSS class names to reduce file size.\\n\",\"type\":\"boolean\"},\"whitelist\":{\"description\":\"CSS selectors to always keep, even if they are not found in the HTML.\\n  - .ReadMsgBody\\n  - .ExternalClass\\n  - .aBn\\n  - .a6S\\n  - .im\\n  - .yshortcuts\\n  - \\\"#outlook\\\"\\n  - .MsoHyperlink\\n  - .MsoHyperlinkFollowed\\n\",\"items\":{\"description\":\"A CSS selector to always keep.\\n\",\"type\":\"string\"},\"type\":\"array\"}},\"type\":\"object\"},\"url_parameters\":{\"description\":\"Appends query string parameters to all absolute URLs in `<a>` and VML elements. Useful for adding UTM tracking or other analytics parameters. Skips `mailto:`, `tel:`, and `sms:` links. Elements marked with `data-ignore-params` are excluded.\\n\",\"properties\":{\"enabled\":{\"default\":false,\"description\":\"Enable URL parameter injection.\\n\",\"type\":\"boolean\"},\"parameters\":{\"default\":[],\"description\":\"List of parameters to append to URLs.\\n\",\"items\":{\"properties\":{\"key\":{\"description\":\"Parameter name.\\n\",\"type\":\"string\"},\"url_encode\":{\"description\":\"URL-encode the value before appending it to the URL.\\n\",\"type\":\"boolean\"},\"value\":{\"description\":\"Parameter value. May contain template variables.\\n\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"}},\"type\":\"object\"}},\"type\":\"object\"},\"updated\":{\"description\":\"Unix timestamp of the last update to the translation.\",\"example\":1773856017,\"type\":\"integer\"}},\"type\":\"object\"}},\"type\":\"object\"}}},\"description\":\"Translation created\"},\"400\":{\"content\":{\"application/json\":{\"schema\":{\"description\":\"An error response containing one or more error details.\",\"properties\":{\"errors\":{\"description\":\"A list of errors that occurred while processing the request.\",\"items\":{\"properties\":{\"detail\":{\"description\":\"Reason for error\",\"type\":\"string\"},\"meta\":{\"description\":\"Additional detail about the error, when there is any. A failed publish uses this to list Liquid errors per language.\",\"type\":\"object\"},\"status\":{\"description\":\"Response code\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"}},\"type\":\"object\"}}},\"description\":\"Bad request. Possible reasons:\\n  - Missing language\\n  - Invalid language code\\n  - Missing required content sub-field when content is provided\\n  - Unknown JSON field in content, envelope, or transformers\\n  - from_id or reply_to_id does not reference an existing identity\\n\"},\"401\":{\"content\":{\"application/json\":{\"example\":{\"errors\":[{\"detail\":\"unauthorized\",\"status\":\"401\"}]},\"schema\":{\"description\":\"An error response containing one or more error details.\",\"properties\":{\"errors\":{\"description\":\"A list of errors that occurred while processing the request.\",\"items\":{\"properties\":{\"detail\":{\"description\":\"Reason for error\",\"type\":\"string\"},\"meta\":{\"description\":\"Additional detail about the error, when there is any. A failed publish uses this to list Liquid errors per language.\",\"type\":\"object\"},\"status\":{\"description\":\"Response code\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"}},\"type\":\"object\"}}},\"description\":\"Unauthorized - missing or invalid API key\"},\"404\":{\"content\":{\"application/json\":{\"example\":{\"errors\":[{\"detail\":\"resource not found\",\"status\":\"404\"}]},\"schema\":{\"description\":\"An error response containing one or more error details.\",\"properties\":{\"errors\":{\"description\":\"A list of errors that occurred while processing the request.\",\"items\":{\"properties\":{\"detail\":{\"description\":\"Reason for error\",\"type\":\"string\"},\"meta\":{\"description\":\"Additional detail about the error, when there is any. A failed publish uses this to list Liquid errors per language.\",\"type\":\"object\"},\"status\":{\"description\":\"Response code\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"}},\"type\":\"object\"}}},\"description\":\"Resource not found\"},\"409\":{\"content\":{\"application/json\":{\"example\":{\"errors\":[{\"detail\":\"a constraint violation prevents this operation\",\"status\":\"409\"}]},\"schema\":{\"description\":\"An error response containing one or more error details.\",\"properties\":{\"errors\":{\"description\":\"A list of errors that occurred while processing the request.\",\"items\":{\"properties\":{\"detail\":{\"description\":\"Reason for error\",\"type\":\"string\"},\"meta\":{\"description\":\"Additional detail about the error, when there is any. A failed publish uses this to list Liquid errors per language.\",\"type\":\"object\"},\"status\":{\"description\":\"Response code\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"}},\"type\":\"object\"}}},\"description\":\"Conflict - linked resource or other constraint violation\"}},\"securitySchemes\":{\"Bearer-Auth\":{\"description\":\"The App API uses a bearer authentication scheme.\\n\\nYou can generate a bearer token, known as an **App API Key**, with a defined scope in [your account settings](https://fly.customer.io/settings/api_credentials?keyType=app). [Learn more about bearer authorization in Customer.io](/accounts/settings/managing-credentials).\\n\",\"scheme\":\"bearer\",\"type\":\"http\"},\"ServiceAccount-Auth\":{\"bearerFormat\":\"sa_live_\",\"description\":\"Transactional send endpoints (`/v1/send/email`, `/v1/send/push`, `/v1/send/sms`, `/v1/send/whatsapp`, `/v1/send/in_app`, `/v1/send/inbox_message`) also accept a service-account bearer token, prefixed with `sa_live_`. Service-account tokens work across workspaces, so you must pass the target workspace as the `X-Workspace-Id` header on each request.\\n\\nService-account tokens are intended for testing and one-off sends—for example, using the Customer.io CLI with an AI agent like Claude to verify that a transactional message renders correctly before wiring it into your production backend. **For the production integration that triggers the message from your application, use an App API Key instead**: it's workspace-scoped, easier to rotate, and has a smaller blast radius.\\n\\nService-account tokens are server-side credentials. Treat them like any API key—keep them in environment variables or a secret manager, and never embed them in client-side code, mobile apps, or other untrusted contexts.\\n\",\"scheme\":\"bearer\",\"type\":\"http\"},\"bearerAuth\":{\"description\":\"API key passed as a Bearer token\",\"scheme\":\"bearer\",\"type\":\"http\"}},\"securitySource\":\"unspecified\"}"
