\"},\"template_id\":{\"description\":\"Restrict the export to a specific message template (content) within the selected automation, one-time send, or transactional message.\",\"type\":\"integer\"},\"transactional_message_id\":{\"description\":\"The ID of the transactional message you want to export information for.\",\"example\":22,\"type\":\"integer\"}},\"required\":[\"transactional_message_id\"],\"title\":\"Transactional Message\"},{\"description\":\"Contains properties shared by export filters.\",\"properties\":{\"action_id\":{\"description\":\"The ID of an action you want to export information from.\",\"example\":77,\"type\":\"integer\"},\"attributes\":{\"description\":\"Recipient attributes you want to include as extra columns in your export. You can't include event or trigger properties.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"drafts\":{\"description\":\"If true, your request returns both drafts and active/sent messages.\",\"type\":\"boolean\"},\"end\":{\"description\":\"The unix timestamp representing the end of the export.\",\"example\":1517702400,\"format\":\"unix timestamp\",\"type\":\"integer\"},\"metric\":{\"description\":\"Determines the metric(s) you want to return.\",\"enum\":[\"created\",\"attempted\",\"sent\",\"delivered\",\"opened\",\"clicked\",\"converted\",\"bounced\",\"spammed\",\"unsubscribed\",\"dropped\",\"failed\",\"undeliverable\"],\"type\":\"string\"},\"start\":{\"description\":\"The unix timestamp representing the beginning of the export.\",\"example\":1517529600,\"format\":\"unix timestamp\",\"type\":\"integer\"},\"template_id\":{\"description\":\"Restrict the export to a specific message template (content) within the selected automation, one-time send, or transactional message.\",\"type\":\"integer\"}},\"required\":[\"action_id\"],\"title\":\"Action\"}]}}}},\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"example\":{\"export\":{\"created_at\":1530296742,\"deduplicate_id\":\"110:1530296738\",\"desc