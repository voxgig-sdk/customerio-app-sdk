# Entity: export

main: kit: entity: export: {

  alias: field: {}

  fields: [
    {
      format: "unix timestamp"
      name: "created_at"
      readOnly: true
      req: false
      short: "The date time when the referenced ID was created."
      type: "`$INTEGER`"
    }
    {
      name: "deduplicate_id"
      readOnly: true
      req: false
      short: "An identifier in the format `id:timestamp` where the id is for the object you're working with (Automations, Deliveries, Exports, Identities, One-time sends, Segments, and Templates), and the timestamp is the last time the object was update…"
      type: "`$STRING`"
    }
    {
      name: "description"
      req: false
      short: "A description of the export."
      type: "`$STRING`"
    }
    {
      name: "downloads"
      req: false
      short: "Counts the total number of times the export has been downloaded."
      type: "`$INTEGER`"
    }
    {
      name: "failed"
      req: false
      short: "If true, the export was unsuccessful."
      type: "`$BOOLEAN`"
    }
    {
      name: "id"
      req: false
      short: "The identifier for the export."
      type: "`$INTEGER`"
    }
    {
      name: "status"
      req: false
      short: "The state of your export where `done` indicates an export that you can download, `pending`, indicates that your export is not ready to download, and `failed` indicates an export that has failed and will not be downloadable."
      type: "`$STRING`"
    }
    {
      name: "total"
      req: false
      short: "The number of entries in the export."
      type: "`$INTEGER`"
    }
    {
      name: "type"
      req: false
      short: "The type of information contained in the export."
      type: "`$STRING`"
    }
    {
      format: "unix timestamp"
      name: "updated_at"
      readOnly: true
      req: false
      short: "The date time when the referenced ID was last updated."
      type: "`$INTEGER`"
    }
    {
      name: "user_email"
      req: false
      short: "The email of the user who created the export."
      type: "`$STRING`"
    }
    {
      name: "user_id"
      req: false
      short: "The user who created the export."
      type: "`$INTEGER`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "export"
  op: {
    create: {
      name: "create"
      points: [
        {
          contract: {
            id: "POST /v1/exports/customers"
            json: "{\"operationId\":\"exportPeopleData\",\"parameters\":[],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"example\":{\"filters\":{\"and\":[{\"segment\":{\"id\":3}},{\"or\":[{\"attribute\":{\"field\":\"interest\",\"operator\":\"eq\",\"value\":\"roadrunners\"}},{\"attribute\":{\"field\":\"state\",\"operator\":\"eq\",\"value\":\"NM\"}},{\"not\":{\"attribute\":{\"field\":\"species\",\"operator\":\"eq\",\"value\":\"roadrunners\"}}}]}]}},\"schema\":{\"properties\":{\"attributes\":{\"description\":\"Recipient attributes you want to include as extra columns in your export.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"filters\":{\"description\":\"Use `and`, `or`, and `not` to combine segment and attribute conditions. The top-level object accepts one property; nest groups for complex filters.\",\"oneOf\":[{\"properties\":{\"and\":{\"description\":\"Match *all* conditions to return results.\",\"items\":{\"properties\":{\"attribute\":{\"description\":\"Filter your audience by attribute.\",\"example\":{\"field\":\"unsubscribed\",\"operator\":\"eq\",\"value\":true},\"properties\":{\"field\":{\"description\":\"The name of the attribute you want to filter against.\",\"example\":\"first_name\",\"type\":\"string\"},\"operator\":{\"description\":\"Determine how to evaluate criteria against the field—`exists` returns results if a person in the audience has the attribute; `eq` returns results if the audience has the attribute and the attribute has the `value` you specify.\",\"enum\":[\"eq\",\"exists\"],\"type\":\"string\"},\"value\":{\"description\":\"The value you want to match for this attribute. You must include a value if you use the `eq` operator.\",\"type\":\"string\"}},\"required\":[\"field\",\"operator\"],\"title\":\"attribute\",\"type\":\"object\"},\"not\":{\"description\":\"Returns results if a condition is false. While and/or support an array of items, `not` supports a single filter object.\",\"oneOf\":[{\"properties\":{\"and\":{\"description\":\"Match *all* conditions to return results.\",\"items\":{\"anyOf\":[{\"description\":\"Filter for people who belong to a segment.\",\"properties\":{\"segment\":{\"description\":\"Provide the `id` of a segment containing people you want to search for.\",\"properties\":{\"id\":{\"description\":\"The ID of the segment you want to return people from.\",\"example\":4,\"type\":\"integer\"}},\"title\":\"segment\",\"type\":\"object\"}},\"title\":\"segment\",\"type\":\"object\"},{\"description\":\"filter for people who have an attribute or an attribute value.\",\"properties\":{\"attribute\":{\"description\":\"Filter your audience by attribute.\",\"example\":{\"field\":\"unsubscribed\",\"operator\":\"eq\",\"value\":true},\"properties\":{\"field\":{\"description\":\"The name of the attribute you want to filter against.\",\"example\":\"first_name\",\"type\":\"string\"},\"operator\":{\"description\":\"Determine how to evaluate criteria against the field—`exists` returns results if a person in the audience has the attribute; `eq` returns results if the audience has the attribute and the attribute has the `value` you specify.\",\"enum\":[\"eq\",\"exists\"],\"type\":\"string\"},\"value\":{\"description\":\"The value you want to match for this attribute. You must include a value if you use the `eq` operator.\",\"type\":\"string\"}},\"required\":[\"field\",\"operator\"],\"title\":\"attribute\",\"type\":\"object\"}},\"title\":\"audience\",\"type\":\"object\"}]},\"type\":\"array\"}},\"title\":\"and\",\"type\":\"object\"},{\"properties\":{\"or\":{\"description\":\"Match *any* condition to return results.\",\"items\":{\"anyOf\":[{\"description\":\"Filter for people who belong to a segment.\",\"properties\":{\"segment\":{\"description\":\"Provide the `id` of a segment containing people you want to search for.\",\"properties\":{\"id\":{\"description\":\"The ID of the segment you want to return people from.\",\"example\":4,\"type\":\"integer\"}},\"title\":\"segment\