            id: "POST /v1/exports/deliveries"
            json: "{\"operationId\":\"exportDeliveriesData\",\"parameters\":[],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"oneOf\":[{\"description\":\"Contains properties shared by export filters.\",\"properties\":{\"attributes\":{\"description\":\"Recipient attributes you want to include as extra columns in your export. You can't include event or trigger properties.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"drafts\":{\"description\":\"If true, your request returns both drafts and active/sent messages.\",\"type\":\"boolean\"},\"end\":{\"description\":\"The unix timestamp representing the end of the export.\",\"example\":1517702400,\"format\":\"unix timestamp\",\"type\":\"integer\"},\"metric\":{\"description\":\"Determines the metric(s) you want to return.\",\"enum\":[\"created\",\"attempted\",\"sent\",\"delivered\",\"opened\",\"clicked\",\"converted\",\"bounced\",\"spammed\",\"unsubscribed\",\"dropped\",\"failed\",\"undeliverable\"],\"type\":\"string\"},\"newsletter_id\":{\"description\":\"The ID of a one-time send you want to export information from.\",\"example\":999,\"type\":\"integer\"},\"start\":{\"description\":\"The unix timestamp representing the beginning of the export.\",\"example\":1517529600,\"format\":\"unix timestamp\",\"type\":\"integer\"},\"template_id\":{\"description\":\"Restrict the export to a specific message template (content) within the selected automation, one-time send, or transactional message.\",\"type\":\"integer\"}},\"required\":[\"newsletter_id\"],\"title\":\"Newsletter\"},{\"description\":\"Contains properties shared by export filters.\",\"properties\":{\"attributes\":{\"description\":\"Recipient attributes you want to include as extra columns in your export. You can't include event or trigger properties.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"campaign_id\":{\"description\":\"The ID of an automation you want to export information from.\",\"example\":46,\"type\":