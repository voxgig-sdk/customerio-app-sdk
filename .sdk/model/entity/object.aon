rator\":\"eq\",\"type_id\":1,\"value\":true},\"properties\":{\"field\":{\"description\":\"The name of the attribute you want to filter against.\",\"example\":\"location\",\"type\":\"string\"},\"operator\":{\"description\":\"Determine how to evaluate criteria against the field—`exists` returns results if an object has the attribute; `eq` returns results an object's attribute exists and the attribute has the `value` you specify.\",\"enum\":[\"eq\",\"exists\"],\"type\":\"string\"},\"type_id\":{\"description\":\"The object type an object belongs to—like \\\"Companies\\\" or \\\"Accounts\\\". Object type IDs are string-formatted integers that begin at `1` and increment for each new type.\",\"example\":\"1\",\"type\":\"string\"},\"value\":{\"description\":\"The value you want to match for this attribute. You must include a value if you use the `eq` operator.\",\"type\":\"string\"}},\"required\":[\"field\",\"operator\",\"type_id\"],\"title\":\"object attribute\",\"type\":\"object\"}},\"type\":\"object\"}},\"title\":\"not\",\"type\":\"object\"},{\"description\":\"A simple filter to find objects matching an attribute condition.\",\"properties\":{\"object_attribute\":{\"description\":\"Filter your objects by their attributes.\",\"example\":{\"field\":\"cancelled\",\"operator\":\"eq\",\"type_id\":1,\"value\":true},\"properties\":{\"field\":{\"description\":\"The name of the attribute you want to filter against.\",\"example\":\"location\",\"type\":\"string\"},\"operator\":{\"description\":\"Determine how to evaluate criteria against the field—`exists` returns results if an object has the attribute; `eq` returns results an object's attribute exists and the attribute has the `value` you specify.\",\"enum\":[\"eq\",\"exists\"],\"type\":\"string\"},\"type_id\":{\"description\":\"The object type an object belongs to—like \\\"Companies\\\" or \\\"Accounts\\\". Object type IDs are string-formatted integers that begin at `1` and increment for each new type.\",\"example\":\"1\",\"type\":\"string\"},\"value\":{\"description\":\"The value you want to match for this attribute. You must include a value if you use the `eq` operator.\",\"type\":\"string\"}},\"required\":[\"field\",\"operator\",\"type_id\"],\"title\":\"object attribute\",\"type\":\"object\"}},\"title\":\"object attribute\",\"type\":\"object\"}],\"title\":\"Object Filter\"},\"object_type_id\":{\"description\":\"The type of object you want to search in. Object type IDs are integers passed as strings.\",\"example\":\"1\",\"type\":\"string\"}},\"required\":[\"object_type_id\",\"filter\"],\"type\":\"object\"}}},\"description\":\"The `object_type_id` you want to search in, and the `filter` you want to apply to find objects. Both are required. The object called `object_attribute` requires `type_id`, as well, which should match the `object_type_id`.\"},\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"identifiers\":{\"items\":{\"properties\":{\"cio_object_id\":{\"description\":\"The canonical, immutable identifier for the object, assigned by Customer.io.\",\"example\":\"ob020101\",\"type\":\"string\"},\"object_id\":{\"description\":\"The ID of the object, assigned by you or your systems.\",\"example\":\"ae3000\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"},\"ids\":{\"description\":\"A list of object IDs matching the object_type_id and filter in the request. Items are the same as the `object_id` values under `identifiers`, but this array may be easier to search/sort through if you have a large number of objects and don't need to to use the `cio_object_id`.\",\"example\":[\"ae3000\"],\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"next\":{\"description\":\"Indicates the next page of results. Add `?start=<next_value>` to the request to get the next page of results.\",\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"Returns arrays of `identifiers` and `ids`.\"},\"401\":{\"description\":\"Unauthorized request. Make sure that