          contract: {
            id: "GET /v1/broadcasts/{broadcast_id}/messages"
            json: "{\"operationId\":\"broadcastMessages\",\"parameters\":[{\"description\":\"The identifier of a broadcast.\",\"in\":\"path\",\"name\":\"broadcast_id\",\"required\":true,\"schema\":{\"type\":\"integer\"}},{\"description\":\"The token for the page of results you want to return. Responses contain a `next` property. Use this property as the `start` value to return the next page of results.\",\"in\":\"query\",\"name\":\"start\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"The maximum number of results you want to retrieve per page.\",\"in\":\"query\",\"name\":\"limit\",\"required\":false,\"schema\":{\"type\":\"integer\"}},{\"description\":\"Determines the metric(s) you want to return.\",\"in\":\"query\",\"name\":\"metric\",\"required\":false,\"schema\":{\"enum\":[\"attempted\",\"sent\",\"delivered\",\"opened\",\"clicked\",\"converted\",\"bounced\",\"spammed\",\"unsubscribed\",\"dropped\",\"failed\",\"undeliverable\"],\"type\":\"string\"}},{\"description\":\"The state of a broadcast.\",\"in\":\"query\",\"name\":\"state\",\"required\":false,\"schema\":{\"enum\":[\"failed\",\"sent\",\"drafted\",\"attempted\"],\"type\":\"string\"}},{\"description\":\"The type of item you want to return metrics for. When empty, the response contains metrics for all possible types.\",\"in\":\"query\",\"name\":\"type\",\"required\":false,\"schema\":{\"enum\":[\"email\",\"webhook\",\"twilio\",\"whatsapp\",\"slack\",\"push\",\"in_app\",\"live_notification\"],\"type\":\"string\"}},{\"description\":\"The beginning timestamp for your query.\",\"in\":\"query\",\"name\":\"start_ts\",\"required\":false,\"schema\":{\"format\":\"unix timestamp\",\"type\":\"integer\"}},{\"description\":\"The ending timestamp for your query.\",\"in\":\"query\",\"name\":\"end_ts\",\"required\":false,\"schema\":{\"format\":\"unix timestamp\",\"type\":\"integer\"}},{\"description\":\"If true, the response includes `tracked_responses` for each message—an object containing tracked response option names for in-app survey responses.\",\"in\":\"query\",\"name\":\"get_tracked_responses\",\"required\":false,\"schema\":{\"default\":false,\"type\":\"boolean\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"examples\":{\"email\":{\"summary\":\"An email message\",\"value\":{\"messages\":[{\"action_id\":196,\"broadcast_id\":94,\"campaign_id\":null,\"content_id\":null,\"created\":1609957805,\"customer_id\":\"1a55d8d1-b13d-4f1f-858f-a93ef21e3a7d\",\"customer_identifiers\":{\"cio_id\":3000001,\"email\":\"person@example.com\",\"id\":\"1a55d8d1-b13d-4f1f-858f-a93ef21e3a7d\"},\"deduplicate_id\":\"dgOq6QWq6QUDAAF22PaOyFVqVxHY3rI5fsg=:1609957872\",\"failure_message\":null,\"forgotten\":false,\"id\":\"dgOq6QWq6QUDAAF22PaOyFVqVxHY3rI5fsg=\",\"metrics\":{\"delivered\":1609957872,\"sent\":1609957832},\"msg_template_id\":0,\"newsletter_id\":null,\"recipient\":\"person@example.com\",\"subject\":\"Did you get that thing I sent you?\",\"type\":\"email\"}]}},\"in-app\":{\"summary\":\"An in-app message with tracked survey responses\",\"value\":{\"messages\":[{\"action_id\":312,\"broadcast_id\":94,\"campaign_id\":null,\"content_id\":null,\"created\":1715769500,\"customer_id\":\"user_2048\",\"customer_identifiers\":{\"cio_id\":\"04000001\",\"id\":\"user_2048\"},\"deduplicate_id\":\"bX2r7YZq8RCAAB5_DGopeWY8nGlEcSGv8fl=:1715769500\",\"failure_message\":null,\"forgotten\":false,\"id\":\"bX2r7YZq8RCAAB5_DGopeWY8nGlEcSGv8fl=\",\"metrics\":{\"opened\":1715769550,\"sent\":1715769500},\"msg_template_id\":87,\"newsletter_id\":null,\"recipient\":\"user_2048\",\"subject\":null,\"tracked_responses\":{\"how-satisfied\":{\"id\":1,\"ts\":1715769560},\"would-recommend\":{\"id\":2,\"ts\":1715769565}},\"type\":\"in_app\"}]}}},\"schema\":{\"properties\":{\"messages\":{\"items\":{\"description\":\"Describes an individual message delivery. The object contains keys for all possible parents of the message (`newsletter_id`, `broadcast_id`, etc) but only the parents of the delivery are populated. Other parent IDs are null.\",\"example\":{\"action_id\":215,\"broadcast_id\":null,\"campaign_id\":23,\"content_id\":null,\"created\":1619137767,\"customer_id\":null,\"deduplicate_id\":\"ag1q6QWq6QUBAAF4_CGoeVX7mFkDbRFu7ek=:1619137768\",\"failure_message\":null,\"forgotten\":false,\"id\":\"ag1q6QWq6QUBAAF4_CGoeVX7mFkDbRFu7ek=\",\"metrics\":{\"delivered\":1619137768,\"sent\":1619137768},\"msg_template_id\":43,\"newsletter_id\":null,\"parent_action_id\":null,\"recipient\":\"person@example.com\",\"subject\":\"Did you get that thing I sent you?\",\"trigger_event_id\":null,\"type\":\"email\"},\"properties\":{\"action_id\":{\"description\":\"The identifier for an action.\",\"example\":96,\"readOnly\":true,\"type\":\"integer\"},\"broadcast_id\":{\"oneOf\":[{\"description\":\"The identifier for a broadcast.\",\"example\":2,\"type\":\"integer\"},{\"type\":\"null\"}]},\"campaign_id\":{\"oneOf\":[{\"description\":\"The identifier for an automation.\",\"example\":5,\"type\":\"integer\"},{\"type\":\"null\"}]},\"content_id\":{\"description\":\"The identifier for a message in a one-time send. One-time sends can have multiple content IDs (for multi-language messages or A/B tests).\",\"example\":1,\"readOnly\":true,\"type\":\"integer\"},\"created\":{\"description\":\"The date time when the referenced ID was created.\",\"example\":1552341937,\"format\":\"unix timestamp\",\"readOnly\":true,\"type\":\"integer\"},\"customer_id\":{\"description\":\"The ID of a customer profile, analogous to a \\\"person\\\" in the UI. If your workspace supports multiple identifiers (email and ID), this value can be null.\",\"example\":\"42\",\"type\":[\"string\",\"null\"]},\"customer_identifiers\":{\"description\":\"Identifiers for the person in a response—`id`, `cio_id`, and `email`. Unset `id` or `email` values are `null`. We recommend this object over the less descriptive `customer_id`. This object doesn't include `phone`, even if your workspace uses phone numbers as an identifier; look for the person's `phone` attribute instead.\",\"properties\":{\"cio_id\":{\"description\":\"A unique identifier set by Customer.io, used to reference a person if you want to update their identifiers.\",\"example\":\"a3000001\",\"type\":\"string\"},\"email\":{\"description\":\"A person's email address, if set.\",\"example\":\"test@example.com\",\"format\":\"email\",\"type\":[\"string\",\"null\"]},\"id\":{\"description\":\"A person's unique ID, if set. This is the same as the `customer_id` if present.\",\"example\":2,\"type\":[\"string\",\"null\"]}},\"required\":[\"email\",\"id\",\"cio_id\"],\"type\":\"object\"},\"deduplicate_id\":{\"description\":\"An identifier in the format `id:timestamp` where the id is for the object you're working with (Automations, Deliveries, Exports, Identities, One-time sends, Segments, and Templates), and the timestamp is the last time the object was updated.\",\"example\":\"15:1492548073\",\"readOnly\":true,\"type\":\"string\"},\"failure_message\":{\"description\":\"Explains why a message failed, if applicable.\",\"type\":[\"string\",\"null\"]},\"forgotten\":{\"description\":\"If true message contents are not retained by Customer.io.\",\"type\":\"boolean\"},\"id\":{\"description\":\"The identifier for a delivery—the instance of a message intended for an individual recipient.\",\"example\":\"dgOq6QWq6QUBAAF4_CGoeVX7mFkDbRFu7ek=\",\"readOnly\":true,\"type\":\"string\"},\"message_template_id\":{\"deprecated\":true,\"description\":\"The identifier of the message template used to create a message.\",\"readOnly\":true,\"type\":\"integer\"},\"metrics\":{\"description\":\"Metrics for an individual instance of a message; each item in the object represents the timestamp when a message achieved a particular metric. This object only contains metrics that have been recorded.\",\"properties\":{\"bounced\":{\"description\":\"The timestamp when the message `bounced`.\",\"type\":\"integer\"},\"clicked\":{\"description\":\"The timestamp when the message was `clicked`.\",\"type\":\"integer\"},\"converted\":{\"description\":\"The timestamp when the message was `converted`.\",\"type\":\"integer\"},\"created\":{\"description\":\"The timestamp when the message was `created`.\",\"type\":\"integer\"},\"delivered\":{\"description\":\"The timestamp when the message was `delivered`.\",\"type\":\"integer\"},\"drafted\":{\"description\":\"The timestamp when the message was `drafted`.\",\"type\":\"integer\"},\"dropped\":{\"description\":\"The timestamp when the message was `dropped`.\",\"type\":\"integer\"},\"failed\":{\"description\":\"The timestamp when the message `failed`.\",\"type\":\"integer\"},\"human_clicked\":{\"description\":\"The number of `clicked` messages excluding machine clicks. This metric is reliable starting April 20, 2025. [Learn more](/messaging/metrics/analytics/#delivery-metrics).\",\"type\":\"integer\"},\"human_opened\":{\"description\":\"The number of `opened` messages excluding machine opens. This metric is reliable starting March 20, 2025. [Learn more](/messaging/metrics/analytics/#delivery-metrics).\",\"type\":\"integer\"},\"opened\":{\"description\":\"The timestamp when the message was `opened`.\",\"type\":\"integer\"},\"prefetch_clicked\":{\"description\":\"The number of `clicked` messages attributed to machines. This metric is reliable starting April 20, 2025.\",\"type\":\"integer\"},\"prefetch_opened\":{\"description\":\"The number of `opened` messages attributed to machines. This metric is reliable starting March 20, 2025.\",\"type\":\"integer\"},\"sent\":{\"description\":\"The timestamp when the message was `sent`.\",\"type\":\"integer\"},\"spammed\":{\"description\":\"The timestamp when the message was marked as spam.\",\"type\":\"integer\"},\"undeliverable\":{\"description\":\"The timestamp when the message became `undeliverable`.\",\"type\":\"integer\"},\"unsubscribed\":{\"description\":\"The timestamp when a person unsubscribed based on this message.\",\"type\":\"integer\"}},\"type\":\"object\"},\"newsletter_id\":{\"oneOf\":[{\"description\":\"The identifier for a one-time send.\",\"example\":10,\"type\":\"integer\"},{\"type\":\"null\"}]},\"parent_action_id\":{\"description\":\"The ID of the parent action, if the action occurred within an automation and has a parent (like a randomized split, etc).\",\"example\":1,\"readOnly\":true,\"type\":\"integer\"},\"recipient\":{\"description\":\"The recipient address for an action.\",\"example\":\"{{customer.email}}\",\"type\":\"string\"},\"subject\":{\"description\":\"The subject line for an `email` action.\",\"example\":\"Did you get that thing I sent you?\",\"type\":\"string\"},\"tracked_responses\":{\"additionalProperties\":{\"properties\":{\"id\":{\"description\":\"The identifier for the tracked response.\",\"type\":\"integer\"},\"ts\":{\"description\":\"A unix timestamp representing when the response was tracked.\",\"type\":\"integer\"}},\"type\":\"object\"},\"description\":\"Tracked in-app survey responses, keyed by response option name. Present only when `get_tracked_responses` is `true`.\",\"example\":{\"cool-button\":{\"id\":1,\"ts\":1715769600},\"cool-button-2\":{\"id\":2,\"ts\":1715769600}},\"type\":\"object\"},\"trigger_event_id\":{\"description\":\"The id of the event that triggered an event-triggered automation (not an API-triggered broadcast).\",\"example\":\"21E4C3CT6YDC7Y4N7FE1GWWABC\",\"type\":\"string\"},\"type\":{\"description\":\"The type of message or action for a delivery, automation action, or related object. Includes channels that one-time sends do not support (for example, `slack` and `whatsapp`).\",\"enum\":[\"email\",\"webhook\",\"twilio\",\"push\",\"in_app\",\"slack\",\"whatsapp\",\"live_notification\"],\"example\":\"email\",\"readOnly\":true,\"type\":\"string\"}}},\"type\":\"array\"}},\"type\":\"object\"}}},\"description\":\"Returns an array of `messages`. Each object represents a different message in your broadcast.\"},\"400\":{\"description\":\"The `broadcastID`, `actionID` or `triggerID` is invalid.\"},\"404\":{\"description\":\"The broadcast, action, and/or trigger do not exist.\"},\"429\":{\"content\":{\"application/json\":{\"example\":{\"errors\":[{\"detail\":\"rate limited to 10 requests per 1s (reference a1b2c3)\",\"status\":\"429\"}]},\"schema\":{\"description\":\"An array/list of failures where each entry is a separate failure reason.\",\"properties\":{\"errors\":{\"description\":\"One entry for each reason the request failed.\",\"items\":{\"properties\":{\"code\":{\"description\":\"A stable identifier for the failure, on the errors that carry one. Use this rather than the text in `detail` if you need to identify the error programmatically.\",\"example\":\"invalid_credentials\",\"type\":\"string\"},\"detail\":{\"description\":\"What went wrong, in plain text. Most messages end with a support reference you can use if you need to contact support.\",\"example\":\"bad request (reference a1b2c3)\",\"type\":\"string\"},\"meta\":{\"additionalProperties\":true,\"description\":\"Extra context (if available).\",\"type\":\"object\"},\"source\":{\"description\":\"The part of the request that the error refers to.\",\"properties\":{\"pointer\":{\"description\":\"A JSON pointer to the part of the request body that the error refers to.\",\"example\":\"/data/attributes/email\",\"type\":\"string\"}},\"type\":\"object\"},\"status\":{\"description\":\"The HTTP status code as a string.\",\"example\":\"400\",\"type\":\"string\"}},\"required\":[\"detail\",\"status\"],\"type\":\"object\"},\"type\":\"array\"}},\"required\":[\"errors\"],\"type\":\"object\"}}},\"description\":\"Your request is over the 10-per-second limit. `Retry-After` tells you how many seconds you must wait before you send the next request.\",\"headers\":{\"Retry-After\":{\"description\":\"How many seconds you must wait before you send another request. This header is present when you are rate limited by a per-second limit. If you hit a daily quota, this header is not set.\",\"schema\":{\"example\":1,\"minimum\":1,\"type\":\"integer\"}}}}},\"security\":[{\"Bearer-Auth\":[]}],\"securitySchemes\":{\"Bearer-Auth\":{\"description\":\"The App API uses a bearer authentication scheme.\\n\\nYou can generate a bearer token, known as an **App API Key**, with a defined scope in [your account settings](https://fly.customer.io/settings/api_credentials?keyType=app). [Learn more about bearer authorization in Customer.io](/accounts/settings/managing-credentials).\\n\",\"scheme\":\"bearer\",\"type\":\"http\"},\"ServiceAccount-Auth\":{\"bearerFormat\":\"sa_live_\",\"description\":\"Transactional send endpoints (`/v1/send/email`, `/v1/send/push`, `/v1/send/sms`, `/v1/send/whatsapp`, `/v1/send/in_app`, `/v1/send/inbox_message`) also accept a service-account bearer token, prefixed with `sa_live_`. Service-account tokens work across workspaces, so you must pass the target workspace as the `X-Workspace-Id` header on each request.\\n\\nService-account tokens are intended for testing and one-off sends—for example, using the Customer.io CLI with an AI agent like Claude to verify that a transactional message renders correctly before wiring it into your production backend. **For the production integration that triggers the message from your application, use an App API Key instead**: it's workspace-scoped, easier to rotate, and has a smaller blast radius.\\n\\nService-account tokens are server-side credentials. Treat them like any API key—keep them in environment variables or a secret manager, and never embed them in client-side code, mobile apps, or other untrusted contexts.\\n\",\"scheme\":\"bearer\",\"type\":\"http\"},\"bearerAuth\":{\"description\":\"API key passed as a Bearer token\",\"scheme\":\"bearer\",\"type\":\"http\"}},\"securitySource\":\"operation\"}"
            source: "openapi3"
            version: 1
          }
          method: "GET"
          orig: "/v1/broadcasts/{broadcast_id}/messages"
          rename: {
            param: {
              broadcast_id: "id"
            }
          }
          segments: [
            {
              lit: "v1"
            }
            {
              lit: "broadcasts"
            }
            {
              var: "id"
            }
            {
              lit: "messages"
            }
          ]
          select: {
            "$action": "message"
            exist: [
              "end_t"
              "get_tracked_response"
              "id"
              "limit"
              "metric"
              "start"
              "start_t"
              "state"
              "type"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.messages`"
          }
        }
        {
          args: {
            params: [
              {
                kind: "param"
                name: "action_id"
                orig: "action_id"
                reqd: true
                type: "`$INTEGER`"
              }
              {
                kind: "param"
                name: "id"
                orig: "broadcast_id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
            query: [
              {
                example: "days"
                kind: "query"
                name: "period"
                orig: "period"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "step"
                orig: "step"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "type"
                orig: "type"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "GET /v1/broadcasts/{broadcast_id}/actions/{action_id}/metrics/links"
            json: "{\"operationId\":\"broadcastActionLinks\",\"parameters\":[{\"description\":\"The identifier of a broadcast.\",\"in\":\"path\",\"name\":\"broadcast_id\",\"required\":true,\"schema\":{\"type\":\"integer\"}},{\"description\":\"The action you want to lookup or act on.\",\"in\":\"path\",\"name\":\"action_id\",\"required\":true,\"schema\":{\"type\":\"integer\"}},{\"description\":\"The unit of time for your report.\",\"in\":\"query\",\"name\":\"period\",\"required\":false,\"schema\":{\"default\":\"days\",\"enum\":[\"hours\",\"days\",\"weeks\",\"months\"],\"type\":\"string\"}},{\"description\":\"The number of periods you want to return. Defaults to the maximum available, or `12` if the period is in `months`. Maximums are 24 hours, 45 days, 12 weeks, or 121 months. Days start at 00:00 EST. Weeks start at 00:00 EST on Sunday. Months start at 00:00 EST on the 1st of the month.\",\"in\":\"query\",\"name\":\"steps\",\"required\":false,\"schema\":{\"type\":\"integer\"}},{\"description\":\"The type of item you want to return metrics for. When empty, the response contains metrics for all possible types.\",\"in\":\"query\",\"name\":\"type\",\"required\":false,\"schema\":{\"enum\":[\"email\",\"webhook\",\"twilio\",\"whatsapp\",\"slack\",\"push\",\"in_app\",\"live_notification\"],\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"links\":{\"description\":\"Each object in the array represents a link in your broadcast variant.\",\"items\":{\"properties\":{\"link\":{\"properties\":{\"href\":{\"description\":\"The link destination—a URL, mailto, etc.\",\"example\":\"https://docs.customer.io\",\"type\":\"string\"},\"id\":{\"description\":\"The ID of the link.\",\"example\":1234,\"type\":\"integer\"}},\"type\":\"object\"},\"metric\":{\"description\":\"Contains metrics for the link.\",\"properties\":{\"series\":{\"properties\":{\"clicked\":{\"description\":\"An array of results from oldest to newest, where each result indicates a period.\",\"example\":[1,3,5,7],\"items\":{\"type\":\"integer\"},\"type\":\"array\"},\"human_clicked\":{\"description\":\"An array of human click counts (clicks excluding machine clicks) from oldest to newest, where each result indicates a period. This metric is reliable starting April 20, 2025. [Learn more](/messaging/metrics/analytics/#delivery-metrics).\",\"example\":[1,2,3,4],\"items\":{\"type\":\"integer\"},\"type\":\"array\"},\"machine_clicked\":{\"description\":\"An array of machine click counts (clicks attributed to bots or prefetching) from oldest to newest, where each result indicates a period. This metric is reliable starting April 20, 2025. [Learn more](/messaging/metrics/analytics/#delivery-metrics).\",\"example\":[0,1,1,2],\"items\":{\"type\":\"integer\"},\"type\":\"array\"}},\"type\":\"object\"}},\"type\":\"object\"}},\"type\":\"object\"},\"type\":\"array\"}},\"type\":\"object\"}}},\"description\":\"Returns broadcast variant metrics by `series` (with increments are based on the `period` and `step` in your request) for the broadcast.\"},\"400\":{\"description\":\"The `broadcastID`, `actionID` or `triggerID` is invalid.\"},\"404\":{\"description\":\"The broadcast, action, and/or trigger do not exist.\"},\"429\":{\"content\":{\"application/json\":{\"example\":{\"errors\":[{\"detail\":\"rate limited to 10 requests per 1s (reference a1b2c3)\",\"status\":\"429\"}]},\"schema\":{\"description\":\"An array/list of failures where each entry is a separate failure reason.\",\"properties\":{\"errors\":{\"description\":\"One entry for each reason the request failed.\",\"items\":{\"properties\":{\"code\":{\"description\":\"A stable identifier for the failure, on the errors that carry one. Use this rather than the text in `detail` if you need to identify the error programmatically.\",\"example\":\"invalid_credentials\",\"type\":\"string\"},\"detail\":{\"description\":\"What went wrong, in plain text. Most messages end with a support reference you can use if you need to contact support.\",\"example\":\"bad request (reference a1b2c3)\",\"type\":\"string\"},\"meta\":{\"additionalProperties\":true,\"description\":\"Extra context (if available).\",\"type\":\"object\"},\"source\":{\"description\":\"The part of the request that the error refers to.\",\"properties\":{\"pointer\":{\"description\":\"A JSON pointer to the part of the request body that the error refers to.\",\"example\":\"/data/attributes/email\",\"type\":\"string\"}},\"type\":\"object\"},\"status\":{\"description\":\"The HTTP status code as a string.\",\"example\":\"400\",\"type\":\"string\"}},\"required\":[\"detail\",\"status\"],\"type\":\"object\"},\"type\":\"array\"}},\"required\":[\"errors\"],\"type\":\"object\"}}},\"description\":\"Your request is over the 10-per-second limit. `Retry-After` tells you how many seconds you must wait before you send the next request.\",\"headers\":{\"Retry-After\":{\"description\":\"How many seconds you must wait before you send another request. This header is present when you are rate limited by a per-second limit. If you hit a daily quota, this header is not set.\",\"schema\":{\"example\":1,\"minimum\":1,\"type\":\"integer\"}}}}},\"security\":[{\"Bearer-Auth\":[]}],\"securitySchemes\":{\"Bearer-Auth\":{\"description\":\"The App API uses a bearer authentication scheme.\\n\\nYou can generate a bearer token, known as an **App API Key**, with a defined scope in [your account settings](https://fly.customer.io/settings/api_credentials?keyType=app). [Learn more about bearer authorization in Customer.io](/accounts/settings/managing-credentials).\\n\",\"scheme\":\"bearer\",\"type\":\"http\"},\"ServiceAccount-Auth\":{\"bearerFormat\":\"sa_live_\",\"description\":\"Transactional send endpoints (`/v1/send/email`, `/v1/send/push`, `/v1/send/sms`, `/v1/send/whatsapp`, `/v1/send/in_app`, `/v1/send/inbox_message`) also accept a service-account bearer token, prefixed with `sa_live_`. Service-account tokens work across workspaces, so you must pass the target workspace as the `X-Workspace-Id` header on each request.\\n\\nService-account tokens are intended for testing and one-off sends—for example, using the Customer.io CLI with an AI agent like Claude to verify that a transactional message renders correctly before wiring it into your production backend. **For the production integration that triggers the message from your application, use an App API Key instead**: it's workspace-scoped, easier to rotate, and has a smaller blast radius.\\n\\nService-account tokens are server-side credentials. Treat them like any API key—keep them in environment variables or a secret manager, and never embed them in client-side code, mobile apps, or other untrusted contexts.\\n\",\"scheme\":\"bearer\",\"type\":\"http\"},\"bearerAuth\":{\"description\":\"API key passed as a Bearer token\",\"scheme\":\"bearer\",\"type\":\"http\"}},\"securitySource\":\"operation\"}"
