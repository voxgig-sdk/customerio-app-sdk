            id: "GET /v1/broadcasts/{broadcast_id}/actions"
            json: "{\"operationId\":\"broadcastActions\",\"parameters\":[{\"description\":\"The identifier of a broadcast.\",\"in\":\"path\",\"name\":\"broadcast_id\",\"required\":true,\"schema\":{\"type\":\"integer\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"actions\":{\"items\":{\"oneOf\":[{\"properties\":{\"bcc\":{\"description\":\"The blind-copy address(es) for this action.\",\"readOnly\":true,\"type\":\"string\"},\"body\":{\"description\":\"The body of the action. You cannot modify the body if you created it with our drag-and-drop editor.\",\"type\":\"string\"},\"body_amp\":{\"description\":\"AMP-enabled content for your email. If a recipient's email client doesn't support AMP, they receive your `body` content instead. Make sure you're [set up to send AMP](/journeys/channels/email/layouts/amp-for-email/) first.\",\"type\":\"string\"},\"broadcast_id\":{\"description\":\"The identifier for a broadcast.\",\"example\":2,\"type\":\"integer\"},\"cc\":{\"description\":\"The carbon-copy address(es) for this action.\",\"readOnly\":true,\"type\":\"string\"},\"created\":{\"description\":\"The date time when the referenced ID was created.\",\"example\":1552341937,\"format\":\"unix timestamp\",\"readOnly\":true,\"type\":\"integer\"},\"deduplicate_id\":{\"description\":\"An identifier in the format `id:timestamp` where the id is for the object you're working with (Automations, Deliveries, Exports, Identities, One-time sends, Segments, and Templates), and the timestamp is the last time the object was updated.\",\"example\":\"15:1492548073\",\"readOnly\":true,\"type\":\"string\"},\"fake_bcc\":{\"description\":\"If true, rather than sending true copies to BCC addresses, Customer.io sends a copy of the message with the subject line containing the recipient address(es).\\n\",\"readOnly\":true,\"type\":\"boolean\"},\"from\":{\"description\":\"The address that the message is from, relevant if the action `type` is `email`.\",\"example\":\"sentFrom@example.com\",\"readOnly\":true,\"type\":\"string\"},\"from_id\":{\"description\":\"The identifier of the `from` address, commonly known as the \\\"sender\\\". Use [List sender identities](/integrations/api/app/tag/sender-identities/listSenders/) to find valid IDs.\",\"example\":1,\"type\":\"integer\"},\"headers\":{\"description\":\"A JSON string containing header objects with `name` and `value`. Names and values must be strings, with no non-ASCII characters or spaces. You can't overwrite reserved headers.\",\"example\":\"[{\\\"name\\\":\\\"X-Mailgun-Tag\\\",\\\"value\\\":\\\"my-cool-tag\\\"},{\\\"name\\\":\\\"X-Custom-Header\\\",\\\"value\\\":\\\"custom-value\\\"}]\",\"format\":\"json\",\"type\":\"string\"},\"id\":{\"description\":\"The identifier for an action.\",\"example\":96,\"readOnly\":true,\"type\":\"integer\"},\"language\":{\"description\":\"The language variant for your message. If you don't use our [localization feature](/journeys/channels/localization/getting-started), or this is the default message, this value is an empty string.\",\"example\":\"fr\",\"readOnly\":true,\"type\":\"string\"},\"layout\":{\"description\":\"The layout used for the action, if it exists.\",\"readOnly\":true,\"type\":\"string\"},\"name\":{\"description\":\"The name of the action, if it exists.\",\"example\":\"Opening Message\",\"readOnly\":true,\"type\":\"string\"},\"preheader_text\":{\"description\":\"[Also known as \\\"preview text\\\"](/journeys/channels/email/headers/custom-preheader-text/), this is the small block of text shown in an email inbox next to or underneath the subject line.\\n\",\"type\":\"string\"},\"preprocessor\":{\"description\":\"If CSS pre-processing is enabled, this key is populated with `premailer`. Note, Juice replaced Premailer as the pre-processor, but you will only see `premailer` as the value.\",\"enum\":[\"premailer\"],\"readOnly\":true,\"type\":\"string\"},\"recipient\":{\"description\":\"The recipient address for an action.\",\"example\":\"{{customer.email}}\",\"type\":\"string\"},\"reply_to\":{\"description\":\"The address that receives replies for the message, if applicable.\",\"example\":\"replyto@example.com\",\"readOnly\":true,\"type\":\"string\"},\"reply_to_id\":{\"description\":\"The identifier for the `reply_to` address, if applicable. Use [List sender identities](/integrations/api/app/tag/sender-identities/listSenders/) to find valid IDs.\",\"example\":38,\"type\":[\"integer\",\"null\"]},\"sending_state\":{\"description\":\"Determines the sending behavior for the action. `automatic` sends the action automatically when triggered; `draft` queues drafts when the action is triggered; or `off` to disable the action.\",\"enum\":[\"automatic\",\"draft\",\"off\"],\"type\":\"string\"},\"subject\":{\"description\":\"The subject line for an `email` action.\",\"example\":\"Did you get that thing I sent you?\",\"type\":\"string\"},\"type\":{\"description\":\"The type of action.\",\"enum\":[\"email\",\"in_app\",\"push\",\"twilio\",\"slack\",\"whatsapp\"],\"readOnly\":true,\"type\":\"string\"},\"updated\":{\"description\":\"The date time when the referenced ID was last updated.\",\"example\":1552341937,\"format\":\"unix timestamp\",\"readOnly\":true,\"type\":\"integer\"}},\"title\":\"Email / message\"},{\"properties\":{\"body\":{\"description\":\"The body of your SMS.\",\"type\":\"string\"},\"broadcast_id\":{\"description\":\"The identifier for a broadcast.\",\"example\":2,\"type\":\"integer\"},\"created\":{\"description\":\"The date time when the referenced ID was created.\",\"example\":1552341937,\"format\":\"unix timestamp\",\"readOnly\":true,\"type\":\"integer\"},\"deduplicate_id\":{\"description\":\"An identifier in the format `id:timestamp` where the id is for the object you're working with (Automations, Deliveries, Exports, Identities, One-time sends, Segments, and Templates), and the timestamp is the last time the object was updated.\",\"example\":\"15:1492548073\",\"re