    update: {
      name: "update"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "action_id"
                orig: "action_id"
                reqd: true
                type: "`$INTEGER`"
              }
              {
                kind: "param"
                name: "id"
                orig: "broadcast_id"
                reqd: true
                type: "`$INTEGER`"
              }
              {
                kind: "param"
                name: "language"
                orig: "language"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "PUT /v1/broadcasts/{broadcast_id}/actions/{action_id}/language/{language}"
            json: "{\"operationId\":\"updateBroadcastActionLanguage\",\"parameters\":[{\"description\":\"The identifier of a broadcast.\",\"in\":\"path\",\"name\":\"broadcast_id\",\"required\":true,\"schema\":{\"type\":\"integer\"}},{\"description\":\"The action you want to lookup or act on.\",\"in\":\"path\",\"name\":\"action_id\",\"required\":true,\"schema\":{\"type\":\"integer\"}},{\"description\":\"A [language tag](/journeys/channels/subscriptions/unsubscribe-faqs/#currently-supported-languages) of a language variant. If you don't provide a language (an empty string), we'll use your default language. If the language variant does not exist, we'll return an error.\",\"in\":\"path\",\"name\":\"language\",\"required\":true,\"schema\":{\"type\":\"string\"}}],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"oneOf\":[{\"properties\":{\"bcc\":{\"description\":\"The blind-copy address(es) for this action.\",\"readOnly\":true,\"type\":\"string\"},\"body\":{\"description\":\"The body of the action. You cannot modify the body if you created it with our drag-and-drop editor.\",\"type\":\"string\"},\"body_amp\":{\"description\":\"AMP-enabled content for your email. If a recipient's email client doesn't support AMP, they receive your `body` content instead. Make sure you're [set up to send AMP](/journeys/channels/email/layouts/amp-for-email/) first.\",\"type\":\"string\"},\"broadcast_id\":{\"description\":\"The identifier for a broadcast.\",\"example\":2,\"type\":\"integer\"},\"cc\":{\"description\":\"The carbon-copy address(es) for this action.\",\"readOnly\":true,\"type\":\"string\"},\"created\":{\"description\":\"The date time when the referenced ID was created.\",\"example\":1552341937,\"format\":\"unix timestamp\",\"readOnly\":true,\"type\":\"integer\"},\"deduplicate_id\":{\"description\":\"An identifier in the format `id:timestamp` where the id is for the object you're working with (Automations, Deliveries, Exports, Identities, One-time sends, Segments, and Templates), and the timestamp is the last time the object was updated.\",\"example\":\"15:1492548073\",\"readOnly\":true,\"type\":\"string\"},\"fake_bcc\":{\"description\":\"If true, rather than sending true copies to BCC addresses, Customer.io sends a copy of the message with the subject line containing the recipient address(es).\\n\",\"readOnly\":true,\"type\":\"boolean\"},\"from\":{\"description\":\"The address that the message is from, relevant if the action `type` is `email`.\",\"example\":\"sentFrom@example.com\",\"readOnly\":true,\"type\":\"string\"},\"from_id\":{\"description\":\"The identifier of the `from` address, commonly known as the \\\"sender\\\". Use [List sender identities](/integrations/api/app/tag/sender-identities/listSenders/) to find valid IDs.\",\"example\":1,\"type\":\"integer\"},\"headers\":{\"description\":\"Headers you want to add or update. Names and values must be strings, with no non-ASCII characters or spaces. You can't overwrite reserved headers.\",\"items\":{\"example\":[{\"name\":\"X-Mailgun-Tag\",\"value\":\"my-cool-tag\"}],\"properties\":{\"name\":{\"description\":\"The name of the header.\",\"type\":\"string\"},\"value\":{\"description\":\"The value of the header.\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"},\"id\":{\"description\":\"The identifier for an action.\",\"example\":96,\"readOnly\":true,\"type\":\"integer\"},\"language\":{\"description\":\"The language variant for your message. If you don't use our [localization feature](/journeys/channels/localization/getting-started), or this is the default message, this value is an empty string.\",\"example\":\"fr\",\"readOnly\":true,\"type\":\"string\"},\"layout\":{\"description\":\"The layout used for the action, if it exists.\",\"readOnly\":true,\"type\":\"string\"},\"name\":{\"description\":\"The name of the action, if it exists.\",\"example\":\"Opening Message\",\"readOnly\":true,\"type\":\"string\"},\"preheader_text\":{\"description\":\"[Also known as \\\"preview text\\\"](/journeys/channels/email/headers/custom-preheader-text/), this is the small block of text shown in an email inbox next to or underneath the subject line.\\n\",\"type\":\"string\"},\"preprocessor\":{\"description\":\"If CSS pre-processing is enabled, this key is populated with `premailer`. Note, Juice replaced Premailer as the pre-processor, but you will only see `premailer` as the value.\",\"enum\":[\"premailer\"],\"readOnly\":true,\"type\":\"string\"},\"recipient\":{\"description\":\"The recipient address for an action.\",\"example\":\"{{customer.email}}\",\"type\":\"string\"},\"reply_to\":{\"description\":\"The address that receives replies for the message, if applicable.\",\"example\":\"replyto@example.com\",\"readOnly\":true,\"type\":\"string\"},\"reply_to_id\":{\"description\":\"The identifier for the `reply_to` address, if applicable. Use [List sender identities](/integrations/api/app/tag/sender-identities/listSenders/) to find valid IDs.\",\"example\":38,\"type\":[\"integer\",\"null\"]},\"sending_state\":{\"description\":\"Determines the sending behavior for the action. `automatic` sends the action automatically when triggered; `draft` queues drafts when the action is triggered; or `off` to disable the action.\",\"enum\":[\"automatic\",\"draft\",\"off\"],\"type\":\"string\"},\"subject\":{\"description\":\"The subject line for an `email` action.\",\"example\":\"Did you get that thing I sent you?\",\"type\":\"string\"},\"type\":{\"description\":\"The type of action.\",\"enum\":[\"email\",\"in_app\",\"push\",\"twilio\",\"slack\",\"whatsapp\"],\"readOnly\":true,\"type\":\"string\"},\"updated\":{\"description\":\"The date time when the referenced ID was last updated.\",\"example\":1552341937,\"format\":\"unix timestamp\",\"readOnly\":true,\"type\":\"integer\"}},\"title\":\"Email / message\"},{\"properties\":{\"body\":{\"description\":\"The body of your SMS.\",\"type\":\"string\"},\"broadcast_id\":{\"description\":\"The identifier for a broadcast.\",\"example\":2,\"type\":\"integer\"},\"created\":{\"description\":\"The date time when the referenced ID was created.\",\"example\":1552341937,\"format\":\"unix timestamp\",\"readOnly\":true,\"type\":\"integer\"},\"deduplicate_id\":{\"description\":\"An identifier in the format `id:timestamp` where the id is for the object you're working with (Automations, Deliveries, Exports, Identities, One-time sends, Segments, and Templates), and the timestamp is the last time the object was updated.\",\"example\":\"15:1492548073\",\"readOnly\":true,\"type\":\"string\"},\"id\":{\"description\":\"The identifier for an action.\",\"example\":96,\"readOnly\":true,\"type\":\"integer\"},\"image_url\":{\"description\":\"The URL of the image in your SMS (MMS) message.\",\"type\":\"string\"},\"language\":{\"description\":\"The language variant for your message. If you don't use our [localization feature](/journeys/channels/localization/getting-started), or this is the default message, this value is an empty string.\",\"example\":\"fr\",\"readOnly\":true,\"type\":\"string\"},\"layout\":{\"description\":\"The layout used for the action, if it exists.\",\"readOnly\":true,\"type\":\"string\"},\"name\":{\"description\":\"The name of the action.\",\"example\":\"Opening Message\",\"readOnly\":true,\"type\":\"string\"},\"recipient\":{\"description\":\"The recipient, usually an attribute you reference with Liquid like `{{customer.phone}}`. If you use Liquid, this field is blank in `GET` responses because we resolve the recipient at send time.\",\"example\":\"\",\"type\":\"string\"},\"sending_state\":{\"description\":\"Determines the sending behavior for the action. `automatic` sends the action automatically when triggered; `draft` queues drafts when the action is triggered; or `off` to disable the action.\",\"enum\":[\"automatic\",\"draft\",\"off\"],\"type\":\"string\"},\"type\":{\"description\":\"For SMS/MMS messages, the `type` is always `twilio`.\",\"enum\":[\"twilio\"],\"readOnly\":true,\"type\":\"string\"},\"updated\":{\"description\":\"The date time when the referenced ID was last updated.\",\"example\":1552341937,\"format\":\"unix timestamp\",\"readOnly\":true,\"type\":\"integer\"}},\"title\":\"SMS / MMS\"},{\"description\":\"The action object for WhatsApp messages sent from Customer.io using your Facebook Business Account (not Twilio). Messages sent through Twilio still use the `twilio` type and are treated similarly to SMS messages.\",\"properties\":{\"body\":{\"description\":\"A JSON string containing WhatsApp template metadata from Meta and template parameters with Liquid variables. Use `GET /v1/environments/{environment_id}/whatsapp/templates` to list templates.\",\"example\":\"{\\\"body\\\":\\\"\\\",\\\"image_url\\\":\\\"\\\",\\\"whatsapp_message_template\\\":{\\\"id\\\":\\\"12345\\\",\\\"name\\\":\\\"welcome\\\",\\\"language\\\":\\\"en_US\\\",\\\"status\\\":\\\"APPROVED\\\",\\\"components\\\":[...]},\\\"template_parameters\\\":{\\\"name\\\":\\\"welcome\\\",\\\"components\\\":[{\\\"type\\\":\\\"BODY\\\",\\\"parameters\\\":[{\\\"type\\\":\\\"text\\\",\\\"text\\\":\\\"{{customer.name}}\\\",\\\"parameter_name\\\":\\\"name\\\"}]}]}}\",\"type\":\"string\"},\"body_json\":{\"description\":\"For visual editor content (if applicable).\",\"type\":\"string\"},\"broadcast_id\":{\"description\":\"The identifier for a broadcast.\",\"example\":2,\"type\":\"integer\"},\"created\":{\"description\":\"The date time when the referenced ID was created.\",\"example\":1552341937,\"format\":\"unix timestamp\",\"readOnly\":true,\"type\":\"integer\"},\"deduplicate_id\":{\"description\":\"An identifier in the format `id:timestamp` where the id is for the object you're working with (Automations, Deliveries, Exports, Identities, One-time sends, Segments, and Templates), and the timestamp is the last time the object was updated.\",\"example\":\"15:1492548073\",\"readOnly\":true,\"type\":\"string\"},\"id\":{\"description\":\"The identifier for an action.\",\"example\":96,\"readOnly\":true,\"type\":\"integer\"},\"language\":{\"description\":\"The language variant for your message. If you don't use our [localization feature](/journeys/channels/localization/getting-started), or this is the default message, this value is an empty string.\",\"example\":\"fr\",\"readOnly\":true,\"type\":\"string\"},\"name\":{\"description\":\"The name of the action.\",\"example\":\"Welcome Message\",\"readOnly\":true,\"type\":\"string\"},\"recipient\":{\"description\":\"The recipient's phone number in E.164 format, usually referenced with Liquid like `{{customer.phone}}`. If you use Liquid, this field is blank in `GET` responses because we resolve the recipient at send time.\",\"example\":\"\",\"type\":\"string\"},\"send_to_unsubscribed\":{\"description\":\"Whether to send this message to unsubscribed customers.\",\"type\":\"boolean\"},\"sender_identity_id\":{\"description\":\"The ID of the WhatsApp Business phone number to send from. This corresponds to\\na phone number registered in your WhatsApp Business Account and synced via\\n`GET /v1/environments/{environment_id}/whatsapp/sync`.\\n\",\"type\":\"integer\"},\"sending_state\":{\"description\":\"Determines the sending behavior for the action. `automatic` sends the action automatically when triggered; `draft` queues drafts when the action is triggered; or `off` to disable the action.\",\"enum\":[\"automatic\",\"draft\",\"off\"],\"type\":\"string\"},\"tracked\":{\"default\":false,\"description\":\"Whether links in template parameters should be tracked.\",\"type\":\"boolean\"},\"type\":{\"description\":\"For WhatsApp messages sent from Customer.io using your Facebook Business Account (not Twilio), the `type` is always `whatsapp`.\",\"enum\":[\"whatsapp\"],\"readOnly\":true,\"type\":\"string\"},\"updated\":{\"description\":\"The date time when the referenced ID was last updated.\",\"example\":1552341937,\"format\":\"unix timestamp\",\"readOnly\":true,\"type\":\"integer\"}},\"title\":\"WhatsApp\"},{\"properties\":{\"body\":{\"description\":\"The body of the action. You cannot modify the body if you created it with our drag-and-drop editor.\",\"type\":\"string\"},\"broadcast_id\":{\"description\":\"The identifier for a broadcast.\",\"example\":2,\"type\":\"integer\"},\"created\":{\"description\":\"The date time when the referenced ID was created.\",\"example\":1552341937,\"format\":\"unix timestamp\",\"readOnly\":true,\"type\":\"integer\"},\"deduplicate_id\":{\"description\":\"An identifier in the format `id:timestamp` where the id is for the object you're working with (Automations, Deliveries, Exports, Identities, One-time sends, Segments, and Templates), and the timestamp is the last time the object was updated.\",\"example\":\"15:1492548073\",\"readOnly\":true,\"type\":\"string\"},\"headers\":{\"description\":\"A JSON string containing header objects with `name` and `value`. Names and values must be strings, with no non-ASCII characters or spaces. You can't overwrite reserved headers.\",\"example\":\"[{\\\"name\\\":\\\"X-Mailgun-Tag\\\",\\\"value\\\":\\\"my-cool-tag\\\"},{\\\"name\\\":\\\"X-Custom-Header\\\",\\\"value\\\":\\\"custom-value\\\"}]\",\"format\":\"json\",\"type\":\"string\"},\"id\":{\"description\":\"The identifier for an action.\",\"example\":96,\"readOnly\":true,\"type\":\"integer\"},\"layout\":{\"description\":\"The layout used for the action, if it exists.\",\"readOnly\":true,\"type\":\"string\"},\"method\":{\"description\":\"The HTTP method for your webhook.\",\"enum\":[\"get\",\"post\",\"put\",\"delete\",\"patch\"],\"example\":\"post\",\"type\":\"string\"},\"name\":{\"description\":\"The name of the action, if it exists.\",\"example\":\"Opening Message\",\"readOnly\":true,\"type\":\"string\"},\"sending_state\":{\"description\":\"Determines the sending behavior for the action. `automatic` sends the action automatically when triggered; `draft` queues drafts when the action is triggered; or `off` to disable the action.\",\"enum\":[\"automatic\",\"draft\",\"off\"],\"type\":\"string\"},\"type\":{\"description\":\"The type of action.\",\"enum\":[\"webhook\"],\"readOnly\":true,\"type\":\"string\"},\"updated\":{\"description\":\"The date time when the referenced ID was last updated.\",\"example\":1552341937,\"format\":\"unix timestamp\",\"readOnly\":true,\"type\":\"integer\"},\"url\":{\"description\":\"The URL to send a webhook to, applies to `webhook` type actions.\",\"example\":\"https://my.example.com/webhook\",\"type\":\"string\"}},\"title\":\"Webhook\"}]}}}},\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"action\":{\"oneOf\":[{\"properties\":{\"bcc\":{\"description\":\"The blind-copy address(es) for this action.\",\"readOnly\":true,\"type\":\"string\"},\"body\":{\"description\":\"The body of the action. You cannot modify the body if you created it with our drag-and-drop editor.\",\"type\":\"string\"},\"body_amp\":{\"description\":\"AMP-enabled content for your email. If a recipient's email client doesn't support AMP, they receive your `body` content instead. Make sure you're [set up to send AMP](/journeys/channels/email/layouts/amp-for-email/) first.\",\"type\":\"string\"},\"broadcast_id\":{\"description\":\"The identifier for a broadcast.\",\"example\":2,\"type\":\"integer\"},\"cc\":{\"description\":\"The carbon-copy address(es) for this action.\",\"readOnly\":true,\"type\":\"string\"},\"created\":{\"description\":\"The date time when the referenced ID was created.\",\"example\":1552341937,\"format\":\"unix timestamp\",\"readOnly\":true,\"type\":\"integer\"},\"deduplicate_id\":{\"description\":\"An identifier in the format `id:timestamp` where the id is for the object you're working with (Automations, Deliveries, Exports, Identities, One-time sends, Segments, and Templates), and the timestamp is the last time the object was updated.\",\"example\":\"15:1492548073\",\"readOnly\":true,\"type\":\"string\"},\"fake_bcc\":{\"description\":\"If true, rather than sending true copies to BCC addresses, Customer.io sends a copy of the message with the subject line containing the recipient address(es).\\n\",\"readOnly\":true,\"type\":\"boolean\"},\"from\":{\"description\":\"The address that the message is from, relevant if the action `type` is `email`.\",\"example\":\"sentFrom@example.com\",\"readOnly\":true,\"type\":\"string\"},\"from_id\":{\"description\":\"The identifier of the `from` address, commonly known as the \\\"sender\\\". Use [List sender identities](/integrations/api/app/tag/sender-identities/listSenders/) to find valid IDs.\",\"example\":1,\"type\":\"integer\"},\"headers\":{\"description\":\"A JSON string containing header objects with `name` and `value`. Names and values must be strings, with no non-ASCII characters or spaces. You can't overwrite reserved headers.\",\"example\":\"[{\\\"name\\\":\\\"X-Mailgun-Tag\\\",\\\"value\\\":\\\"my-cool-tag\\\"},{\\\"name\\\":\\\"X-Custom-Header\\\",\\\"value\\\":\\\"custom-value\\\"}]\",\"format\":\"json\",\"type\":\"string\"},\"id\":{\"description\":\"The identifier for an action.\",\"example\":96,\"readOnly\":true,\"type\":\"integer\"},\"language\":{\"description\":\"The language variant for your message. If you don't use our [localization feature](/journeys/channels/localization/getting-started), or this is the default message, this value is an empty string.\",\"example\":\"fr\",\"readOnly\":true,\"type\":\"string\"},\"layout\":{\"description\":\"The layout used for the action, if it exists.\",\"readOnly\":true,\"type\":\"string\"},\"name\":{\"description\":\"The name of the action, if it exists.\",\"example\":\"Opening Message\",\"readOnly\":true,\"type\":\"string\"},\"preheader_text\":{\"description\":\"[Also known as \\\"preview text\\\"](/journeys/channels/email/headers/custom-preheader-text/), this is the small block of text shown in an email inbox next to or underneath the subject line.\\n\",\"type\":\"string\"},\"preprocessor\":{\"description\":\"If CSS pre-processing is enabled, this key is populated with `premailer`. Note, Juice replaced Premailer as the pre-processor, but you will only see `premailer` as the value.\",\"enum\":[\"premailer\"],\"readOnly\":true,\"type\":\"string\"},\"recipient\":{\"description\":\"The recipient address for an action.\",\"example\":\"{{customer.email}}\",\"type\":\"string\"},\"reply_to\":{\"description\":\"The address that receives replies for the message, if applicable.\",\"example\":\"replyto@example.com\",\"readOnly\":true,\"type\":\"string\"},\"reply_to_id\":{\"description\":\"The identifier for the `reply_to` address, if applicable. Use [List sender identities](/integrations/api/app/tag/sender-identities/listSenders/) to find valid IDs.\",\"example\":38,\"type\":[\"integer\",\"null\"]},\"sending_state\":{\"description\":\"Determines the sending behavior for the action. `automatic` sends the action automatically when triggered; `draft` queues drafts when the action is triggered; or `off` to disable the action.\",\"enum\":[\"automatic\",\"draft\",\"off\"],\"type\":\"string\"},\"subject\":{\"description\":\"The subject line for an `email` action.\",\"example\":\"Did you get that thing I sent you?\",\"type\":\"string\"},\"type\":{\"description\":\"The type of action.\",\"enum\":[\"email\",\"in_app\",\"push\",\"twilio\",\"slack\",\"whatsapp\"],\"readOnly\":true,\"type\":\"string\"},\"updated\":{\"description\":\"The date time when the referenced ID was last updated.\",\"example\":1552341937,\"format\":\"unix timestamp\",\"readOnly\":true,\"type\":\"integer\"}},\"title\":\"Email / message\"},{\"properties\":{\"body\":{\"description\":\"The body of your SMS.\",\"type\":\"string\"},\"broadcast_id\":{\"description\":\"The identifier for a broadcast.\",\"example\":2,\"type\":\"integer\"},\"created\":{\"description\":\"The date time when the referenced ID was created.\",\"example\":1552341937,\"format\":\"unix timestamp\",\"readOnly\":true,\"type\":\"integer\"},\"deduplicate_id\":{\"description\":\"An identifier in the format `id:timestamp` where the id is for the object you're working with (Automations, Deliveries, Exports, Identities, One-time sends, Segments, and Templates), and the timestamp is the last time the object was updated.\",\"example\":\"15:1492548073\",\"readOnly\":true,\"type\":\"string\"},\"id\":{\"description\":\"The identifier for an action.\",\"example\":96,\"readOnly\":true,\"type\":\"integer\"},\"image_url\":{\"description\":\"The URL of the image in your SMS (MMS) message.\",\"type\":\"string\"},\"language\":{\"description\":\"The language variant for your message. If you don't use our [localization feature](/journeys/channels/localization/getting-started), or this is the default message, this value is an empty string.\",\"example\":\"fr\",\"readOnly\":true,\"type\":\"string\"},\"layout\":{\"description\":\"The layout used for the action, if it exists.\",\"readOnly\":true,\"type\":\"string\"},\"name\":{\"description\":\"The name of the action.\",\"example\":\"Opening Message\",\"readOnly\":true,\"type\":\"string\"},\"recipient\":{\"description\":\"The recipient, usually an attribute you reference with Liquid like `{{customer.phone}}`. If you use Liquid, this field is blank in `GET` responses because we resolve the recipient at send time.\",\"example\":\"\",\"type\":\"string\"},\"sending_state\":{\"description\":\"Determines the sending behavior for the action. `automatic` sends the action automatically when triggered; `draft` queues drafts when the action is triggered; or `off` to disable the action.\",\"enum\":[\"automatic\",\"draft\",\"off\"],\"type\":\"string\"},\"type\":{\"description\":\"For SMS/MMS messages, the `type` is always `twilio`.\",\"enum\":[\"twilio\"],\"readOnly\":true,\"type\":\"string\"},\"updated\":{\"description\":\"The date time when the referenced ID was last updated.\",\"example\":1552341937,\"format\":\"unix timestamp\",\"readOnly\":true,\"type\":\"integer\"}},\"title\":\"SMS / MMS\"},{\"description\":\"The action object for WhatsApp messages sent from Customer.io using your Facebook Business Account (not Twilio). Messages sent through Twilio still use the `twilio` type and are treated similarly to SMS messages.\",\"properties\":{\"body\":{\"description\":\"A JSON string containing WhatsApp template metadata from Meta and template parameters with Liquid variables. Use `GET /v1/environments/{environment_id}/whatsapp/templates` to list templates.\",\"example\":\"{\\\"body\\\":\\\"\\\",\\\"image_url\\\":\\\"\\\",\\\"whatsapp_message_template\\\":{\\\"id\\\":\\\"12345\\\",\\\"name\\\":\\\"welcome\\\",\\\"language\\\":\\\"en_US\\\",\\\"status\\\":\\\"APPROVED\\\",\\\"components\\\":[...]},\\\"template_parameters\\\":{\\\"name\\\":\\\"welcome\\\",\\\"components\\\":[{\\\"type\\\":\\\"BODY\\\",\\\"parameters\\\":[{\\\"type\\\":\\\"text\\\",\\\"text\\\":\\\"{{customer.name}}\\\",\\\"parameter_name\\\":\\\"name\\\"}]}]}}\",\"type\":\"string\"},\"body_json\":{\"description\":\"For visual editor content (if applicable).\",\"type\":\"string\"},\"broadcast_id\":{\"description\":\"The identifier for a broadcast.\",\"example\":2,\"type\":\"integer\"},\"created\":{\"description\":\"The date time when the referenced ID was created.\",\"example\":1552341937,\"format\":\"unix timestamp\",\"readOnly\":true,\"type\":\"integer\"},\"deduplicate_id\":{\"description\":\"An identifier in the format `id:timestamp` where the id is for the object you're working with (Automations, Deliveries, Exports, Identities, One-time sends, Segments, and Templates), and the timestamp is the last time the object was updated.\",\"example\":\"15:1492548073\",\"readOnly\":true,\"type\":\"string\"},\"id\":{\"description\":\"The identifier for an action.\",\"example\":96,\"readOnly\":true,\"type\":\"integer\"},\"language\":{\"description\":\"The language variant for your message. If you don't use our [localization feature](/journeys/channels/localization/getting-started), or this is the default message, this value is an empty string.\",\"example\":\"fr\",\"readOnly\":true,\"type\":\"string\"},\"name\":{\"description\":\"The name of the action.\",\"example\":\"Welcome Message\",\"readOnly\":true,\"type\":\"string\"},\"recipient\":{\"description\":\"The recipient's phone number in E.164 format, usually referenced with Liquid like `{{customer.phone}}`. If you use Liquid, this field is blank in `GET` responses because we resolve the recipient at send time.\",\"example\":\"\",\"type\":\"string\"},\"send_to_unsubscribed\":{\"description\":\"Whether to send this message to unsubscribed customers.\",\"type\":\"boolean\"},\"sender_identity_id\":{\"description\":\"The ID of the WhatsApp Business phone number to send from. This corresponds to\\na phone number registered in your WhatsApp Business Account and synced via\\n`GET /v1/environments/{environment_id}/whatsapp/sync`.\\n\",\"type\":\"integer\"},\"sending_state\":{\"description\":\"Determines the sending behavior for the action. `automatic` sends the action automatically when triggered; `draft` queues drafts when the action is triggered; or `off` to disable the action.\",\"enum\":[\"automatic\",\"draft\",\"off\"],\"type\":\"string\"},\"tracked\":{\"default\":false,\"description\":\"Whether links in template parameters should be tracked.\",\"type\":\"boolean\"},\"type\":{\"description\":\"For WhatsApp messages sent from Customer.io using your Facebook Business Account (not Twilio), the `type` is always `whatsapp`.\",\"enum\":[\"whatsapp\"],\"readOnly\":true,\"type\":\"string\"},\"updated\":{\"description\":\"The date time when the referenced ID was last updated.\",\"example\":1552341937,\"format\":\"unix timestamp\",\"readOnly\":true,\"type\":\"integer\"}},\"title\":\"WhatsApp\"},{\"properties\":{\"body\":{\"description\":\"The body of the action. You cannot modify the body if you created it with our drag-and-drop editor.\",\"type\":\"string\"},\"broadcast_id\":{\"description\":\"The identifier for a broadcast.\",\"example\":2,\"type\":\"integer\"},\"created\":{\"description\":\"The date time when the referenced ID was created.\",\"example\":1552341937,\"format\":\"unix timestamp\",\"readOnly\":true,\"type\":\"integer\"},\"deduplicate_id\":{\"description\":\"An identifier in the format `id:timestamp` where the id is for the object you're working with (Automations, Deliveries, Exports, Identities, One-time sends, Segments, and Templates), and the timestamp is the last time the object was updated.\",\"example\":\"15:1492548073\",\"readOnly\":true,\"type\":\"string\"},\"headers\":{\"description\":\"A JSON string containing header objects with `name` and `value`. Names and values must be strings, with no non-ASCII characters or spaces. You can't overwrite reserved headers.\",\"example\":\"[{\\\"name\\\":\\\"X-Mailgun-Tag\\\",\\\"value\\\":\\\"my-cool-tag\\\"},{\\\"name\\\":\\\"X-Custom-Header\\\",\\\"value\\\":\\\"custom-value\\\"}]\",\"format\":\"json\",\"type\":\"string\"},\"id\":{\"description\":\"The identifier for an action.\",\"example\":96,\"readOnly\":true,\"type\":\"integer\"},\"layout\":{\"description\":\"The layout used for the action, if it exists.\",\"readOnly\":true,\"type\":\"string\"},\"method\":{\"description\":\"The HTTP method for your webhook.\",\"enum\":[\"get\",\"post\",\"put\",\"delete\",\"patch\"],\"example\":\"post\",\"type\":\"string\"},\"name\":{\"description\":\"The name of the action, if it exists.\",\"example\":\"Opening Message\",\"readOnly\":true,\"type\":\"string\"},\"sending_state\":{\"description\":\"Determines the sending behavior for the action. `automatic` sends the action automatically when triggered; `draft` queues drafts when the action is triggered; or `off` to disable the action.\",\"enum\":[\"automatic\",\"draft\",\"off\"],\"type\":\"string\"},\"type\":{\"description\":\"The type of action.\",\"enum\":[\"webhook\"],\"readOnly\":true,\"type\":\"string\"},\"updated\":{\"description\":\"The date time when the referenced ID was last updated.\",\"example\":1552341937,\"format\":\"unix timestamp\",\"readOnly\":true,\"type\":\"integer\"},\"url\":{\"description\":\"The URL to send a webhook to, applies to `webhook` type actions.\",\"example\":\"https://my.example.com/webhook\",\"type\":\"string\"}},\"title\":\"Webhook\"}]}},\"type\":\"object\"}}},\"description\":\"Returns the updated broadcast action.\"},\"400\":{\"description\":\"The `broadcastID`, `actionID` or `triggerID` is invalid. Or the `language` does not exist for this action.\"},\"404\":{\"description\":\"The broadcast, action, and/or trigger do not exist.\"},\"429\":{\"content\":{\"application/json\":{\"example\":{\"errors\":[{\"detail\":\"rate limited to 10 requests per 1s (reference a1b2c3)\",\"status\":\"429\"}]},\"schema\":{\"description\":\"An array/list of failures where each entry is a separate failure reason.\",\"properties\":{\"errors\":{\"description\":\"One entry for each reason the request failed.\",\"items\":{\"properties\":{\"code\":{\"description\":\"A stable identifier for the failure, on the errors that carry one. Use this rather than the text in `detail` if you need to identify the error programmatically.\",\"example\":\"invalid_credentials\",\"type\":\"string\"},\"detail\":{\"description\":\"What went wrong, in plain text. Most messages end with a support reference you can use if you need to contact support.\",\"example\":\"bad request (reference a1b2c3)\",\"type\":\"string\"},\"meta\":{\"additionalProperties\":true,\"description\":\"Extra context (if available).\",\"type\":\"object\"},\"source\":{\"description\":\"The part of the request that the error refers to.\",\"properties\":{\"pointer\":{\"description\":\"A JSON pointer to the part of the request body that the error refers to.\",\"example\":\"/data/attributes/email\",\"type\":\"string\"}},\"type\":\"object\"},\"status\":{\"description\":\"The HTTP status code as a string.\",\"example\":\"400\",\"type\":\"string\"}},\"required\":[\"detail\",\"status\"],\"type\":\"object\"},\"type\":\"array\"}},\"required\":[\"errors\"],\"type\":\"object\"}}},\"description\":\"Your request is over the 10-per-second limit. `Retry-After` tells you how many seconds you must wait before you send the next request.\",\"headers\":{\"Retry-After\":{\"description\":\"How many seconds you must wait before you send another request. This header is present when you are rate limited by a per-second limit. If you hit a daily quota, this header is not set.\",\"schema\":{\"example\":1,\"minimum\":1,\"type\":\"integer\"}}}}},\"security\":[{\"Bearer-Auth\":[]}],\"securitySchemes\":{\"Bearer-Auth\":{\"description\":\"The App API uses a bearer authentication scheme.\\n\\nYou can generate a bearer token, known as an **App API Key**, with a defined scope in [your account settings](https://fly.customer.io/settings/api_credentials?keyType=app). [Learn more about bearer authorization in Customer.io](/accounts/settings/managing-credentials).\\n\",\"scheme\":\"bearer\",\"type\":\"http\"},\"ServiceAccount-Auth\":{\"bearerFormat\":\"sa_live_\",\"description\":\"Transactional send endpoints (`/v1/send/email`, `/v1/send/push`, `/v1/send/sms`, `/v1/send/whatsapp`, `/v1/send/in_app`, `/v1/send/inbox_message`) also accept a service-account bearer token, prefixed with `sa_live_`. Service-account tokens work across workspaces, so you must pass the target workspace as the `X-Workspace-Id` header on each request.\\n\\nService-account tokens are intended for testing and one-off sends—for example, using the Customer.io CLI with an AI agent like Claude to verify that a transactional message renders correctly before wiring it into your production backend. **For the production integration that triggers the message from your application, use an App API Key instead**: it's workspace-scoped, easier to rotate, and has a smaller blast radius.\\n\\nService-account tokens are server-side credentials. Treat them like any API key—keep them in environment variables or a secret manager, and never embed them in client-side code, mobile apps, or other untrusted contexts.\\n\",\"scheme\":\"bearer\",\"type\":\"http\"},\"bearerAuth\":{\"description\":\"API key passed as a Bearer token\",\"scheme\":\"bearer\",\"type\":\"http\"}},\"securitySource\":\"operation\"}"
            source: "openapi3"
