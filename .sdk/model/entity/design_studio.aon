            id: "GET /v1/design_studio/components"
            json: "{\"operationId\":\"listComponents\",\"parameters\":[{\"description\":\"Filter by component tag name. This is the name of the tag inserted into your emails.\",\"in\":\"query\",\"name\":\"tag\",\"schema\":{\"type\":\"string\"}},{\"description\":\"The page number of results you want to display. Use with `limit`.\",\"in\":\"query\",\"name\":\"page\",\"schema\":{\"default\":1,\"minimum\":1,\"type\":\"integer\"}},{\"description\":\"Limit the number of results per page.\",\"in\":\"query\",\"name\":\"limit\",\"schema\":{\"default\":1000,\"maximum\":10000,\"minimum\":1,\"type\":\"integer\"}},{\"description\":\"Filter by parent folder. Must reference an existing folder. If not set, the response filters by the root level directory.\\n\\nTo list only items in the root folder, leave `parent_folder_id` unset and only set `direct_descendants_only` to `true`.\\n\",\"in\":\"query\",\"name\":\"parent_folder_id\",\"schema\":{\"format\":\"uuid\",\"type\":\"string\"}},{\"description\":\"If true, this returns only children of the parent folder.\",\"in\":\"query\",\"name\":\"direct_descendants_only\",\"schema\":{\"default\":false,\"type\":\"boolean\"}},{\"in\":\"query\",\"name\":\"sort_by\",\"schema\":{\"default\":\"created\",\"enum\":[\"created\",\"updated\",\"name\"],\"type\":\"string\"}},{\"in\":\"query\",\"name\":\"sort_order\",\"schema\":{\"default\":\"asc\",\"enum\":[\"asc\",\"desc\"],\"type\":\"string\"}},{\"description\":\"Return records created before this time. Must be a unix timestamp.\",\"example\":1773856017,\"in\":\"query\",\"name\":\"created_before\",\"schema\":{\"format\":\"Unix timestamp\",\"type\":\"integer\"}},{\"description\":\"Return records created after this time. Must be a unix timestamp.\",\"example\":1773856017,\"in\":\"query\",\"name\":\"created_after\",\"schema\":{\"format\":\"Unix timestamp\",\"type\":\"integer\"}},{\"description\":\"Return records updated before this time. Must be a unix timestamp.\",\"example\":1773856017,\"in\":\"query\",