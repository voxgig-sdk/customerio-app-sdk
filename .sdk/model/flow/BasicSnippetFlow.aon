# BasicSnippetFlow

main: kit: flow: BasicSnippetFlow:
{
  entity: "snippet",
  kind: "basic",
  name: "BasicSnippetFlow",
  step: [
    {
      input: {
        ref: "snippet_ref01"
      }

      op: "create"
    }

    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "snippet_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "snippet_ref01",
        srcdatavar: "snippet_ref01_data",
        suffix: "_up0",
        textfield: "name"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-snippet_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "snippet_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "snippet01"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "snippet_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicSnippetFlow"
}