# BasicAssetFlow

main: kit: flow: BasicAssetFlow:
{
  entity: "asset",
  kind: "basic",
  name: "BasicAssetFlow",
  step: [
    {
      input: {
        ref: "asset_ref01"
      }

      op: "create"
    }

    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "asset_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "asset_ref01",
        srcdatavar: "asset_ref01_data",
        suffix: "_up0",
        textfield: "name"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-asset_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "asset_ref01",
        srcdatavar: "asset_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "asset01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-asset_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "asset_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "asset01"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "asset_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAssetFlow"
}