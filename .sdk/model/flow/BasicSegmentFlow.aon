# BasicSegmentFlow

main: kit: flow: BasicSegmentFlow:
{
  entity: "segment",
  kind: "basic",
  name: "BasicSegmentFlow",
  step: [
    {
      input: {
        ref: "segment_ref01"
      }

      op: "create"
    }

    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "segment_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "segment_ref01",
        srcdatavar: "segment_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "segment01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-segment_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "segment_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "segment01"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "segment_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicSegmentFlow"
}