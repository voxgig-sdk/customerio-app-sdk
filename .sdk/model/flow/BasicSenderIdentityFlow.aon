# BasicSenderIdentityFlow

main: kit: flow: BasicSenderIdentityFlow:
{
  entity: "sender_identity",
  kind: "basic",
  name: "BasicSenderIdentityFlow",
  step: [
    {
      match: {
        sender_id: "sender01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "sender_identity_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "sender_identity_ref01",
        srcdatavar: "sender_identity_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "sender_identity01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-sender_identity_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicSenderIdentityFlow"
}